# The shared project job (design §4.1): the profile's image, cpu, memory,
# timeout and secret mounts, on the base image clone workflows run.
#
# It carries nothing per-repository. The repository, the ref and the task
# arrive at launch (task.json, phase 1) and FUGARO_RUN is an override the
# launcher writes; the provider is in the job's own name, which Cloud Run
# sets and no launcher writes (a launcher may override any variable through
# run.jobs.runWithOverrides). Deletion protection is what the history job
# and every workflow job have.
resource "google_cloud_run_v2_job" "this" {
  project             = var.project
  location            = var.region
  name                = var.job.job
  deletion_protection = true
  labels = {
    fugaro          = "managed"
    fugaro_profile  = var.job.profile
    fugaro_provider = var.job.provider
    fugaro_account  = local.account_label
  }

  template {
    # Only the template's labels reach the job's log entries, which the log
    # sink and exclusion select on; they are the same marks.
    labels = {
      fugaro          = "managed"
      fugaro_profile  = var.job.profile
      fugaro_provider = var.job.provider
      fugaro_account  = local.account_label
    }
    task_count = 1

    template {
      # The provider's default is 3; a run is never retried behind the
      # launcher's back.
      max_retries           = 0
      timeout               = "${var.job.task_timeout_s}s"
      service_account       = google_service_account.job.email
      execution_environment = "EXECUTION_ENVIRONMENT_GEN2"

      containers {
        image = var.job.image

        resources {
          limits = {
            cpu    = var.job.cpu
            memory = var.job.memory
          }
        }

        # The plain variables, then the secrets. env is a set, which the
        # provider keeps sorted by name, so the order here plans no diff.
        dynamic "env" {
          for_each = var.job.env
          content {
            name  = env.key
            value = env.value
          }
        }

        # The secret's ID, the same-project short form the live jobs hold,
        # never its projects/… path, which would plan an update.
        dynamic "env" {
          for_each = var.job.secret_env
          content {
            name = env.key
            value_source {
              secret_key_ref {
                secret  = var.secrets[env.value]
                version = "latest"
              }
            }
          }
        }
      }
    }
  }

  lifecycle {
    ignore_changes = [client, client_version]

    # Both sides are generated by the same Go code, so this checks for
    # drift (a hand-edited tfvars), not for an attacker. A precondition
    # fails the plan; a check block would only warn. Task 3.3's whole
    # identity rests on these two: backend.ExecutionFromEnv reads
    # FUGARO_GCP_PROJECT and FUGARO_REGION and errors when they are unset.
    precondition {
      condition     = lookup(var.job.env, "FUGARO_PROJECT", "") == var.fugaro_project
      error_message = "the job's FUGARO_PROJECT must be the Fugaro project ${var.fugaro_project}; run fugaro init"
    }
    precondition {
      condition     = lookup(var.job.env, "FUGARO_GCP_PROJECT", "") == var.project
      error_message = "the job's FUGARO_GCP_PROJECT must be the GCP project ${var.project}; run fugaro init"
    }
    precondition {
      condition     = lookup(var.job.env, "FUGARO_REGION", "") == var.region
      error_message = "the job's FUGARO_REGION must be ${var.region}; run fugaro init"
    }
    precondition {
      condition     = lookup(var.job.env, "FUGARO_RUN", "") == ""
      error_message = "the job must not set FUGARO_RUN: it is the launch override that says which run an execution is, so a job that carried one would run every execution as that run"
    }
  }

  # The job runs as its account and reads its secrets from the start.
  depends_on = [google_secret_manager_secret_iam_member.job]
}

locals {
  # fugaro_account is a label, so it cannot be empty: an api-key or Vertex
  # profile runs as no Claude account, and its job says so.
  account_label = var.job.account != "" ? var.job.account : "none"
}
