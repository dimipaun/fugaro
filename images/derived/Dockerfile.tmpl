# syntax=docker/dockerfile:1.10@sha256:865e5dd094beca432e8c0a1d5e1c465db5f998dca4e439981029b3b81fb39ed5
# Derived image for workflow {{.Workflow}}, generated by fugaro {{.Version}}
# from images/derived/Dockerfile.tmpl (design §7.2). Do not edit it: change
# the workflow's image: settings instead, or save this output as
# .fugaro/{{.Workflow}}.Dockerfile, point dockerfile: at it and edit that.
#
# Build arguments:
#   FUGARO_BASE  the Fugaro base image; Cloud Build pins it by digest
#   REPO_URL     what to clone: a git URL, or /src/repo.bundle from the build context
#   REPO_ORIGIN  the https origin URL the checkout keeps; defaults to REPO_URL
#   BASE_BRANCH  the branch to bake in
# Build secrets, all optional: git-credentials (a git credential-store file
# for REPO_URL) and one per workflow secret, exposed as that variable.
ARG FUGARO_BASE
FROM ${FUGARO_BASE}
ARG REPO_URL
ARG REPO_ORIGIN=${REPO_URL}
ARG BASE_BRANCH
{{- if or .Image.Apt .Image.Node .Image.JDK}}

USER root
{{- if .Image.Apt}}
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends {{join .Image.Apt " "}} \
 && rm -rf /var/lib/apt/lists/*
{{- end}}
{{- if .Image.Node}}
RUN /usr/local/lib/fugaro/install-node {{.Image.Node}}
{{- end}}
{{- if .Image.JDK}}
RUN /usr/local/lib/fugaro/install-jdk {{.Image.JDK}}
{{- end}}
USER fugaro
{{- end}}

WORKDIR /work/repo
RUN --mount=type=bind,target=/src \
    --mount=type=secret,id=git-credentials,uid=1000,required=false \
    GIT_TERMINAL_PROMPT=0 git -c credential.helper= \
      -c credential.helper='store --file=/run/secrets/git-credentials' \
      clone --quiet --branch "$BASE_BRANCH" --single-branch -- "$REPO_URL" /work/repo \
 && git remote set-url origin -- "$REPO_ORIGIN"
{{- if .WarmUp}}

# Dependency warm-up for {{.WarmUpFor}}.
RUN{{.SecretMounts}} {{.WarmUp}}
{{- end}}
{{- if .Image.Setup}}

# Setup steps run as fugaro but may use sudo, for example for
# playwright install --with-deps. The rule is removed below.
USER root
RUN echo 'fugaro ALL=(root) NOPASSWD: ALL' > /etc/sudoers.d/fugaro-build \
 && chmod 0440 /etc/sudoers.d/fugaro-build
USER fugaro

# image.setup steps.
{{- range .Image.Setup}}
RUN{{$.SecretMounts}} {{.}}
{{- end}}
{{- end}}

USER root
RUN rm -f /etc/sudoers.d/fugaro-build \
 && { [ ! -e /usr/bin/sudo ] || chmod u-s /usr/bin/sudo; } \
 && { [ ! -e /usr/bin/su ] || chmod u-s /usr/bin/su; }
USER fugaro

RUN /usr/local/lib/fugaro/finalize-checkout /work/repo
