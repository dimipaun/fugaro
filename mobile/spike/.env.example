# Every variable the spike's app.config.js reads, and no value (task M0; Check 733).
#
# Copy this file to `.env` for a local `expo start`, or set each one in the EAS
# project (`eas env:set`, README.md has the exact commands) for a cloud build.
# `.env` is gitignored and must stay that way: these are the owner's identifiers
# and client ids, and a committed value is a published one.
#
# The four identity variables are required in a build and optional for
# `expo start` and `npm test`. The four client ids are public by design -- a
# native app's OAuth client id is not a secret -- and are still not committed
# here, because a spike does not need to publish even a public value.

# The iOS bundle identifier of this build (a reverse-DNS name).
SPIKE_IOS_BUNDLE_ID=

# The Android package name of this build (a reverse-DNS name; Play allows no hyphen).
SPIKE_ANDROID_PACKAGE=

# The App Group the app and the iOS share extension both hold. The share
# extension reads the shared text through it, so the two targets must name the
# same group. README.md, "The iOS share extension".
SPIKE_IOS_APP_GROUP=

# The share extension's own bundle identifier, covered by the same provisioning
# profile as the app.
SPIKE_IOS_SHARE_EXTENSION_BUNDLE_ID=

# Google: the OAuth client ids from the Google Cloud console, one per platform.
# The web client is what the Firebase project answers the sign-in for.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Microsoft: the application (client) id from the Microsoft Entra app
# registration, as the `common` tenant's public client.
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
