{
  "model": "google/gemini-3-flash",
  "max_tokens": 4096,
  "system": [{"type": "text", "text": "You are a careful engineer.", "cache_control": {"type": "ephemeral"}}],
  "tools": [
    {
      "name": "Bash",
      "type": "custom",
      "description": "Run a shell command",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "command": {"type": "string", "description": "the command to run"},
          "timeout": {"type": "number", "minimum": 0, "maximum": 600000, "description": "milliseconds"}
        },
        "required": ["command"],
        "additionalProperties": false
      }
    },
    {
      "name": "Read",
      "type": "custom",
      "description": "Read a file from the filesystem",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "file_path": {"type": "string", "description": "the path to read"},
          "offset": {"type": "integer", "minimum": 0},
          "limit": {"type": "integer", "minimum": 1, "maximum": 2000},
          "mode": {"type": "string", "enum": ["text", "bytes"]},
          "ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {"start": {"type": "integer"}, "end": {"type": "integer"}},
              "required": ["start", "end"],
              "additionalProperties": false
            }
          }
        },
        "required": ["file_path"],
        "additionalProperties": false
      },
      "cache_control": {"type": "ephemeral"}
    }
  ],
  "tool_choice": {"type": "auto"},
  "messages": [{"role": "user", "content": "what is in config.yaml?"}]
}
