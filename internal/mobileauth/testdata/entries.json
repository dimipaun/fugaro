      "address": "dimi@example.com",
      "want_error": "not_allowed"
    },
    {
      "name": "an absent role admits nobody",
      "exact": [{"address": "dimi@example.com", "role": "", "at": "2026-10-22T09:00:00Z", "by": "dimi"}],
      "address": "dimi@example.com",
      "want_error": "not_allowed"
    },
    {
      "name": "two exact entries that disagree are ambiguous",
      "exact": [
        {"address": "dimi@example.com", "role": "viewer", "at": "2026-10-22T09:00:00Z", "by": "dimi"},
        {"address": "dimi@example.com", "role": "admin", "at": "2026-10-22T10:00:00Z", "by": "dimi"}
      ],
      "address": "dimi@example.com",
      "want_error": "ambiguous"
    },
    {
      "name": "two exact entries that agree are one role",
      "exact": [
        {"address": "dimi@example.com", "role": "admin", "at": "2026-10-22T09:00:00Z", "by": "dimi"},
        {"address": "dimi@example.com", "role": "admin", "at": "2026-10-22T10:00:00Z", "by": "dimi"}
      ],
      "address": "dimi@example.com",
      "want": "admin"
    },
    {
      "name": "two domain entries that disagree are ambiguous",
      "domains": [
        {"address": "example.com", "role": "viewer", "at": "2026-10-22T09:00:00Z", "by": "dimi"},
        {"address": "example.com", "role": "admin", "at": "2026-10-22T10:00:00Z", "by": "dimi"}
      ],
      "address": "dimi@example.com",
      "want_error": "ambiguous"
    },
