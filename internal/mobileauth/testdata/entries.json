      "address": "dimi@example.com",
      "want_error": "not_allowed"
    },
    {
      "name": "an empty allowlist admits nobody",
      "address": "dimi@example.com",
      "want_error": "not_allowed"
    },
    {
      "name": "an address that cannot be canonicalised admits nobody",
      "domains": [{"address": "example.com", "role": "admin", "at": "2026-10-22T09:00:00Z", "by": "dimi"}],
      "address": "Dimi Paun <dimi@example.com>",
