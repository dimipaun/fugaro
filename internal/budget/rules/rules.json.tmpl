{
  "rules": {
    ".read": false,
    ".write": false,
    "fugaro": {
      "project": { ".read": false, ".write": false },
      "mark": { ".read": false, ".write": false }
    },
    "creds": { ".read": false, ".write": false },
    "config": {
      "caps": {
        "global": { ".read": "TOKEN || USER" },
        "defaults": { ".read": "TOKEN || USER" },
        "repos": { "$slug": { ".read": "(TOKEN && auth.token.fs == $slug) || USER" } }
      },
      "policy": {
        "shared": { ".read": "TOKEN", ".write": false },
        "repos": { "$slug": { ".read": "TOKEN && auth.token.fs == $slug", ".write": false } }
      },
      "limits": { ".read": "TOKEN" },
      "mode": { ".read": "TOKEN" },
      "kill": {
        "global": { ".read": "TOKEN || USER" },
        "repos": { "$slug": { ".read": "(TOKEN && auth.token.fs == $slug) || USER" } }
      },
      "admin": {
        ".read": false,
        ".write": false,
        "devices": {
          "$uid": { ".read": false, ".write": false }
        }
      }
    },
    "pairing": {
      "$uid": {
        "request": {
          ".read": false,
          ".write": "PAIRING && newData.exists() && !data.exists()",
          ".validate": "newData.hasChildren(['key', 'at'])",
          "key": { ".validate": "PUBKEY" },
          "at": { ".validate": "TIMESTAMP" },
          "$other": { ".validate": false }
        },
        "delivery": {
          ".read": "PAIRING",
          ".write": false
        }
      }
    },
    "runs": {
      "$slug": {
        "$run": {
          ".read": "RUN",
          "reserved": {
            ".write": "RUN && newData.exists()",
            ".validate": "AMOUNT && NEW >= OLD && (NEW == OLD || (NEW - OLD <= MAXRES && KILLS_OFF && NEW - OLD == D(spend/TODAY/runs/$slug/$run/reserved) && (!ENFORCE || PERRUNOK)))"
          },
          "released": {
            ".write": "RUN && newData.exists()",
            ".validate": "AMOUNT && NEW >= OLD && NEW + N(runs/$slug/$run/spent) <= N(runs/$slug/$run/reserved) && (NEW == OLD || NEW - OLD == D(spend/TODAY/runs/$slug/$run/released) + D(spend/YESTERDAY/runs/$slug/$run/released))"
          },
          "spent": {
            ".write": "RUN && newData.exists()",
            ".validate": "AMOUNT && NEW >= OLD && NEW + N(runs/$slug/$run/released) <= N(runs/$slug/$run/reserved)"
          },
          "byTier": {
            "$tier": {
              ".validate": "$tier == 'b' || $tier == 'c'",
              "spent": {
                ".write": "RUN && newData.exists()",
                ".validate": "AMOUNT && NEW >= OLD && NEW + N(runs/$slug/$run/released) <= N(runs/$slug/$run/reserved)"
              }
            }
          },
          "notional": {
            ".write": "RUN && newData.exists()",
            ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= MAXRES"
          },
          "overrun": {
            ".write": "RUN && newData.exists()",
            ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= MAXRES"
          },
          "tokens": {
            ".write": "RUN && newData.exists()",
            ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= {{.MaxTokensPerWrite}}"
          },
          "exp": {
            ".write": "RUN && newData.exists() && !data.exists()",
            ".validate": "AMOUNT"
          }
        }
      }
    },
    "spend": {
      "$day": {
        "global": {
          ".read": "TOKEN || USER",
          "counted": {
            ".write": "TOKEN && DAYOK && newData.exists()",
            ".validate": "AMOUNT && D(spend/$day/global/counted) == RUNDELTA && (NEW <= OLD || !ENFORCE || NEW <= GLOBALDAILY)"
          },
          "spent": {
            ".write": "TOKEN && DAYOK && newData.exists()",
            ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= MAXRES"
          },
          "notional": {
            ".write": "TOKEN && DAYOK && newData.exists()",
            ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= MAXRES"
          },
          "calls": {
            ".write": "TOKEN && DAYOK && newData.exists()",
            ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= {{.MaxCallsPerWrite}}"
          },
          "byTier": {
            "$tier": {
              ".validate": "$tier == 'b' || $tier == 'c'",
              "spent": {
                ".write": "TOKEN && DAYOK && newData.exists()",
                ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= MAXRES"
              }
            }
          }
        },
        "repos": {
          "$slug": {
            ".read": "(TOKEN && auth.token.fs == $slug) || USER",
            "counted": {
              ".write": "TOKEN && auth.token.fs == $slug && DAYOK && newData.exists()",
              ".validate": "AMOUNT && D(spend/$day/repos/$slug/counted) == RUNDELTA && (NEW <= OLD || !ENFORCE || NEW <= REPODAILY)"
            },
            "spent": {
              ".write": "TOKEN && auth.token.fs == $slug && DAYOK && newData.exists()",
              ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= MAXRES"
            },
            "notional": {
              ".write": "TOKEN && auth.token.fs == $slug && DAYOK && newData.exists()",
              ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= MAXRES"
            },
            "calls": {
              ".write": "TOKEN && auth.token.fs == $slug && DAYOK && newData.exists()",
              ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= {{.MaxCallsPerWrite}}"
            },
            "byTier": {
              "$tier": {
                ".validate": "$tier == 'b' || $tier == 'c'",
                "spent": {
                  ".write": "TOKEN && auth.token.fs == $slug && DAYOK && newData.exists()",
                  ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= MAXRES"
                }
              }
            },
            "byModel": {
              "$model": {
                ".validate": "$model.length <= {{.MaxKeyLength}}",
                "micros": {
                  ".write": "TOKEN && auth.token.fs == $slug && DAYOK && newData.exists()",
                  ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= MAXRES"
                },
                "in": {
                  ".write": "TOKEN && auth.token.fs == $slug && DAYOK && newData.exists()",
                  ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= {{.MaxTokensPerWrite}}"
                },
                "out": {
                  ".write": "TOKEN && auth.token.fs == $slug && DAYOK && newData.exists()",
                  ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= {{.MaxTokensPerWrite}}"
                },
                "cr": {
                  ".write": "TOKEN && auth.token.fs == $slug && DAYOK && newData.exists()",
                  ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= {{.MaxTokensPerWrite}}"
                },
                "cw": {
                  ".write": "TOKEN && auth.token.fs == $slug && DAYOK && newData.exists()",
                  ".validate": "AMOUNT && NEW >= OLD && NEW - OLD <= {{.MaxTokensPerWrite}}"
                }
              }
            }
          }
        },
        "runs": {
          "$slug": {
            "$run": {
              ".read": "RUN || USER",
              "reserved": {
                ".write": "RUN && DAYOK && newData.exists()",
                ".validate": "AMOUNT && NEW >= OLD && (NEW == OLD || ($day == TODAY && NEW - OLD == D(runs/$slug/$run/reserved))) && COUNTERS_FOLLOW"
              },
              "released": {
                ".write": "RUN && DAYOK && newData.exists()",
                ".validate": "AMOUNT && NEW >= OLD && NEW + N(spend/$day/runs/$slug/$run/spent) <= N(spend/$day/runs/$slug/$run/reserved) && NEW - OLD <= D(runs/$slug/$run/released) && COUNTERS_FOLLOW"
              },
              "spent": {
                ".write": "RUN && DAYOK && newData.exists()",
                ".validate": "AMOUNT && NEW >= OLD && NEW + N(spend/$day/runs/$slug/$run/released) <= N(spend/$day/runs/$slug/$run/reserved)"
              },
              "byTier": {
                "$tier": {
                  ".validate": "$tier == 'b' || $tier == 'c'",
                  "spent": {
                    ".write": "RUN && DAYOK && newData.exists()",
                    ".validate": "AMOUNT && NEW >= OLD && NEW + N(spend/$day/runs/$slug/$run/released) <= N(spend/$day/runs/$slug/$run/reserved)"
                  }
                }
              }
            }
          }
        }
      }
    },
    "agents": {
      "$slug": {
        "$run": {
          ".read": "RUN",
          ".write": "RUN",
          ".validate": "newData.hasChildren(['repo', 'requestedBy'])",
          "repo": { ".validate": "STR && RBOK" },
          "workflow": { ".validate": "STR && RBOK" },
          "title": { ".validate": "STR && RBOK" },
          "stage": { ".validate": "STR && RBOK" },
          "verify": { ".validate": "STR && RBOK" },
          "coder": { ".validate": "STR && RBOK" },
          "reviewer": { ".validate": "STR && RBOK" },
          "recipe": { ".validate": "STR && RBOK" },
          "auth": { ".validate": "STR && RBOK" },
          "prUrl": { ".validate": "STR && RBOK" },
          "action": { ".validate": "STR && RBOK" },
          "tokens": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= {{.MaxTokensPerWrite}} && newData.val() % 1 == 0 && RBOK" },
          "halted": { ".validate": "STR && RBOK" },
          "round": { ".validate": "AMOUNT && RBOK" },
          "startedAt": { ".validate": "AMOUNT && RBOK" },
          "stageStartedAt": { ".validate": "AMOUNT && RBOK" },
          "stageDeadline": { ".validate": "AMOUNT && RBOK" },
          "updatedAt": { ".validate": "AMOUNT && RBOK" },
          "spent": { ".validate": "AMOUNT && RBOK" },
          "credential": { ".validate": "STR && RBOK" },
          "waiting_until": { ".validate": "TIMESTAMP && RBOK" },
          "requestedBy": { ".validate": "STR && RBOK" },
          "$other": { ".validate": false }
        }
      }
    },
    "outcomes": {
      "$day": {
        "$slug": {
          "$run": {
            ".write": "RUN && DAYOK && !data.exists()",
            ".validate": "newData.hasChildren(['status', 'requestedBy'])",
            "status": { ".validate": "newData.isString() && (newData.val() == 'succeeded' || newData.val() == 'failed' || newData.val() == 'halted' || newData.val() == 'cancelled' || newData.val() == 'infra_error' || newData.val() == 'none') && RBOK" },
            "requestedBy": { ".validate": "STR && RBOK" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "mailbox": {
      "$mb": {
        "inbox": {
          "$msg": {
            ".write": "MAILBOX && newData.exists() && !data.exists()",
            ".validate": "newData.hasChildren(['id', 'sender', 'text', 'at', 'mac']) && $msg.length <= {{.MaxKeyLength}} && KINDREQ",
            "id": { ".validate": "newData.isString() && newData.val().length <= {{.MaxKeyLength}} && newData.val() == $msg" },
            "sender": { ".validate": "STR && newData.val() == $mb" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= {{.MaxTextLength}}" },
            "at": { ".validate": "TIMESTAMP" },
            "mac": { ".validate": "MACOK" },
            "agent": { ".validate": "AGENTID" },
            "kind": { ".validate": "newData.isString() && (newData.val() == 'message' || newData.val() == 'prompt' || newData.val() == 'answer' || newData.val() == 'action')" },
            "options": {
              ".validate": "PARENTKIND == 'prompt' && newData.hasChildren()",
              "$i": { ".validate": "OPTIONIDX && newData.isString() && newData.val().length > 0 && newData.val().length <= {{.MaxOptionLength}}" }
            },
            "reply_to": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= {{.MaxKeyLength}} && (PARENTKIND == 'answer' || PARENTKIND == 'action')" },
            "action": {
              ".validate": "PARENTKIND == 'action' && newData.hasChildren(['id', 'verb', 'target', 'confirmation']) && (newData.child('verb').val() == 'merge' ? newData.child('head_sha').exists() : true)",
              "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= {{.MaxKeyLength}}" },
              "verb": { ".validate": "newData.isString() && (newData.val() == 'cancel' || newData.val() == 'merge' || newData.val() == 'confirm')" },
              "target": {
                ".validate": "TARGETOK",
                "run": { ".validate": "RUNTARGET" },
                "repo": { ".validate": "REPOTARGET" },
                "pr": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 == 0 && newData.val() <= {{.MaxTimestamp}}" },
                "$other": { ".validate": false }
              },
              "head_sha": { ".validate": "(newData.isString() && newData.val().length > 0) && SHAOK" },
              "confirmation": {
                ".validate": "newData.hasChildren(['id', 'at'])",
                "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= {{.MaxKeyLength}}" },
                "at": { ".validate": "TIMESTAMP" },
                "$other": { ".validate": false }
              },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },
        "outbox": {
          ".read": "MAILBOX",
          "$msg": {
            ".write": "CONSUMER && newData.exists() && !data.exists()",
            ".validate": "newData.hasChildren(['id', 'sender', 'text', 'at', 'mac']) && $msg.length <= {{.MaxKeyLength}} && KINDREQ",
            "id": { ".validate": "newData.isString() && newData.val().length <= {{.MaxKeyLength}} && newData.val() == $msg" },
            "sender": { ".validate": "STR && newData.val() == $mb" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= {{.MaxTextLength}}" },
            "at": { ".validate": "TIMESTAMP" },
            "mac": { ".validate": "MACOK" },
            "agent": { ".validate": "AGENTID" },
            "kind": { ".validate": "newData.isString() && (newData.val() == 'message' || newData.val() == 'prompt' || newData.val() == 'answer' || newData.val() == 'action')" },
            "options": {
              ".validate": "PARENTKIND == 'prompt' && newData.hasChildren()",
              "$i": { ".validate": "OPTIONIDX && newData.isString() && newData.val().length > 0 && newData.val().length <= {{.MaxOptionLength}}" }
            },
            "reply_to": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= {{.MaxKeyLength}} && (PARENTKIND == 'answer' || PARENTKIND == 'action')" },
            "action": {
              ".validate": "PARENTKIND == 'action' && newData.hasChildren(['id', 'verb', 'target', 'confirmation']) && (newData.child('verb').val() == 'merge' ? newData.child('head_sha').exists() : true)",
              "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= {{.MaxKeyLength}}" },
              "verb": { ".validate": "newData.isString() && (newData.val() == 'cancel' || newData.val() == 'merge' || newData.val() == 'confirm')" },
              "target": {
                ".validate": "TARGETOK",
                "run": { ".validate": "RUNTARGET" },
                "repo": { ".validate": "REPOTARGET" },
                "pr": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 == 0 && newData.val() <= {{.MaxTimestamp}}" },
                "$other": { ".validate": false }
              },
              "head_sha": { ".validate": "(newData.isString() && newData.val().length > 0) && SHAOK" },
              "confirmation": {
                ".validate": "newData.hasChildren(['id', 'at'])",
                "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= {{.MaxKeyLength}}" },
                "at": { ".validate": "TIMESTAMP" },
                "$other": { ".validate": false }
              },
              "$other": { ".validate": false }
            },
            "acked": {
              ".write": "MAILBOX && newData.exists() && !data.exists()",
              ".validate": "newData.isBoolean() && newData.val() == true && data.parent().exists()"
            },
            "$other": { ".validate": false }
          }
        },
        "heartbeat": {
          ".read": "MAILBOX",
          ".write": "CONSUMER && newData.exists()",
          ".validate": "newData.hasChildren(['at', 'boot', 'mac'])",
          "at": { ".validate": "TIMESTAMP" },
          "boot": { ".validate": "BOOTOK" },
          "mac": { ".validate": "MACOK" },
          "agents": {
            ".validate": "newData.hasChildren()",
            "$i": {
              ".validate": "AGENTIDX && newData.hasChildren(['id', 'name'])",
              "id": { ".validate": "AGENTID" },
              "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= {{.MaxAgentNameLength}}" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
