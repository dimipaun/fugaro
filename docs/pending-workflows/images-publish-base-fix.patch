--- a/.github/workflows/images.yml
+++ b/.github/workflows/images.yml
@@ -167,8 +167,12 @@
       fail-fast: false
       matrix:
         include:
+          # Pinned, not ubuntu-latest: on ubuntu-26.04 docker uses the
+          # containerd image store, whose build saves an index with a
+          # provenance attestation and whose RepoDigests also lists the
+          # local docker.io name, which broke publish-base for v0.11.4.
           - arch: amd64
-            runner: ubuntu-latest
+            runner: ubuntu-24.04
           - arch: arm64
             runner: ubuntu-24.04-arm
     runs-on: ${{ matrix.runner }}
@@ -194,6 +198,10 @@
         env:
           FUGARO_VERSION: ${{ needs.version.outputs.version }}
           ARCH: ${{ matrix.arch }}
+          # Each architecture must push as one plain image manifest: the
+          # index check in publish-base wants exactly the two children it
+          # pushed, and a default provenance attestation adds a third.
+          BUILDX_NO_DEFAULT_ATTESTATIONS: "1"
         run: PLATFORM="linux/$ARCH" images/build-base.sh base fugaro-base:ci
       - name: Smoke test
         if: contains(needs.version.outputs.kinds, ',base,')
@@ -245,7 +253,8 @@
       # on any other job in this workflow, and it is on the one job that
       # already holds packages: write and already runs on a tag push only.
       id-token: write
-    runs-on: ubuntu-latest
+    # Same image store as the amd64 build leg (see its runner pin).
+    runs-on: ubuntu-24.04
     timeout-minutes: 30
     steps:
       - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
@@ -269,7 +278,16 @@
             gunzip -c "fugaro-base-$arch.tar.gz" | docker load
             docker tag fugaro-base:ci "$repo:$VERSION-$arch"
             docker push "$repo:$VERSION-$arch"
-            digests="$digests $(docker image inspect --format '{{index .RepoDigests 0}}' "$repo:$VERSION-$arch")"
+            # The digest under $repo, not RepoDigests[0]: the containerd
+            # image store also lists the loaded local name
+            # (fugaro-base@sha256:...), which imagetools would read from
+            # Docker Hub and be refused.
+            pushed_ref=$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$repo:$VERSION-$arch" | grep -F "$repo@" | head -n 1)
+            if [ -z "$pushed_ref" ]; then
+              echo "::error::no $repo@ digest for $repo:$VERSION-$arch after its push" >&2
+              exit 1
+            fi
+            digests="$digests $pushed_ref"
             docker image rm fugaro-base:ci "$repo:$VERSION-$arch" >/dev/null
           done
           tags="--tag $repo:$VERSION"
