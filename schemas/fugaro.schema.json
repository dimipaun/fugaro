{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dimipaun/fugaro/main/schemas/fugaro.schema.json",
  "title": "fugaro.yaml",
  "description": "Per-repository Fugaro configuration. See docs/design/v1.md §5.1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "git", "workflows"],
  "allOf": [
    {
      "if": { "required": ["git"], "properties": { "git": { "required": ["provider"], "properties": { "provider": { "const": "github" } } } } },
      "then": { "properties": { "followup": { "properties": { "trusted": { "items": { "$ref": "#/$defs/githubUserID" } } } } } }
    },
    {
      "if": { "required": ["git"], "properties": { "git": { "required": ["provider"], "properties": { "provider": { "const": "bitbucket" } } } } },
      "then": { "properties": { "followup": { "properties": { "trusted": { "items": { "$ref": "#/$defs/bitbucketAccountID" } } } } } }
    }
  ],
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$", "description": "The Fugaro project this repository belongs to." },
    "gcp_project": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$", "description": "The GCP project ID of the installation. Optional; the trust anchor that lets a teammate use the installation without running fugaro init (written by fugaro init). Never guessed from the project name." },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "enum": ["github", "bitbucket"] },
        "base_branch": {
          "type": "string",
          "description": "A plain git branch name. Git accepts shell metacharacters in ref names; Fugaro does not, because the branch reaches git, Docker build arguments and Cloud Build.",
          "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/-]*$",
          "not": { "pattern": "\\.\\.|//|(^|/)\\.|\\.lock(/|$)|[/.]$" }
        },
        "pr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "labels": { "type": "array", "items": { "type": "string" } },
            "reviewers": { "type": "array", "items": { "type": "string" } },
            "early_draft": { "type": "boolean", "description": "Open the draft pull request at the first verified push (default true). False opens it only when the run finishes, for repositories whose host has no drafts. Labels and reviewers are applied only when the PR becomes ready." },
            "checkpoints": { "type": "boolean", "description": "Push each commit a run makes to its branch within about a minute (after 5 s without a newer one, at most one push a minute, and at once at every stage boundary), fast-forward only, so a container that dies keeps its committed work (default true). With early_draft, the first checkpoint opens the draft pull request, marked not verified. False pushes only at verified stage ends and at the end. Every push to a branch with an open pull request runs its CI: at worst 60 pushes an hour. Fugaro 0.5.1 or later." }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": { "enum": ["vertex", "api-key", "oauth"] },
        "model": { "$ref": "#/$defs/modelName" },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "description": "A model per stage role; a role left out uses agent.model. With a budget on, each must be an explicit model ID that has a price.",
          "properties": {
            "coder": { "$ref": "#/$defs/modelName", "description": "implement and fix" },
            "reviewer": { "$ref": "#/$defs/modelName", "description": "review" },
            "background": { "$ref": "#/$defs/modelName", "description": "Claude Code's small background requests" }
          }
        },
        "max_output_tokens": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-call output limit by role; 0 is no limit.",
          "properties": {
            "coder": { "type": "integer", "minimum": 0, "maximum": 128000 },
            "reviewer": { "type": "integer", "minimum": 0, "maximum": 128000 }
          }
        },
        "max_run_tokens": { "type": "integer", "minimum": 0, "description": "Limit on a whole run's tokens; 0 is none. In a fugaro.yaml it can only tighten the project's ceiling and the default branch's value." },
        "review_rounds": { "type": "integer", "minimum": 1, "maximum": 10 },
        "first_line_review": { "enum": ["auto", "on", "off"], "description": "A review by the coder's own model, with a fix between, before the senior review. auto: on only when a provider serves the coder and not the reviewer." },
        "first_line_rounds": { "type": "integer", "minimum": 1, "maximum": 3, "description": "First-line review/fix cycles, counted apart from review_rounds." },
        "recipe": { "type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?)?$", "description": "The recipe (task loop) runs use unless fugaro run --recipe names one: .fugaro/recipes/<name>.yaml, the project's fugaro/recipes/<name>.yaml, or the catalog (default, cheap-loop-senior, claude-solo). Fugaro before 0.5.0 refuses this key." },
        "max_budget_usd": { "type": "number", "minimum": 0 },
        "instructions": { "type": "string" },
        "review": { "type": "string" }
      }
    },
    "budget": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "The repository's cost and model policy. The runner reads it from the default branch and merges it with the project's ceiling; it can only tighten. Model prices are not settable here. A null block, mode, cap or list is the same as leaving it out.",
      "properties": {
        "mode": { "enum": ["off", "observe", "enforce", "", null], "description": "The strictest mode of the layers wins: enforce, then observe, then off." },
        "per_run_usd": {
          "type": ["number", "null"],
          "maximum": 100000,
          "anyOf": [{ "const": 0 }, { "minimum": 0.0000005 }, { "type": "null" }],
          "description": "A dollar cap per run; the lowest positive cap of the layers wins. 0 sets none. A cap that rounds to less than a millionth of a dollar is refused."
        },
        "per_day_usd": {
          "type": ["number", "null"],
          "maximum": 100000,
          "anyOf": [{ "const": 0 }, { "minimum": 0.0000005 }, { "type": "null" }],
          "description": "A dollar cap per UTC day for this repository, enforced by the runner (not the database); the lowest positive cap of the layers wins, and a lower cap the owner set in the database wins over it. 0 sets none."
        },
        "allowed_models": {
          "type": ["array", "null"],
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^claude-[a-z0-9]+(?:-[a-z0-9]+)*(?:@[0-9]{8})?$", "not": { "pattern": "-latest$" }, "description": "An explicit model ID, not an alias." },
          "description": "The models the run may use; the intersection of the layers' lists."
        }
      }
    },
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "description": "Who can steer a follow-up run on a Fugaro pull request (design §4.4, §6.1).",
      "properties": {
        "trusted": {
          "type": ["array", "null"],
          "uniqueItems": true,
          "description": "Account IDs whose PR comments a follow-up acts on: on GitHub the numeric user ID, on Bitbucket the account_id.",
          "items": { "type": ["string", "integer"] }
        },
        "allow_public": { "type": "boolean", "description": "Allow follow-ups on a public repository, where anyone can comment." }
      }
    },
    "workflows": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,19}$" },
      "additionalProperties": { "$ref": "#/$defs/workflow" }
    }
  },
  "$defs": {
    "modelName": { "type": "string", "maxLength": 100, "pattern": "^\\S*$" },
    "githubUserID": {
      "description": "A GitHub numeric user ID, which a rename doesn't change (gh api users/<login> --jq .id).",
      "anyOf": [
        { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        { "type": "integer", "minimum": 1, "maximum": 100000000000000000000, "description": "A YAML number is compared by value, so its 20-digit bound is approximate; fugaro checks the text." }
      ]
    },
    "bitbucketAccountID": {
      "type": "string",
      "description": "A Bitbucket account_id, in either form; a user's UUID is not accepted, since comment authors are matched by account_id.",
      "pattern": "^[0-9]{1,10}:[0-9a-f-]{36}$|^[0-9a-f]{24}$"
    },
    "duration": { "type": "string", "minLength": 2, "pattern": "^([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$", "description": "Whole days, hours, minutes and seconds, such as 90m, 1h30m or 1d12h. fugaro also accepts any Go duration, such as 1.5h." },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "commands"],
      "not": { "required": ["image", "dockerfile"] },
      "allOf": [
        {
          "if": { "required": ["base"], "properties": { "base": { "const": "go" } } },
          "then": {
            "properties": {
              "image": { "not": { "required": ["node"] }, "properties": { "skip_build_scripts": { "const": false } } }
            }
          }
        },
        {
          "if": { "required": ["base"], "properties": { "base": { "const": "java-services" } } },
          "then": {
            "properties": {
              "image": { "not": { "required": ["node"] }, "properties": { "skip_build_scripts": { "const": false } } }
            }
          }
        }
      ],
      "properties": {
        "base": { "enum": ["go", "java-services", "web-node"] },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "node": { "type": ["string", "integer"], "pattern": "^[0-9]+(\\.[0-9]+\\.[0-9]+)?$" },
            "skip_build_scripts": { "type": "boolean" },
            "apt": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]+(=[A-Za-z0-9.+~:-]+)?$" }
            },
            "setup": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
                "not": { "pattern": "<<|\\\\\\s*$|^[\\s\\v]*[-\\[]" }
              }
            }
          }
        },
        "dockerfile": {
          "type": "string",
          "pattern": "^[^/]",
          "not": { "pattern": "(^|/)\\.\\.(/|$)" }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["build", "test"],
          "properties": {
            "build": { "type": "string", "minLength": 1 },
            "test": { "type": "string", "minLength": 1 },
            "rerun_failed": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "each"],
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "each": { "type": "string", "pattern": "\\{id\\}" }
              }
            },
            "reports": { "type": "array", "items": { "type": "string" } }
          }
        },
        "cache": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "paths"],
            "properties": {
              "key": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "env"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "not": { "enum": ["bitbucket-token", "github-app-key", "claude-oauth-token", "anthropic-api-key"] }
              },
              "env": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$",
                "not": {
                  "anyOf": [
                    { "pattern": "^(FUGARO_|ANTHROPIC_|CLAUDE_CODE_|GIT_|LD_|DYLD_|PYTHON|BASH|LC_|DOCKER_|BUILDKIT_|CLOUDSDK_|CLOUD_RUN_|VERTEX_REGION_|GOOGLE_|GCE_|GRPC_|STORAGE_EMULATOR_)" },
                    { "enum": ["GODEBUG", "GOFLAGS", "GOTRACEBACK", "GOMAXPROCS", "GOMEMLIMIT", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "ALL_PROXY", "SSL_CERT_FILE", "SSL_CERT_DIR", "NODE_EXTRA_CA_CERTS", "CURL_CA_BUNDLE", "PATH", "HOME", "PWD", "OLDPWD", "SHELL", "USER", "LOGNAME", "HOSTNAME", "TMPDIR", "IFS", "LANG", "TERM", "TZ", "ENV", "CDPATH", "GLOBIGNORE", "PS4", "SHELLOPTS", "PROMPT_COMMAND", "NODE_OPTIONS", "NODE_PATH", "PERL5LIB", "PERL5OPT", "RUBYOPT", "RUBYLIB", "JAVA_TOOL_OPTIONS", "_JAVA_OPTIONS", "JDK_JAVA_OPTIONS", "GOOGLE_APPLICATION_CREDENTIALS", "GOOGLE_CLOUD_PROJECT", "GOOGLE_SDK_GO_LOGGING_LEVEL", "CLOUD_ML_REGION", "GCE_METADATA_HOST", "GCE_METADATA_IP", "IMAGE", "SECRET_ENVS", "WORKFLOW", "REPO_URL", "BASE_BRANCH"] }
                  ]
                },
                "description": "Must not be a variable Fugaro sets or one that changes how the runner, git, a shell, the build or a runtime behaves (config.ReservedEnvPrefixes and config.ReservedEnvNames)."
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": { "type": "integer", "minimum": 1 },
            "memory": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" }
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "total": { "$ref": "#/$defs/duration" },
            "stage": { "$ref": "#/$defs/duration" },
            "verify": { "$ref": "#/$defs/duration" },
            "finalize_reserve": { "$ref": "#/$defs/duration" }
          }
        },
        "rebuild": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "check": { "enum": ["daily", "off"] },
            "max_age": {
              "anyOf": [
                { "const": 0 },
                { "type": "string", "minLength": 1, "pattern": "^(0|(0+d)?(0+h)?(0+m)?(0+s)?)$", "description": "0 in any form fugaro reads, such as \"0\", 0d or 0s: no age limit." },
                { "type": "string", "minLength": 2, "pattern": "^([0-9]+d|([0-9]+d)?[0-9]+h)([0-9]+m)?([0-9]+s)?$", "description": "At least 1h and at most 90d, which fugaro checks: days or hours, then optional minutes and seconds, such as 14d or 1d12h." }
              ]
            },
            "lockfiles": { "type": "boolean" },
            "base": { "type": "boolean" },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^/\\s]",
                "not": { "pattern": "(^|/)\\.\\.(/|$)" }
              }
            }
          }
        }
      }
    }
  }
}
