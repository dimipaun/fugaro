{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dimipaun/fugaro/main/schemas/settings.schema.json",
  "title": "Fugaro settings",
  "description": "The document `fugaro settings --json` prints: one row per setting and scope, the layers the read touched with what came of each, and the built-in default of every key of the registry. See docs/settings-commands/spec.md §2.8. Members are only ever added within a version (D848), so a renamed or re-meant member is a new member under a new name and the old one is kept, and removing or retyping one bumps version. No object here is closed for that reason: additionalProperties is left true everywhere, because a consumer that refused a member this schema does not know would refuse a newer CLI's document, which D848 promises to keep readable under the same version.",
  "type": "object",
  "required": [
    "version",
    "project",
    "generated_at",
    "sources",
    "settings"
  ],
  "properties": {
    "version": {
      "const": 1,
      "$comment": "settingsDocVersion in internal/cli/settings_render.go."
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "description": "The Fugaro project the read resolved, as the local selector names it."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the read ran, UTC. A consumer says how old an answer is from this, without a second call."
    },
    "sources": {
      "type": "array",
      "description": "The layers this read touched, in precedence order. A layer that was not read is not listed, so a consumer never sees a source that answered nothing.",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "state": {
      "oneOf": [
        {
          "const": "ok"
        },
        {
          "const": "unpublished"
        },
        {
          "const": "unknown (no checkout on this machine)"
        },
        {
          "type": "string",
          "pattern": "^stale [0-9]+[smh]$"
        },
        {
          "type": "string",
          "pattern": "^unread: .+$"
        }
      ],
      "$comment": "The closed vocabulary of D851. `stale <age>` and `unread: <reason>` are open-ended, so they are patterns rather than constants; `unread` is never a default in its place, which is why it carries a reason and the pattern refuses an empty one."
    },
    "source": {
      "type": "object",
      "required": [
        "layer",
        "duration_ms",
        "status"
      ],
      "properties": {
        "layer": {
          "enum": [
            "default",
            "project",
            "profile",
            "repo",
            "flag",
            "local",
            "shared",
            "policy",
            "caps",
            "env"
          ],
          "$comment": "The layer names of settings.Layers (internal/settings/registry.go), which --layer also takes."
        },
        "read_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/state"
        },
        "note": {
          "type": "string",
          "description": "What the layer was: the cache's age, the local config's path, the repository's name."
        }
      }
    },
    "default": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "description": "The built-in default a run gets, absent when unset is the answer."
        },
        "source": {
          "type": "string",
          "description": "The qualified Go constant holding value, absent for a literal."
        },
        "unset": {
          "type": "string",
          "description": "The sentence saying what unset means, absent when value is the answer."
        }
      },
      "$comment": "Exactly one of value and unset is set, the way settings.Default is built (internal/settings/registry.go)."
    },
    "level": {
      "type": "object",
      "required": [
        "layer",
        "value",
        "outcome"
      ],
      "properties": {
        "layer": {
          "enum": [
            "default",
            "project",
            "profile",
            "repo",
            "flag",
            "local",
            "shared",
            "policy",
            "caps",
            "env"
          ]
        },
        "value": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "$comment": "Whether the level won, was overridden, or was ignored as looser than the winner (spec §2.6). The last two are the cloud layers' (S2), so the word is not closed here."
        }
      }
    },
    "row": {
      "type": "object",
      "required": [
        "key",
        "scope",
        "wins",
        "default",
        "state"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "$comment": "A key of the registry, and of $defs.keyDefaults below. Not an enum on purpose: a newer CLI's key is a member added within the version."
        },
        "scope": {
          "type": "string",
          "pattern": "^(project|repo:[^\\s/]+/[^\\s/]+)$",
          "description": "`project`, or `repo:owner/name` for a repository scope."
        },
        "value": {
          "type": "string",
          "$comment": "Absent, not null and not a sentinel, when the row is sensitive: the only spelling a consumer cannot mistake for the value."
        },
        "wins": {
          "enum": [
            "default",
            "project",
            "profile",
            "repo",
            "flag",
            "local",
            "shared",
            "policy",
            "caps",
            "env"
          ],
          "description": "The layer that decided the value, or `default` when none did."
        },
        "default": {
          "$ref": "#/$defs/default"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "sensitive": {
          "type": "boolean",
          "description": "Absent when false. A sensitive row carries the set/unset fact in value and never the value itself."
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/level"
          }
        }
      }
    },
    "keyDefaults": {
      "type": "object",
      "description": "Every key of the registry and its built-in default, the DEFAULT column's own source (D841). A generator would be a go generate step a release must remember and a diff nobody reads, so this is written out and pinned to settings.Rows() by TestSettingsSchema in schemas_test.go.",
      "properties": {
        "agent.auth": {
          "$comment": "config.DefaultAgentAuth",
          "default": "vertex"
        },
        "agent.compression": {
          "default": "unset = inherit"
        },
        "agent.first_line_review": {
          "$comment": "config.FirstLineAuto",
          "default": "auto"
        },
        "agent.first_line_rounds": {
          "$comment": "config.DefaultFirstLineRounds",
          "default": "1"
        },
        "agent.instructions": {
          "default": "unset = none"
        },
        "agent.max_budget_usd": {
          "$comment": "config.DefaultMaxBudgetUSD",
          "default": "25"
        },
        "agent.max_output_tokens.coder": {
          "default": "unset = the ceiling's"
        },
        "agent.max_output_tokens.reviewer": {
          "default": "unset = the ceiling's"
        },
        "agent.max_run_tokens": {
          "default": "unset = the ceiling's"
        },
        "agent.model": {
          "default": "unset = Fugaro's own model choice"
        },
        "agent.models.background": {
          "default": "unset = agent.model"
        },
        "agent.models.coder": {
          "default": "unset = agent.model"
        },
        "agent.models.reviewer": {
          "default": "unset = agent.model"
        },
        "agent.oauth_token": {
          "default": "unset = the job's own credential"
        },
        "agent.recipe": {
          "default": "unset = the built-in recipe"
        },
        "agent.review": {
          "default": "unset = none"
        },
        "agent.review_rounds": {
          "$comment": "config.DefaultReviewRounds",
          "default": "2"
        },
        "backend": {
          "default": "unset = cloud-run"
        },
        "base_branch": {
          "default": "unset = none: each repository's own branch"
        },
        "base_images": {
          "default": "unset = the installation's own base image per kind"
        },
        "batch.boot_image": {
          "default": "unset = the batch design's own boot image"
        },
        "batch.image": {
          "default": "unset = Fugaro's own batch image"
        },
        "batch.machine_type": {
          "default": "unset = the batch design's own machine"
        },
        "batch.network": {
