{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dimipaun/fugaro/main/schemas/recipe.schema.json",
  "title": "Fugaro recipe",
  "description": ".fugaro/recipes/<name>.yaml, or fugaro/recipes/<name>.yaml in the runs bucket. See docs/recipes.md. At most 16 KiB; anchors, aliases, tags, repeated keys and extra documents are refused.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "steps"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$", "description": "Must equal the file name (repository) or the object name (project)." },
    "description": { "type": "string", "maxLength": 200, "pattern": "^[^\u0000-\u001f\u007f-\u009f­؀-؅؜۝܏࣢᠎​-‏ -‮⁠-⁤⁦-⁯﻿￹-￻]*$", "$comment": "The pattern refuses C0, DEL, C1 and the BMP format characters and line separators the Go parser refuses (recipe.hasControlChar); the parser is stricter (it also refuses the astral format characters). maxLength here counts Unicode characters (the JSON Schema spec); the Go parser's 200-byte limit (recipe.MaxDescription) is stricter for any multi-byte character, so this schema accepts some strings the parser refuses." },
    "use_when": { "type": "string", "maxLength": 300, "pattern": "^[^\u0000-\u001f\u007f-\u009f­؀-؅؜۝܏࣢᠎​-‏ -‮⁠-⁤⁦-⁯﻿￹-￻]*$", "description": "The routing skill's self-description.", "$comment": "maxLength here counts Unicode characters (the JSON Schema spec); the Go parser's 300-byte limit (recipe.MaxUseWhen) is stricter for any multi-byte character, so this schema accepts some strings the parser refuses. The pattern matches the BMP part of the parser's control-character, format-character and line-separator refusal." },
    "mode": { "enum": ["implement", "review"] },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "not": { "required": ["reviewer", "coder"] },
      "properties": {
        "reviewer": { "const": "coder", "description": "The reviewer role runs on the coder's model and output limit." },
        "coder": { "const": "reviewer", "description": "The coder role runs on the reviewer's (strong) model." }
      }
    },
    "steps": {
      "oneOf": [
        { "type": "array", "prefixItems": [{ "$ref": "#/$defs/reviewNoBounce" }], "items": false, "minItems": 1 },
        { "type": "array", "prefixItems": [{ "$ref": "#/$defs/firstLine" }, { "$ref": "#/$defs/reviewBounce" }], "items": false, "minItems": 2 },
        { "type": "array", "prefixItems": [{ "$ref": "#/$defs/check" }, { "$ref": "#/$defs/reviewNoBounce" }], "items": false, "minItems": 2 },
        { "type": "array", "prefixItems": [{ "$ref": "#/$defs/check" }, { "$ref": "#/$defs/firstLine" }, { "$ref": "#/$defs/reviewBounce" }], "items": false, "minItems": 3 }
      ]
    }
  },
  "if": {
    "properties": { "mode": { "const": "review" } },
    "required": ["mode"]
  },
  "then": {
    "properties": {
      "steps": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/reviewModeReview" }], "items": false, "minItems": 1, "maxItems": 1 }
    }
  },
  "$defs": {
    "firstLine": {
      "type": "object", "additionalProperties": false, "required": ["first_line"],
      "properties": { "first_line": { "type": ["object", "null"], "additionalProperties": false, "properties": { "max_rounds": { "type": "integer", "minimum": 1, "maximum": 3 } } } }
    },
    "reviewNoBounce": {
      "type": "object", "additionalProperties": false, "required": ["review"],
      "properties": { "review": { "type": ["object", "null"], "additionalProperties": false, "properties": { "max_rounds": { "type": "integer", "minimum": 1, "maximum": 10 } } } }
    },
    "reviewBounce": {
      "type": "object", "additionalProperties": false, "required": ["review"],
      "properties": { "review": { "type": ["object", "null"], "additionalProperties": false, "properties": { "max_rounds": { "type": "integer", "minimum": 1, "maximum": 10 }, "bounce": { "const": "first_line" } } } }
    },
    "reviewModeReview": {
      "type": "object", "additionalProperties": false, "required": ["review"],
      "properties": { "review": { "type": ["object", "null"], "additionalProperties": false, "properties": { "max_rounds": { "const": 1 } } } }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["check"],
      "properties": {
        "check": {
          "type": "object", "additionalProperties": false, "required": ["command"],
          "properties": {
            "command": { "enum": ["build", "test", "lint"] },
            "autofix": { "type": "boolean" }
          },
          "if": { "properties": { "command": { "const": "lint" } } },
          "else": { "properties": { "autofix": { "const": false } } }
        }
      }
    }
  }
}
