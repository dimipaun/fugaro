{
  // The DSN build step's build (desktop-console plan Task 2.1b).
  //
  // The second half of `npm run build`'s tooling, exactly as
  // `tsconfig.bundle-renderer.json` is the first: `tsc -p tsconfig.build.json`
  // compiles the app to `dist/`, and this compiles the one tool that has to run
  // as a *file* -- `node` cannot run TypeScript, and the alternative, a loader
  // flag on the pinned Node, would put an experimental switch in the app's build
  // path.
  //
  // A fourth config rather than an edit to one of the others because the
  // `rootDir`s differ: this takes `tools/crash-dsn/` to `.crash-dsn/`, which is a
  // build artifact and is gitignored.
  //
  // The module settings are `tsconfig.build.json`'s and for the same reason:
  // package.json has no `"type"`, so the emitted `.js` is CommonJS, which is what
  // `node` expects to `require`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "noEmit": false,
    "outDir": ".crash-dsn",
    "rootDir": "tools/crash-dsn",
    "sourceMap": true
  },
  // Only the tool: it imports nothing but Node's own built-ins, and it must not
  // import `src/`, which is the app's own build output and not a library.
  "include": ["tools/crash-dsn/**/*.ts"]
}
