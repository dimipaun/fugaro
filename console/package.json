{
  "name": "fugaro-console",
  "private": true,
  "version": "0.117.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "The Fugaro desktop console: the Electron application under console/, never published to npm and never importable by the Go module. Every specifier here is an EXACT version (desktop-console plan Task 1.0, design section 5.2), enforced by test/unit/pinning.test.ts; Electron in particular is pinned on purpose and bumped on purpose, with the toolchain task, exactly as internal/budget/rules/emulator/package.json pins firebase-tools.",
  "homepage": "https://fugaro.dev",
  "author": {
    "name": "The Fugaro project",
    "email": "noreply@fugaro.dev"
  },
  "engines": {
    "node": "22.23.3"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.bundle-renderer.json && node .bundle-renderer/index.js",
    "test:unit": "vitest run --dir test/unit",
    "test:e2e": "npm run build && npm run check:packed && playwright test --pass-with-no-tests",
    "check:packed": "node scripts/check-packed-notices.mjs",
    "typecheck": "tsc --noEmit",
    "record-fixture": "tsc -p tsconfig.record-fixture.json && node .record-fixture/tools/record-fixture/index.js",
    "screenshots": "npm run build && tsc -p tsconfig.screenshots.json && node .screenshots/tools/screenshots/capture.js",
    "package": "npm run build && electron-builder --mac --universal --publish never",
    "package:targets": "electron-builder --mac --universal --publish never",
    "package:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "io.github.dimipaun.fugaro-console",
    "productName": "Fugaro Console",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "LICENSE.md",
      "THIRD_PARTY_NOTICES.md",
      "dist/main/**/*.js",
      "!dist/main/fuses.js",
      "dist/preload/index.js",
      "dist/preload/installations.js",
      "dist/preload/confirm.js",
      "dist/shared/**/*.js",
      "dist/source/**/*.js",
      "!dist/source/fixture.js",
      "dist/bundle/confirm.html",
      "dist/bundle/confirm.js",
      "dist/bundle/console.css",
      "dist/bundle/console.js",
      "dist/bundle/elk-worker.min.js",
      "dist/bundle/IBMPlexMono-Medium.woff2",
      "dist/bundle/IBMPlexMono-Regular.woff2",
      "dist/bundle/IBMPlexMono-SemiBold.woff2",
      "dist/bundle/InstrumentSans-Bold.woff2",
      "dist/bundle/InstrumentSans-Medium.woff2",
      "dist/bundle/InstrumentSans-Regular.woff2",
      "dist/bundle/InstrumentSans-SemiBold.woff2",
      "dist/bundle/index.html",
      "dist/bundle/installations.html",
      "dist/bundle/installations.js",
      "dist/bundle/refusal.html",
      "!node_modules/@jridgewell/sourcemap-codec/**",
      "!node_modules/@oxc-parser/**",
      "!node_modules/@oxc-project/**",
      "!node_modules/@sentry/bundler-plugins/**",
      "!node_modules/balanced-match/**",
      "!node_modules/brace-expansion/**",
      "!node_modules/dotenv/**",
      "!node_modules/glob/**",
      "!node_modules/has-flag/**",
      "!node_modules/lru-cache/**",
      "!node_modules/magic-string/**",
      "!node_modules/minimatch/**",
      "!node_modules/minipass/**",
      "!node_modules/oxc-parser/**",
      "!node_modules/path-scurry/**",
      "!node_modules/sentry/**",
      "!node_modules/supports-color/**"
    ],
    "afterPack": "dist/main/fuses.js",
    "publish": null,
    "npmRebuild": false,
    "electronDownload": {
      "checksums": {
        "electron-v45.0.0-darwin-arm64.zip": "896c3a50b148e89a158dca08a6996a022ddf39b23aac871e107f5b4087f8caa9",
        "electron-v45.0.0-darwin-x64.zip": "7877c282e74a52f8d87949536a25735cf9982de1265b544c9cd258dd14eff4de",
        "electron-v45.0.0-linux-x64.zip": "22f6a10bd3f7fef987ddbb379d3375ce664ad0c98a9a50f80c89f1718a0c3e3a"
      }
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Fugaro.Console-${version}-linux-${arch}.${ext}",
      "executableName": "fugaro-console",
      "category": "Development;Monitor",
      "synopsis": "A desktop console for fugaro: live run monitoring and spending graphs.",
      "description": "A desktop application for watching fugaro runs: live run monitoring and spending graphs. It is strictly read-only, and the fugaro CLI is its data plane -- it has no backend, no service account and no credential of its own.",
      "maintainer": "Fugaro Console <dimipaun@users.noreply.github.com>"
    }
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "elkjs": "0.11.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@sentry/electron": "8.2.0",
    "electron-updater": "6.8.10"
  }
}
