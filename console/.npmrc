# The console's install policy (desktop-console plan Task 1.0, design section 5.2).
#
# save-exact: the pinning rule enforced by the client and not only by a test, so
#   an `npm install some-package` writes "some-package": "1.2.3" and never
#   "^1.2.3". The rule itself is test/unit/pinning.test.ts; this is what keeps a
#   later `npm install` from quietly needing that test to fail first.
# engine-strict: the toolchain is pinned, so a Node that does not satisfy
#   engines.node fails the install loudly instead of building an app that was
#   never tested on that runtime.
# package-lock / fund / audit: the lockfile is committed and never disabled, and
#   the funding and audit notices CI turns off are off here too, so a local
#   install and the CI install are the same install.
#
# The install command is `npm ci --ignore-scripts --no-audit --no-fund`
# (console/README.md), and `--ignore-scripts` is passed on the command rather
# than set here on purpose: Electron's postinstall downloads its prebuilt
# runtime and is the one lifecycle script the design expects to allow, per
# package, at packaging time (Task 4.1). A blanket `ignore-scripts=true` in this
# file would block that download with no way to allow a single package back.
save-exact=true
engine-strict=true
package-lock=true
fund=false
audit=false
