{
  // The recorder's build (desktop-console plan Task 1.4, the OWNER-RUN step).
  //
  // `npm run record-fixture -- --out test/fixtures/<name>.ndjson` is one command
  // an owner runs, and `node` has to run a file -- so this is the config that
  // produces it, exactly as `tsconfig.build.json` produces the Electron entry.
  // It is a second config rather than an edit to that one because the two have
  // different `rootDir`s and different outputs: the app's build takes `src/` to
  // `dist/` (package.json's `main`), and this takes `src/` *and* `tools/` to
  // `.record-fixture/`, which is a build artifact and is gitignored.
  //
  // The module settings are `tsconfig.build.json`'s and for the same reason:
  // package.json has no `"type"`, so the emitted `.js` is CommonJS, which is
  // what `node` expects to `require`. `verbatimModuleSyntax` is off for that
  // build only; every `import type` in the sources is already written as one.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "noEmit": false,
    "outDir": ".record-fixture",
    "rootDir": ".",
    "sourceMap": true
  },
  // `src/` is here because the tool imports the console's own rules rather than
  // copies of them (`planFor`, `decodeFeedLine`, the redactor, the fixture
  // writer), and `tools/` because that is where the tool lives.
  "include": ["src/**/*.ts", "tools/**/*.ts"]
}
