{
  // Astro's own strict preset and nothing on top of it: `strict: true` — which is
  // strictNullChecks, noImplicitAny and the rest of the family — over the module and
  // resolution settings Astro's base config declares. TypeScript is not a dependency of
  // this site: nothing here runs `tsc`, and this file is what an editor and Astro's own
  // diagnostics read. What holds the site together is therefore the tests over the built
  // artifact (`website/test/`) rather than types: a null the generated-content pipeline
  // (W1.3) did not handle is made loud by a build that stops or a test that fails, which
  // is the failure the site's own gates are written to produce.
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
