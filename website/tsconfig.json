{
  // Astro's own strict preset, plus the one setting it leaves off. TypeScript is not a
  // dependency of this site: nothing here runs `tsc`, and this file is what an editor and
  // Astro's own diagnostics read. `strictNullChecks` is spelled out because the preset
  // extends Astro's base config, which turns it off, and a null the site did not handle
  // is exactly the kind of defect the generated-content pipeline (W1.3) exists to make
  // loud rather than silent.
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true
  }
}
