---
/**
 * website/src/pages/[variant].astro — the four campaign pages, from one template (go-to-market
 * plan, Task G2.2; spec §6).
 *
 * **One route, four pages.** `/save`, `/control`, `/scale` and `/crew` are the spec's four
 * paths, and `getStaticPaths` below builds exactly the four `website/data/landing.yaml` writes,
 * in the file's own order — the file is the whole of which pages exist, so a fifth campaign is
 * a row in it and not a page here (G2.1). The paths carry no `/landing` prefix and are the
 * campaigns' own names, which is what makes the variant's `name` both the route's parameter and
 * the word the data file knows it by.
 *
 * **Every word a variant owns comes from the file.** The headline and the supporting line are
 * the file's (G2.1, D102), the proof band prints the file's figure or the sentinel in its place
 * (F6), and the tone the page's look keys off is the file's own word. What this page writes is
 * the section order — the spec's five, hero, proof, how it works, social proof, the calls to
 * action, with the console's screens between the last two (the owner's feedback of 2026-10-30,
 * D412's finding 3) — and the two links of the calls to action, which are `landing.yaml`'s
 * booking link and `site.yaml`'s repository rather than URLs typed here.
 *
 * **The page is rendered through the layout's campaign mode** (`campaign` on `Base.astro`):
 * `noindex` and canonical to the home page, the wordmark's row with no menu, the minimal
 * footer, and the `media` slot a variant's own picture lands in when the owner has produced one
 * (spec §6, F14, G2.5).
 *
 * **Nothing here renders the embed.** G2.3 renders the Calendly embed behind the marketing
 * consent and G2.4 owns the events; this page carries the plain booking link both of them build
 * on, the chat link the file's WhatsApp number makes, and no vendor asset and no `iframe` of its
 * own (F17, F22, D401).
 */
import Base from '../layouts/Base.astro'
import CampaignHero from '../components/CampaignHero.astro'
import CampaignProof from '../components/CampaignProof.astro'
import CampaignSteps from '../components/CampaignSteps.astro'
import CampaignSocialProof from '../components/CampaignSocialProof.astro'
import CampaignScreens from '../components/CampaignScreens.astro'
import CampaignCalls from '../components/CampaignCalls.astro'
import { loadLanding } from '../lib/landing.mjs'
import { loadSite } from '../content.ts'

const landing = loadLanding()
const site = loadSite()

export function getStaticPaths() {
  // The variants are passed through as they were loaded rather than re-read per page: the file
  // is validated once, and a page renders the same object the loader handed back (G2.1).
  return loadLanding().variants.map((variant) => ({ params: { variant: variant.name }, props: { variant } }))
}

const { variant } = Astro.props
---

<Base
  title={variant.headline}
  description={variant.supportingLine}
  campaign
  campaignPath={variant.path}
  calendlyURL={landing.calendlyURL}
>
  {/* The variant's own media, when it has one, in the layout's `media` slot: the top of the
      hero, above the headline. A video is the campaign's own file and a picture its still, so
      each renders where it is named — and `loadLanding()` reports neither when the file the
      owner has not produced yet is not under `website/public/`, so a variant that names a video
      the repository does not carry renders the page complete rather than a player with nothing
      in it (F14, G2.5). No variant names either today. The `alt` is empty because the file's
      media is the campaign's flourish rather than a thing a reader has to be told about — the
      words beside it are the page's content. */}
  {(variant.video || variant.image) && (
    <Fragment slot="media">
      {variant.video && (
        <video class="campaign-media" src={variant.video} controls preload="metadata" playsinline></video>
      )}
      {variant.image && <img class="campaign-media" src={variant.image} alt="" decoding="async" />}
    </Fragment>
  )}

  {/* The hero's picture: the console screen the variant names (`screenshot`, a row of
      `website/data/console-screens.yaml`, whose `src`, `alt`, caption and pixel size the hero
      renders), or the campaign's own drawing when the variant names no screen, and nothing while
      the variant carries media of its own — the slot above the headline is the variant's own file
      when there is one, and the hero's picture does not compete with it. One picture in the hero,
      whichever of the three it is (F14, G2.5). */}
  <CampaignHero
    headline={variant.headline}
    supportingLine={variant.supportingLine}
    tone={variant.tone}
    calendlyURL={landing.calendlyURL}
    art={variant.video === null && variant.image === null}
    screenshot={variant.screenshot}
  />
  <CampaignProof value={variant.proofNumber.value} source={variant.proofNumber.source} />
  <CampaignSteps />
  {/* Hidden while the file names no partner: the section is not rendered at all, so a campaign
      page with no proof of a partnership does not claim one (F11, F12, D405). */}
  {landing.partnerLogos.length > 0 && <CampaignSocialProof logos={landing.partnerLogos} />}
  {/* The console's screens, in the homepage's own slider: below the hero and above the closing
      call to action, which is the owner's bound (the feedback of 2026-10-30, D412's finding 3), so the
      page shows what a run looks like before it asks for the booking. It reads the rows through
      `loadHomeSliderScreens()`, which is the homepage's own list, so the two sliders are one
      set of pictures rather than two. */}
  <CampaignScreens />
  <CampaignCalls calendlyURL={landing.calendlyURL} repository={site.facts.repository} whatsappURL={variant.whatsappURL} />
</Base>

<style>
  /* The variant's own picture, full width at the top of the page: the one block the file's
     `image` renders in, and the only rule this page writes for it. */
  .campaign-media {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
