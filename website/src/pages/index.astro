---
// website/src/pages/index.astro — the site's front page (website plan, Task W1.4; the owner's
// redesign Step 3, rulings of 2026-10-23).
//
// **The page is one argument, in six blocks** (lever 1): what Fugaro is, with the one live
// thing and the real `fugaro watch` capture (`Hero`); why it is worth it, README.md's four
// reasons under its sentence about what a run is (`Benefits`); the run, as ONE section with the
// zoom diagrams beside its steps (`HomeRunBand`), where the page used to explain it three times
// over (the slider's first panel, the run band and the grid); what a run leaves behind and where
// you watch it, with the console's real screens and the console and phone app pages surfaced in
// the content rather than in the navigation (`HomeWhatYouGet`, lever 8); what a run costs and
// what stops it, moved here from `/caps-and-costs/` (`HomeCost`); and the install command with
// the closing call to action (`HomeInstall`).
//
// The slider (`HomeSlider.astro`) is retired with this page: its three panels were the run's
// first explanation, the benefits and the screenshots, and each now has its own section.
//
// Every block reads what it renders through the content pipeline (W1.3) and holds it to the
// repository; this page holds no fact of its own.
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Benefits from '../components/Benefits.astro'
import HomeRunBand from '../components/HomeRunBand.astro'
import HomeWhatYouGet from '../components/HomeWhatYouGet.astro'
import HomeCost from '../components/HomeCost.astro'
import HomeInstall from '../components/HomeInstall.astro'
---

<Base title="Fugaro">
  {/* Six top-level blocks, each carrying its own gutter and its own room below: `main:has(>
      .hero)` drops `main`'s padding on this page, so no block adds a top padding on top of the
      block above's bottom one, and the gap between two of them is one padding rather than two
      (`website/test/base-styles.mjs`'s `homeRhythmFailures`). */}
  <Hero />
  <Benefits />
  <HomeRunBand />
  <HomeWhatYouGet />
  <HomeCost />
  <HomeInstall />
</Base>
