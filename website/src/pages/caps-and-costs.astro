---
/**
 * website/src/pages/caps-and-costs.astro — the route (website plan, Task W1.5).
 *
 * The page is the component: `CapsCosts.astro` carries the hero, the figures, the caps and
 * every rule they are read under, and this file is the route and its title. The bold redesign
 * of 2026-10-21 (the owner's board `website/design-ref/CapsAndCostsV2.dc.html`) moved the
 * page's own `h1` and its lead into the component's hero band, so there is nothing left here
 * to lay out — which is what keeps the hero's copy and the figures it promises in one file.
 */
import Base from '../layouts/Base.astro'
import CapsCosts from '../components/CapsCosts.astro'
---

<Base title="Caps and costs">
  <CapsCosts />
</Base>
