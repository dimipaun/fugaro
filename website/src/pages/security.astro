---
/**
 * website/src/pages/security.astro — the security page (website plan, Task W1.8; the
 * owner's brief of 2026-10-19).
 *
 * **The page is three things, and nothing else.** The owner's feedback of 2026-10-19 cut it
 * to exactly that: a short high-level description of the security model and its boundaries,
 * the document's own "Reporting a vulnerability" section, and a link to `SECURITY.md` in
 * the repository. So the page that used to render `SECURITY.md` in full, behind a contents
 * list built from its headings, now renders one section of it and writes its own summary
 * line by line — and `website/test/security.mjs` holds the page to that shape: the three
 * regions, at most eight short bullets in the first of them, and no other text.
 *
 * Four decisions are visible in the file:
 *
 *   1. **The reporting section is the document's, byte for byte under the renderer.** It is
 *      extracted from the generated `website/content/security.md` — the file `go run
 *      ./internal/clidoc` writes from `SECURITY.md`, which `loadSite()` validates and a
 *      missing or hand-edited copy of stops the build (W1.3 step 2) — and rendered here, so
 *      the instructions a reader follows are the document's own words and cannot drift from
 *      the file the page links to. A document that renamed or moved the section stops the
 *      build rather than shipping a page with nowhere to send a reader who has found a
 *      vulnerability.
 *   2. **The summary is the page's own, and every bullet names its source.** The owner's
 *      brief is that the description is high level and short; each bullet below therefore
 *      carries a comment naming the `SECURITY.md` section (or the design document) it comes
 *      from, and the page claims nothing those sources do not say: no bullet softens a
 *      limit the document states, and the two that are conditional (budget mode, the
 *      per-installation read grant) say so.
 *   3. **The link is the repository's, and its path is read rather than typed.** The URL is
 *      built from `site.yaml`'s repository and the generated file's own `source:` header,
 *      so the page cannot point at a document this repository does not carry —
 *      `website/test/linkcheck.mjs` checks the path and the heading a GitHub link names.
 *   4. **The styles are global and token-only.** The reporting paragraphs arrive through
 *      `set:html`, which Astro's scoped styles do not reach, so the block below is
 *      `is:global` and every selector is prefixed with the page's own marker attribute so it
 *      cannot reach another page. Colours come from W1.2's semantic tokens and never from a
 *      literal here.
 *
 * Nothing in this file fetches anything, reads a clock or starts a process: the page is
 * built from the files in this repository (Global Constraints 4 and 5).
 */
import Base from '../layouts/Base.astro'
import { loadSite } from '../content.ts'

// The whole generated layer, validated: a missing or hand-edited security.md, or any other
// fact the site renders, fails here with the file's name in the message (see 1 above).
const site = loadSite()
const securityDocument = site.documents['security.md']

// ---------------------------------------------------------------------------------------
// The document's own reporting section.
// ---------------------------------------------------------------------------------------

/** The section's heading, which is what the page renders and what it links to. */
const REPORTING = 'Reporting a vulnerability'
const REPORTING_ID = 'reporting-a-vulnerability'

/**
 * The document's lines under its `## Reporting a vulnerability` heading, up to the next
 * heading of the same level or higher. A document without the heading fails the build: the
 * page sends a reader there, and a page that sent them nowhere would be worse than a build
 * that stops.
 */
function reportingLines(body: string): string[] {
  const lines = body.split('\n')
  const start = lines.findIndex((line) => line.trim() === `## ${REPORTING}`)
  if (start === -1) {
    throw new Error(
      `${securityDocument.path} has no "## ${REPORTING}" heading, so this page has nowhere to send a reader who has found a vulnerability. The section is rendered from the document, so a document that moved it stops the build.`,
    )
  }
  const rest = lines.slice(start + 1)
  const end = rest.findIndex((line) => /^#{1,2}[ \t]/.test(line))
  return end === -1 ? rest : rest.slice(0, end)
}

/** The document's inline markup, as HTML. */
function escapeHTML(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
}

/**
 * One line's inline markup: code spans, bold, italics and links, in the order the document
 * nests them, with everything else escaped. The subset is what the reporting section uses
 * and nothing else is guessed at, because a page that mangles a security sentence is worse
 * than one that does not render it (D99).
 */
function inline(text: string): string {
  let html = ''
  let plain = ''
  const flush = (): void => {
    html += escapeHTML(plain)
    plain = ''
  }

  let i = 0
  while (i < text.length) {
    const rest = text.slice(i)
    let match: RegExpExecArray | null = null

    if (text[i] === '`' && (match = /^`([^`]+)`/.exec(rest)) !== null) {
      flush()
      html += `<code>${escapeHTML(match[1])}</code>`
      i += match[0].length
      continue
    }
    if (rest.startsWith('**') && (match = /^\*\*(.+?)\*\*/.exec(rest)) !== null) {
      flush()
      html += `<strong>${inline(match[1])}</strong>`
      i += match[0].length
      continue
    }
    if (text[i] === '*' && (match = /^\*([^*]+)\*/.exec(rest)) !== null) {
      flush()
      html += `<em>${inline(match[1])}</em>`
      i += match[0].length
      continue
    }
    if (text[i] === '[' && (match = /^\[([^\]]*)\]\(([^)\s]+)\)/.exec(rest)) !== null) {
      flush()
      // The document's own target, escaped and not rewritten: a link in a security document
      // is written as a path from the repository root.
      html += `<a href="${escapeHTML(match[2])}">${inline(match[1])}</a>`
      i += match[0].length
      continue
    }

    plain += text[i]
    i++
  }

  flush()
  return html
}

/** The section's paragraphs, each rendered: the reporting section is two of them today. */
const reportingParagraphs = reportingLines(securityDocument.body)
  .join('\n')
  .split(/\n[ \t]*\n/)
  .map((paragraph) => paragraph.replace(/\s+/g, ' ').trim())
  .filter((paragraph) => paragraph !== '')
  .map(inline)

// The link's target: the file this page renders, in the repository `site.yaml` names. The
// path is the generated file's own `source:` fact, so neither the repository nor the path is
// written here, and `main` is the branch those files live on — the repository's default
// branch, which every other GitHub link the site builds also names.
const sourceHref = new URL(`blob/main/${securityDocument.source}`, `${site.facts.repository}/`).href
---

<Base
  title="Security"
  description="Fugaro's security model in short, the document's own instructions for reporting a vulnerability, and a link to the full policy."
>
  <article class="security" data-security-page>
    <h1>Security</h1>

    {/* The high-level description (1) and (2): one bullet per boundary, each naming the
        source it comes from in the comment beside it. Every claim here is a sentence of
        `SECURITY.md` in shorter words; the two conditional ones (budget mode off by default,
        the phone's per-installation read grant) say what they are conditional on. */}
    <section data-security-model>
      <h2>The security model</h2>
      <ul>
        {/* SECURITY.md, "What limits the blast radius today": one container per run. */}
        <li>
          <strong>What runs where.</strong> Every run gets a fresh cloud container of its own,
          which is discarded when the run ends.
        </li>
        {/* SECURITY.md, "What limits the blast radius today": narrow git credentials. */}
        <li>
          <strong>The git credential.</strong> A run's git credential is an installation token
          for its one repository, and it expires within about an hour.
        </li>
        {/* SECURITY.md, "What limits the blast radius today": the App's own permissions. */}
        <li>
          <strong>CI workflows.</strong> A run cannot change <code>.github/workflows/</code>:
          the GitHub App has no <code>workflows</code> permission.
        </li>
        {/* SECURITY.md, "Cloud keys stay in the cloud" and "Logs are isolated". */}
        <li>
          <strong>Secrets.</strong> No command copies a secret value back to your machine and
          <code>fugaro secrets</code> never prints one. Logs are redacted of every mounted
          secret; redaction is best effort.
        </li>
        {/* SECURITY.md, "What is not on by default" and "Money": the gateway, and the backstop
            you set yourself. The order matters here — the bullet says the mode is off first. */}
        <li>
          <strong>Spend.</strong> With budget mode on, every model call goes through a per-run
          gateway that pins the models and charges it against your caps. It is off by default:
          set a credit limit on every key you give Fugaro.
        </li>
        {/* docs/design/desktop-console.md §3.4 and D2, D14: read-only by an exact-argv
            allow-list, which is the whole fence; docs/mobile/reconciliation.md §4 (b1) and
            docs/mobile/README.md (D112's answer, the plan's P2.1): the four families the user
            claim may read, and the mailbox that is the phone's database surface. */}
        <li>
          <strong>Console and phone.</strong> The desktop console runs a fixed list of
          read-only <code>fugaro</code> commands and has no write path. The phone reads the
          caps, spend and kill switches under a user-claim read grant, and writes only its own
          mailbox.
        </li>
        {/* SECURITY.md, "The assumption". */}
        <li>
          <strong>The boundary.</strong> Fugaro assumes you trust the repository and the task:
          anyone who can push to the repository or launch a run can steer the agent, and a run
          is not a sandbox for code you would not run yourself.
        </li>
      </ul>
    </section>

    {/* The document's own reporting section (1), rendered and not edited. */}
    <section data-security-reporting>
      <h2 id={REPORTING_ID}>{REPORTING}</h2>
      {reportingParagraphs.map((paragraph) => <p set:html={paragraph} />)}
    </section>

    {/* The pointer to the document itself (3). */}
    <p class="policy" data-security-policy>
      The full policy is <a href={sourceHref} rel="noopener">{securityDocument.source}</a> in
      the repository.
    </p>
  </article>
</Base>

<style is:global>
  /* Global, because the reporting paragraphs arrive through `set:html` and Astro's scoped
     styles do not reach markup this page did not write; every selector is prefixed with
     `data-security-page`, so nothing here can reach another page. Colours are W1.2's tokens
     and this file carries no colour literal. */
  [data-security-page] {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-lg) var(--space-sm) var(--space-2xl);
    color: var(--text);
  }

  [data-security-page] h1 {
    font-size: var(--font-size-xl);
    margin: 0 0 var(--space-lg);
  }

  [data-security-page] h2 {
    font-size: var(--font-size-lg);
    margin: 0 0 var(--space-sm);
  }

  [data-security-model] {
    margin: 0 0 var(--space-lg);
  }

  [data-security-model] ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }

  [data-security-model] li {
    margin: 0 0 var(--space-sm);
    line-height: var(--leading-normal);
  }

  [data-security-model] strong {
    color: var(--text);
  }

  [data-security-reporting] {
    max-width: var(--measure);
    margin: 0 0 var(--space-lg);
  }

  [data-security-reporting] p {
    line-height: var(--leading-normal);
  }

  [data-security-page] code {
    background: var(--surface);
    border-radius: var(--radius-sm);
    padding: 0.1rem 0.3rem;
    font-size: 0.9em;
  }

  [data-security-page] a {
    color: var(--accent);
  }

  [data-security-policy] {
    max-width: var(--measure);
  }
</style>
