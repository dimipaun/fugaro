---
/**
 * website/src/pages/docs.astro — the docs hub (website plan, Task W1.7;
 * reconciliation finding 37, decision D98, Global Constraints 6 and 8).
 *
 * The hub's job is to be a hub, and this file is written to make that a property rather
 * than an intention. The guides the site could not keep in step with the repository are
 * **linked**, not copied: each entry is the link, the document's own title, the path it
 * lives at and one line of the hub's own about what the document answers — and
 * `website/test/docs-hub.mjs` refuses a paragraph of any document under `docs/` (or of
 * README.md) that appears on this page verbatim, and refuses an entry line that is a
 * sentence of the guide it is about. A page that restates a guide is a second copy of it,
 * and the copy a reader lands on is the one that drifts (finding 37, D98).
 *
 * Three facts this page renders rather than types:
 *
 *   1. **The repository.** Every GitHub URL here is `site.yaml`'s `repository` plus a
 *      path, so the site and the module name one repository
 *      (internal/cli/docs_website_boundary_test.go pins that value to go.mod's module
 *      path). The path is the one thing written here, and `website/test/docs-hub.mjs`
 *      resolves each one against this checkout — a guide that moves fails the site's own
 *      check rather than 404ing for a reader.
 *   2. **The entries' titles.** Each title is read out of the document itself — a file's
 *      `#` heading, or, for the quick start, the `##` heading the anchor names — so the
 *      hub cannot call a guide something the guide no longer calls itself.
 *   3. **The CLI reference.** The reference is generated from the command tree by W0.4
 *      into `website/content/cli-reference.md`, and the hub **links** it like every other
 *      document (the owner's preview feedback on #1003, 2026-10-24, took the rendered copy
 *      off this page): its title is read out of the file, so a regenerated reference is
 *      linked under the title it carries.
 *
 * Nothing here fetches anything: the documents are read from this repository at build
 * time, and the GitHub URLs are checked against the working tree by the site's own tests
 * rather than by a request (Global Constraints 4 and 8). No font, script, stylesheet,
 * image or embed reaches a reader from anywhere but this build (D106): the page links
 * nothing but this repository.
 *
 * **The bold look** (the owner's approved home page, PR #779; the owner's brief of
 * 2026-10-21 for this page). The page is styled in the shapes the foundation PR wrote once
 * for the site — the oversized headline with the accent's gradient, the slim lead, the
 * card — and it adds no shape of its own and touches no shared file: the headline is
 * `base.css`'s `.display-xl` with `.gradient-text` on the word, the Guides heading and the
 * reference's own title are `.display-md` (the class `demotedTitle` moves the generated title
 * onto), the guides are `.card`s in a grid, and no rule of this page's writes a type size, a
 * weight or a tracking of its own. **Not
 * one word of the page changed with it**: the headline, the lead, the entries' titles, the
 * paths and the answers are the strings they were, and the rendered reference is the
 * generated document it was — the redesign is the layout and the styling, and
 * `website/test/docs-hub.mjs` holds the words to the documents they come from either way.
 */
import { existsSync, readFileSync } from 'node:fs'
import path from 'node:path'

import Base from '../layouts/Base.astro'
import { loadSite, REPO_ROOT } from '../content.ts'
// GitHub's own anchor rule, and the one place it is written: this page resolves the
// fragments it links and `test/docs-hub.mjs` resolves them again, so the two have to be
// the same rule rather than two approximations of it (see the module's own note).
import { headingAnchor, headingText } from '../lib/github-slug.mjs'

const site = loadSite()
const facts = site.facts

/**
 * The one part of a GitHub URL that is not a fact in `site.yaml`: the ref the link
 * carries. `HEAD` is git's own name for the repository's default branch — resolved by
 * GitHub when a reader clicks rather than written down here — so the hub carries no second
 * copy of a branch name that could move without this page noticing.
 */
const REF = 'HEAD'

/** A file of this repository, by its path relative to the repository root. */
function repositoryFile(relative: string, what: string): string {
  const file = path.join(REPO_ROOT, relative)
  if (!existsSync(file)) {
    throw new Error(
      `${relative} is missing: ${what}. The hub links the guides this repository holds, and a link to a file that is not there is a 404 for a reader — so the build fails here rather than rendering it (W1.7 step 1).`,
    )
  }
  return readFileSync(file, 'utf8')
}

const HEADING = /^(#{1,6})\s+(.*)$/

/**
 * The text a heading line renders as: its inline links reduced to their text, its code
 * marks and its emphasis removed. An underscore is left alone — inside a word it is a
 * character and not emphasis, and the anchor GitHub makes keeps it.
 */
function plain(line: string): string {
  return headingText(line)
    .replace(/`/g, '')
    .replace(/\*/g, '')
    .trim()
}

/**
 * A document's own title: the text of its first `#` heading, or of the heading an anchor
 * names when the entry is a section of a document rather than a whole one (README.md's
 * quick start is `## Getting started`, and the hub links that section and not the file's
 * top). A missing heading is a build error naming the file: the hub renders the document's
 * title rather than typing one, so a document whose title moved fails the build instead of
 * being mislabelled.
 */
function titleOf(relative: string, anchor: string | null): string {
  const text = repositoryFile(relative, 'the hub links it')
  for (const line of text.split('\n')) {
    const match = HEADING.exec(line.trim())
    if (match === null) continue
    if (anchor === null) {
      if (match[1].length === 1) return plain(match[2])
      continue
    }
    if (headingAnchor(match[2]) === anchor) return plain(match[2])
  }
  throw new Error(
    anchor === null
      ? `${relative} carries no "# " title, and the hub renders each document's own title rather than typing one (W1.7 step 1).`
      : `${relative} carries no heading at the anchor #${anchor}, and the hub links that section by name. The path and the anchor are one fact: a section the document renamed is a link this page must change (W1.7 step 1).`,
  )
}

/**
 * One entry of the hub: where the document lives, the anchor within it, and the hub's own
 * line about what it answers. The line is the hub's own sentence and not the document's —
 * `website/test/docs-hub.mjs` refuses an entry whose line repeats a sentence of the
 * document it links — because the guide is one click away and a second copy of it here is
 * the copy that drifts.
 */
interface Guide {
  path: string
  anchor: string | null
  answers: string
}

// The guides, and the one place they are listed (W1.7 step 1). This list is the page's
// only hand-kept fact: the paths and anchors, which `website/test/docs-hub.mjs` resolves
// against this checkout, and the hub's own line about each.
const GUIDES: Guide[] = [
  {
    path: 'README.md',
    anchor: 'getting-started',
    answers: 'The quick start: what a reader needs installed, and the two steps from a checkout to a first run.',
  },
  {
    path: 'docs/gcp-setup.md',
    anchor: null,
    answers: 'The cloud side: what it needs first, the one command that creates the project, and how to check it.',
  },
  {
    path: 'docs/recipes.md',
    anchor: null,
    answers: 'How to choose the loop a run follows after the first implementation, per run or per repository.',
  },
  {
    path: 'docs/project-layer.md',
    anchor: null,
    answers: 'Project-wide defaults and named workflow profiles, and which layer wins for a key.',
  },
  {
    path: 'docs/multi-model.md',
    anchor: null,
    answers: 'Running a model served by OpenRouter through the gateway that prices and caps every call.',
  },
  {
    path: 'docs/git-providers.md',
    anchor: null,
    answers: 'The two providers Fugaro opens pull requests on, and the credentials each one is given.',
  },
]

const guides = GUIDES.map((guide) => ({
  ...guide,
  title: titleOf(guide.path, guide.anchor),
  href: `${facts.repository}/blob/${REF}/${guide.path}${guide.anchor === null ? '' : `#${guide.anchor}`}`,
}))

// The generated reference, linked like the guides: its title is the file's own `# ` line.
const reference = site.documents['cli-reference.md']
const referenceHeading = HEADING.exec(reference.body.split('\n')[0] ?? '')
if (referenceHeading === null || referenceHeading[1].length !== 1) {
  throw new Error(`${reference.path} does not open with a "# " title, and the hub links the reference under its own title.`)
}

const referenceEntry = {
  path: reference.path,
  anchor: null,
  answers: 'Every command and flag the binary ships, generated from the command tree.',
  title: plain(referenceHeading[2]),
  href: `${facts.repository}/blob/${REF}/${reference.path}`,
}

const entries = [...guides, referenceEntry]
---

<Base title="Documentation" description="The guides this repository holds, and the generated CLI reference.">
  {/* The hub's opening band: the headline and the lead, and the room the guides start after
      (the bold look's two blocks, separated by the hairline `.docs-hero` carries). **No word
      is added between the `h1` and the `Guides` heading**, and that is a gate's business
      rather than a taste: D188 reads a page's lead as the text between those two headings
      (`budget.mjs`'s `pageWords`, which measures 36 here), and this page's lead is 36 of its
      40 words — an eyebrow, a byline or a sentence about
      the page here would be a word the ceiling counts. */}
  <div class="docs-hero">
    <h1 class="docs-title display-xl"><span class="gradient-text">Documentation</span></h1>

    {/* The hub's lead (D188, D189). It is one sentence and it gathers what the guides below
        answer, in the order they are listed: D189 puts the hub's summary here, drawn from the
        per-guide `answers` lines the page already carries. It is not those lines themselves —
        six of them plus the reference's are about 110 words, and D188 holds every page's lead,
        this one included, to 40. So the lead is their subjects gathered into one sentence, and
        the answers stay on their entries, where the reader is when they need them. The count
        is rendered rather than typed, so a guide added to `GUIDES` changes the sentence with
        it. */}
    <p class="lead">
      {entries.length} documents, in the order a reader needs them: install the CLI, set up the
      cloud, choose the loop a run follows, configure the layers, run another model, connect a
      provider, and the generated command reference.
    </p>
  </div>

  <section class="docs-guides" id="guides">
    <h2 class="docs-heading display-md">Guides</h2>

    <ul class="guides">
      {entries.map((entry) => (
        <li class="guide card">
          <a href={entry.href}>{entry.title}</a>
          <code class="path">{entry.path}{entry.anchor === null ? '' : `#${entry.anchor}`}</code>
          <p class="answers">{entry.answers}</p>
        </li>
      ))}
    </ul>
  </section>

</Base>

<style is:global>
  /* The hub's own layout, in the bold look the owner approved on the home page (the
     foundation PR #779): the oversized headline with the accent's gradient on it, the slim
     lead under it, and the guides as a grid of the site's cards. Every shape here is a shared one — `base.css`'s `.display-xl`,
     `.display-md`, `.gradient-text` and `.card` — so this page adds no shape of its own and
     **no shared file is touched by the redesign of this page**: the tokens, the layout and
     the other pages are where the parallel page runs are, and a class each of them already
     has is a merge that cannot conflict.

     It is `is:global`, and every selector here is anchored on a class this file writes. Only the design tokens
     are named (W1.2's `tokens.css`); no colour, spacing or type size is written as a literal,
     so a palette change is that file's business. */

  /* The opening band: the headline and the lead, then the room the guides start after and the
     hairline that separates the two bands. The page's own vertical rhythm is here and not in
     `main`'s padding, which the layout gives every page: the room above the headline is the
     bold look's, and it is what makes the first screen of this page read as a band of the
     site rather than as a heading the layout happened to place. */
  .docs-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  /* The headline: `base.css`'s `.display-xl` — the display scale's largest step, the heaviest
     weight the system stack draws, and the display tracking, all written once for the site —
     with the accent's gradient on the word, which is the whole of this page's title and so
     the whole of what the gradient can carry. `max-width` keeps a headline from running the
     width of a wide page, which is what the step's size would otherwise let it do. */
  .docs-title {
    max-width: 20ch;
  }

  /* The lead: one step up the type scale from the body, the quieter tone, and the measure —
     the same shape the homepage's hero lead is set in. */
  .lead {
    margin: 0;
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--font-size-xl);
    line-height: var(--leading-snug);
  }

  .docs-guides {
    padding-top: var(--space-2xl);
  }

  .docs-heading {
    margin: 0 0 var(--space-lg);
  }

  /* The guides: a grid of cards, one per document, wrapping to one column on a phone. */
  .guides {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-md);
  }

  /* One guide: `base.css`'s `.card` — the padding, the hairline, the radius and the surface
     tone every raised thing on this site is drawn with — and the stack its three lines are
     laid in. */
  .guide {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  /* The guide's title, as the loudest line of its card: the display weight and the display
     tracking, one step down the type scale from the page's headline. Its colour and its
     underline are the site's link defaults (`base.css`), because it is a link and a reader
     has to be able to see that. */
  .guide a {
    font-size: var(--font-size-xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
  }

  /* The path: the file the guide lives in, in the mono face and the smallest step.
     `display: block` is what `website/test/spacing.mjs` reads as the boundary between the
     title above it and the path — the two are lines rather than one run of words, which the
     markup writes no space for. */
  .guide .path {
    display: block;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    overflow-wrap: anywhere;
  }

  .answers {
    margin: 0;
    color: var(--text-muted);
  }
</style>
