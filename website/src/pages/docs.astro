---
/**
 * website/src/pages/docs.astro — the docs hub (website plan, Task W1.7;
 * reconciliation finding 37, decision D98, Global Constraints 6 and 8).
 *
 * The hub's job is to be a hub, and this file is written to make that a property rather
 * than an intention. The guides the site could not keep in step with the repository are
 * **linked**, not copied: each entry is the link, the document's own title, the path it
 * lives at and one line of the hub's own about what the document answers — and
 * `website/test/docs-hub.mjs` refuses a paragraph of any document under `docs/` (or of
 * README.md) that appears on this page verbatim, and refuses an entry line that is a
 * sentence of the guide it is about. A page that restates a guide is a second copy of it,
 * and the copy a reader lands on is the one that drifts (finding 37, D98).
 *
 * Three facts this page renders rather than types:
 *
 *   1. **The repository.** Every GitHub URL here is `site.yaml`'s `repository` plus a
 *      path, so the site and the module name one repository
 *      (internal/cli/docs_website_boundary_test.go pins that value to go.mod's module
 *      path). The path is the one thing written here, and `website/test/docs-hub.mjs`
 *      resolves each one against this checkout — a guide that moves fails the site's own
 *      check rather than 404ing for a reader.
 *   2. **The entries' titles.** Each title is read out of the document itself — a file's
 *      `#` heading, or, for the quick start, the `##` heading the anchor names — so the
 *      hub cannot call a guide something the guide no longer calls itself.
 *   3. **The CLI reference.** The reference is generated from the command tree by W0.4,
 *      and this page **renders** it (step 3): a command that lands in the tree appears
 *      here the day the file is regenerated, with no edit to this page. Its own title line
 *      is rendered as a section heading of this page rather than as a second `h1` — the
 *      page's `h1` is the hub's — and the anchors its headings carry survive that move, so
 *      `#fugaro-budget-set` still lands where it says.
 *
 * Nothing here fetches anything: the documents are read from this repository at build
 * time, and the GitHub URLs are checked against the working tree by the site's own tests
 * rather than by a request (Global Constraints 4 and 8). No font, script, stylesheet,
 * image or embed reaches a reader from anywhere but this build (D106): the page links
 * nothing but this repository and the anchor it renders itself.
 */
import { existsSync, readFileSync } from 'node:fs'
import path from 'node:path'

import Base from '../layouts/Base.astro'
import { loadSite, REPO_ROOT } from '../content.ts'
// GitHub's own anchor rule, and the one place it is written: this page resolves the
// fragments it links and `test/docs-hub.mjs` resolves them again, so the two have to be
// the same rule rather than two approximations of it (see the module's own note).
import { escapeRawHtml } from '../lib/escape-raw-html.mjs'
import { commandBlockHTML } from '../lib/copy-control.mjs'
import { headingAnchor, headingText } from '../lib/github-slug.mjs'

// The generated reference is imported as a document rather than read as bytes: Astro
// compiles markdown at build time, which is what turns the file into the headings, tables
// and code spans a reader reads — and into the anchors those headings carry. Nothing is
// added to `package.json` for it (Global Constraint 5): markdown is the site's own
// toolchain, already installed.
import * as cliReference from '../../content/cli-reference.md'

const site = loadSite()
const facts = site.facts

/**
 * The one part of a GitHub URL that is not a fact in `site.yaml`: the ref the link
 * carries. `HEAD` is git's own name for the repository's default branch — resolved by
 * GitHub when a reader clicks rather than written down here — so the hub carries no second
 * copy of a branch name that could move without this page noticing.
 */
const REF = 'HEAD'

/** A file of this repository, by its path relative to the repository root. */
function repositoryFile(relative: string, what: string): string {
  const file = path.join(REPO_ROOT, relative)
  if (!existsSync(file)) {
    throw new Error(
      `${relative} is missing: ${what}. The hub links the guides this repository holds, and a link to a file that is not there is a 404 for a reader — so the build fails here rather than rendering it (W1.7 step 1).`,
    )
  }
  return readFileSync(file, 'utf8')
}

const HEADING = /^(#{1,6})\s+(.*)$/

/**
 * The text a heading line renders as: its inline links reduced to their text, its code
 * marks and its emphasis removed. An underscore is left alone — inside a word it is a
 * character and not emphasis, and the anchor GitHub makes keeps it.
 */
function plain(line: string): string {
  return headingText(line)
    .replace(/`/g, '')
    .replace(/\*/g, '')
    .trim()
}

/**
 * A document's own title: the text of its first `#` heading, or of the heading an anchor
 * names when the entry is a section of a document rather than a whole one (README.md's
 * quick start is `## Getting started`, and the hub links that section and not the file's
 * top). A missing heading is a build error naming the file: the hub renders the document's
 * title rather than typing one, so a document whose title moved fails the build instead of
 * being mislabelled.
 */
function titleOf(relative: string, anchor: string | null): string {
  const text = repositoryFile(relative, 'the hub links it')
  for (const line of text.split('\n')) {
    const match = HEADING.exec(line.trim())
    if (match === null) continue
    if (anchor === null) {
      if (match[1].length === 1) return plain(match[2])
      continue
    }
    if (headingAnchor(match[2]) === anchor) return plain(match[2])
  }
  throw new Error(
    anchor === null
      ? `${relative} carries no "# " title, and the hub renders each document's own title rather than typing one (W1.7 step 1).`
      : `${relative} carries no heading at the anchor #${anchor}, and the hub links that section by name. The path and the anchor are one fact: a section the document renamed is a link this page must change (W1.7 step 1).`,
  )
}

/**
 * One entry of the hub: where the document lives, the anchor within it, and the hub's own
 * line about what it answers. The line is the hub's own sentence and not the document's —
 * `website/test/docs-hub.mjs` refuses an entry whose line repeats a sentence of the
 * document it links — because the guide is one click away and a second copy of it here is
 * the copy that drifts.
 */
interface Guide {
  path: string
  anchor: string | null
  answers: string
}

// The guides, and the one place they are listed (W1.7 step 1). This list is the page's
// only hand-kept fact: the paths and anchors, which `website/test/docs-hub.mjs` resolves
// against this checkout, and the hub's own line about each.
const GUIDES: Guide[] = [
  {
    path: 'README.md',
    anchor: 'getting-started',
    answers: 'The quick start: what a reader needs installed, and the two steps from a checkout to a first run.',
  },
  {
    path: 'docs/gcp-setup.md',
    anchor: null,
    answers: 'The cloud side, one confirmed step at a time, with the rollback and the offboarding at the end.',
  },
  {
    path: 'docs/recipes.md',
    anchor: null,
    answers: 'How to choose the loop a run follows after the first implementation, per run or per repository.',
  },
  {
    path: 'docs/project-layer.md',
    anchor: null,
    answers: 'Project-wide defaults and named workflow profiles, and which layer wins for a key.',
  },
  {
    path: 'docs/multi-model.md',
    anchor: null,
    answers: 'Running a model served by OpenRouter through the gateway that prices and caps every call.',
  },
  {
    path: 'docs/git-providers.md',
    anchor: null,
    answers: 'The two providers Fugaro opens pull requests on, and the credentials each one is given.',
  },
]

const guides = GUIDES.map((guide) => ({
  ...guide,
  title: titleOf(guide.path, guide.anchor),
  href: `${facts.repository}/blob/${REF}/${guide.path}${guide.anchor === null ? '' : `#${guide.anchor}`}`,
}))

// The generated reference, and the entry that says where it is: this page renders it, so
// its entry is an anchor of this page rather than a link away from it (W1.7 step 3).
const reference = site.documents['cli-reference.md']
const referenceHeading = HEADING.exec(reference.body.split('\n')[0] ?? '')
if (referenceHeading === null || referenceHeading[1].length !== 1) {
  throw new Error(
    `${reference.path} does not open with a "# " title, and the hub renders that title as the reference's section heading (W1.7 step 3).`,
  )
}
const referenceTitle = plain(referenceHeading[2])

const referenceEntry = {
  path: reference.path,
  // No anchor: the reference is rendered on this page, so the entry shows the file it is
  // generated into rather than a fragment of it (the anchor in `href` is this page's own).
  anchor: null,
  answers: 'Every command and flag the binary ships, generated from the command tree and rendered below.',
  title: referenceTitle,
  href: '#cli-reference',
}

/**
 * The rendered reference with its own title moved one level down.
 *
 * The document is a page-shaped thing — it opens with an `h1` — and it is rendered inside
 * a page that already has one, so the title becomes the section heading it is on this
 * page. Nothing else is touched: the heading keeps its anchor, and the sections below it
 * are the generated file's own. A document that does not open with exactly one `h1` is a
 * build error naming the file, because the build has nothing to move and would otherwise
 * render a page with two titles.
 */
function demotedTitle(html: string, file: string, title: string): string {
  const titles = [...html.matchAll(/<h1\b[^>]*>([\s\S]*?)<\/h1>/g)]
  if (titles.length !== 1) {
    throw new Error(
      `${file} renders ${titles.length} "h1" headings and the page moves its title to a section heading: the generated document and this file have to agree on what its title is (W1.7 step 3).`,
    )
  }
  const rendered = titles[0][0].replace(/^<h1/, '<h2').replace(/<\/h1>$/, '</h2>')
  if (rendered.replace(/<[^>]*>/g, '').trim() !== title) {
    throw new Error(
      `${file}'s "# " title is ${JSON.stringify(title)} and its rendered title reads ${JSON.stringify(rendered.replace(/<[^>]*>/g, '').trim())}: the page renders the generated document, and the two disagree about its own title (W1.7 step 3).`,
    )
  }
  return html.replace(titles[0][0], rendered)
}

/**
 * The rendered reference with a copy control on every code block it carries (P6, D183).
 *
 * The control is added **here** and not in the generated document, and that is the whole
 * reason this function exists: `website/content/cli-reference.md` is generated from the
 * command tree and is never edited by hand, so a control written into it would be gone the
 * next time `go run ./internal/clidoc` ran. The transform reads the rendered HTML and
 * refuses to be quiet about anything it does not understand — a `<pre>` the pattern does not
 * reach, or a count that disagrees with the blocks the document opened, stops the build
 * rather than leaving one command on the page with no way to copy it.
 */
function withCopyControls(html: string): string {
  const opened = (html.match(/<pre\b/g) ?? []).length
  let wrapped = 0
  const out = html.replace(/<pre\b[\s\S]*?<\/pre>/g, (block) => {
    wrapped++
    return commandBlockHTML(block, 'Copy this command')
  })
  if (wrapped !== opened) {
    throw new Error(
      `${reference.path} renders ${opened} "<pre>" blocks and this page wrapped ${wrapped} of them: the copy control goes on every command the site prints, so a block the transform did not reach is a command a reader cannot copy (P6).`,
    )
  }
  return out
}

// The generated file's banner goes the way W1.3's pipeline takes it: `content.ts` reads
// `<!-- generated by …; do not edit -->` as the `generator` and `source` facts and drops it
// from the `body` it renders, and this page renders the same file, so the banner is dropped
// here too. It has to be dropped before `escapeRawHtml` runs, because that helper shows a
// reader every tag-shaped token the markdown renderer did not emit — and a comment is one of
// them, so the banner reached the page as the line `<!-- generated by go run
// ./internal/clidoc; do not edit -->` above the reference's own title. That is the build
// telling a reader about the build, the one class of text the redesign removes (RF8's premise
// is that the banner is never on a page; on this page it was, and `website/test/meta.mjs`
// refuses it now). Nothing else is touched: the file's own title, headings, anchors, tables
// and code spans are rendered as it writes them.
const compiledReference = (await cliReference.compiledContent()).replace(/^\s*(?:<!--[\s\S]*?-->\s*)+/, '')

// Raw HTML in the generated document is text, not markup: `<name>` is a placeholder a
// reader reads, and a browser would drop it as an unknown element (see the module's note).
const referenceHTML = withCopyControls(demotedTitle(escapeRawHtml(compiledReference), reference.path, referenceTitle))

const entries = [...guides, referenceEntry]
---

<Base title="Documentation" description="The guides this repository holds, and the generated CLI reference.">
  <h1>Documentation</h1>

  {/* The hub's lead (D188, D189). It is one sentence and it gathers what the guides below
      answer, in the order they are listed: D189 puts the hub's summary here, drawn from the
      per-guide `answers` lines the page already carries. It is not those lines themselves —
      six of them plus the reference's are about 110 words, and D188 holds every page's lead,
      this one included, to 40. So the lead is their subjects gathered into one sentence, and
      the answers stay on their entries, where the reader is when they need them. The count
      is rendered rather than typed, so a guide added to `GUIDES` changes the sentence with
      it. */}
  <p class="lead">
    {entries.length} documents, in the order a reader needs them: install the CLI, set up the
    cloud, choose the loop a run follows, configure the layers, run another model, connect a
    provider, and the generated command reference.
  </p>

  <section id="guides">
    <h2>Guides</h2>

    <ul class="guides">
      {entries.map((entry) => (
        <li class="guide">
          <a href={entry.href}>{entry.title}</a>
          <code class="path">{entry.path}{entry.anchor === null ? '' : `#${entry.anchor}`}</code>
          <p class="answers">{entry.answers}</p>
        </li>
      ))}
    </ul>
  </section>

  {/* The one guide that lives on this page rather than behind a link. `data-generated-document`
      names the file it was rendered from, and `website/test/docs-hub.mjs` reads it as the
      boundary between the hub's own words and a generated document — because the two rules
      are opposite: the hub may not repeat a document's prose, and this document is here to
      be read as it was generated. */}
  <section id="cli-reference" data-generated-document={reference.path}>
    <Fragment set:html={referenceHTML} />
  </section>

</Base>

<style is:global>
  /* The hub's own layout. It is `is:global` rather than scoped on purpose: the reference
     below is rendered from a generated document and its elements carry none of the
     compiler's scope attributes, so a scoped rule could not reach them — every selector
     here is anchored on a class this file writes, which is the scoping a rendered document
     needs. Only the design tokens are named (W1.2's `tokens.css`); no colour, spacing or
     type size is written as a literal, so a palette change is that file's business. */
  .lead {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .guides {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
  }

  .guide {
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
  }

  .guide a {
    color: var(--accent);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-medium);
  }

  .guide .path {
    display: block;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .answers {
    margin: var(--space-2xs) 0 0;
  }

  /* The rendered reference: a long generated document, given the typography a reader
     needs to follow a command, a flag table and a code span — and nothing that would make
     it look like anything other than the document it is. */
  #cli-reference {
    max-width: var(--measure);
  }

  #cli-reference h2 {
    font-family: var(--font-mono);
    font-size: var(--font-size-lg);
    margin-top: var(--space-lg);
  }

  #cli-reference h3,
  #cli-reference h4 {
    margin-top: var(--space-md);
  }

  #cli-reference code {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  #cli-reference table {
    border-collapse: collapse;
    width: 100%;
  }

  #cli-reference th,
  #cli-reference td {
    border: var(--border-width) solid var(--border);
    padding: var(--space-3xs) var(--space-2xs);
    text-align: left;
    vertical-align: top;
  }
</style>
