---
/**
 * website/src/layouts/Base.astro — the base layout (website plan, Task W1.3).
 *
 * Every page of the site renders through this file, which is why the four things below
 * are here rather than in each page:
 *
 *   1. **The head's facts.** The canonical URL, the sitemap hint and the OpenGraph tags
 *      are composed from `website/data/site.yaml` — the one absolute origin the site
 *      knows — and never hard-coded, so W2.2's domain change is one line in that file and
 *      a rebuild (D92, step 1). The homepage's title carries README.md's own headline and
 *      the description is the README's subline, for the same reason: the promise is a fact
 *      of the repository, read and not restated (changes spec item 2).
 *   2. **The content pipeline.** `loadSite()` reads every generated file and every fact
 *      the site renders, and throws — naming the file — when one is missing or malformed.
 *      Calling it here means a build that renders a page has checked the whole generated
 *      layer first: there is no build that renders an empty install block or an
 *      ungenerated security page (step 2, the red step this task answers).
 *   3. **The reduced-motion base.** One global rule neutralises the site's animation and
 *      transition durations for a visitor who has asked their system for less motion, and
 *      it is written here rather than in each component so that a new component cannot
 *      forget it (step 3, D105).
 *   4. **The analytics gate's configuration.** The gate itself is code, and it lives in the
 *      site's one script file (D183, `public/scripts/site.js`) — this file emits no inline
 *      script, which is why the deployed policy needs no hash and no `'unsafe-inline'`. What
 *      the layout contributes is the gate's three facts, and it contributes them only when
 *      `site.yaml` says analytics are on: the consent key and the property id and origin go
 *      into the banner's own markup (`ConsentBanner.astro`, rendered here when the flag is
 *      on), and `site.js` reads them from there. With the flag off there is no banner, no
 *      configuration and no analytics origin anywhere in the artifact, so the deployed policy
 *      is the only place the exception is written down.
 *
 *   5. **The site's one script.** `public/scripts/site.js` (D183) is loaded here, once, for
 *      every page: it is the copy control on the command blocks (P6), the menu's Escape and
 *      outside-click close and its hover-open on a pointer that hovers (P3, and the owner's
 *      brief of 2026-10-18 item 1), and the consent gate's banner and analytics bootstrap
 *      (W3.2), and it is the only script file the artifact carries. `defer` is the load's
 *      whole contract — the script
 *      runs after the document is parsed, so every block it drives is already in the tree —
 *      and nothing on any page depends on it: the commands are in the markup in full and the
 *      controls are emitted `hidden` and revealed by it.
 *
 *   6. **The campaign mode** (go-to-market plan, Task G2.2). `campaign` renders the page as one
 *      of the four landing pages `/save`, `/control`, `/scale` and `/crew` builds (spec §6),
 *      which are the site's one kind of page that is not a page of the site: the head is
 *      `noindex` and canonical to the home page rather than to itself (F14), the header is the
 *      wordmark with no menu, and the footer is the three links a reader looks for. The mode is
 *      a prop on this layout rather than a second layout, because everything else a page needs
 *      is the same page: the same consent banner in the same place, the same one script, the
 *      same tokens and the same reduced-motion base. It declares the two slots the campaign
 *      uses — `campaign-banner`, which G2.3 wires the campaign consent through and which
 *      carries the site's banner as its fallback, and `media`, where a variant's own picture
 *      renders when the owner has produced one (G2.2, G2.3, G2.5).
 *
 * Nothing in this file fetches anything at build time: the site is built from the files in
 * this repository, with no network and no clock (Global Constraints 4 and 5).
 */
import { loadSite } from '../content.ts'
import ConsentBanner from '../components/ConsentBanner.astro'
import { CONSENT_KEY } from '../lib/consent-key.mjs'

// The design tokens (W1.2), then the page chrome and element defaults that apply them.
//
// The order is the point: `tokens.css` declares the vocabulary (and imports the palette in
// force), and `base.css` paints the document with it — the ground, the text, the type, the
// header, the nav, the footer, links, code and tables. Before `base.css` existed the tokens
// were in every built page and nothing used them, so the browser's white page and serif
// text showed through. Both are plain static imports: Astro bundles them into the page.
import '../styles/tokens.css'
import '../styles/base.css'

interface Props {
  /** The page's `<title>` suffix and its `og:title`: the page names itself. */
  title: string
  /** The page's description, when the subline is not the right one. */
  description?: string
  /**
   * Offer the analytics choice even when a decision is already stored. The privacy page sets
   * it, because the page that says how consent is withdrawn is the page where it has to be
   * withdrawable (W1.12, D93).
   */
  alwaysOffer?: boolean
  /**
   * Render the page as a campaign page (go-to-market plan, Task G2.2): one of the four landing
   * pages `/save`, `/control`, `/scale` and `/crew` builds, which are the site's one kind of
   * page that is not a page of the site. See the block under the chrome below.
   */
  campaign?: boolean
}

const { title, description, alwaysOffer = false, campaign = false } = Astro.props

// The whole generated layer, read and validated. A missing file, a file whose generated
// header is gone, a data file this reader does not understand: the build stops here, with
// the file's name in the message, before a page renders anything (step 2).
const site = loadSite()
const facts = site.facts

// The site's name, as README.md's title writes it. It is the `<title>`'s prefix and the
// footer's wordmark, and it is not the tagline: the tagline is a sentence, and this is a
// word.
const SITE_NAME = 'Fugaro'

// The footer's link to the repository, labelled with the repository's own name rather than
// with its address (review round 5: the raw URL as link text ran the width of the footer's
// first column and read as a fact about the address, next to labels that are three words
// long). The label is **derived from `site.yaml`'s URL**, not written here: `owner/name` is
// the last two segments of it, so a repository that moved would move its own label with it,
// and this file still holds no fact the data file does not.
const REPOSITORY_LABEL = new URL(facts.repository).pathname.replace(/^\/+|\/+$/g, '') || facts.repository

// The `<title>`, and the two card titles with it. The homepage is the one page whose title
// is the promise rather than a section's name — there is no section to name, the page IS
// the headline — so it carries the site's name and the headline, and the changes spec's
// item 2 puts the headline there (the home hero, the `<title>`, the cards). Every other
// page names itself, and the site's name is the suffix: `Getting started · Fugaro`.
//
// A campaign page's title is the promise too (G2.2): the page is one variant's message and
// nothing else, and the headline the page passes as its `title` is a sentence — the same shape
// the homepage's title is in, which is why the two are composed the same way.
const pageTitle = campaign ? `${SITE_NAME} — ${title}` : title === SITE_NAME ? `${SITE_NAME} — ${site.tagline}` : `${title} · ${SITE_NAME}`

// The description is README.md's subline — the one sentence under the tagline — unless the
// page names its own. The subline and not the tagline: a description is a sentence about
// what the product is, which is what the subline is, and the headline is four words with
// no verb in them (changes spec item 2).
const pageDescription = description ?? site.subline

// The canonical URL: the origin from site.yaml and the path of the page being built.
// `Astro.url` carries the build's own origin — the dev server's `localhost` address,
// because the config declares no `site` — so the page's path is taken from it and the
// origin is not: the one absolute origin the layout knows is the fact in site.yaml, and
// `website/test/layout.mjs` holds it to that (step 1).
//
// **A campaign page is canonical to the home page, and it is the one page whose canonical is
// not its own address** (spec §6, F14): the four pages are four phrasings of the home page's
// promise, built for paid traffic rather than for a search result, and a canonical to itself
// would be four pages competing with each other and with the site's own page for one query.
// So the canonical is the origin alone, and the `noindex` in the head below says the same
// thing to a crawler that reads no canonical.
const pagePath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`
const canonicalHref = campaign ? new URL('/', facts.canonicalURL).href : new URL(pagePath, facts.canonicalURL).href
const ogImageHref = new URL('/og-image.png', facts.canonicalURL).href

// The sitemap hint, emitted only when the build actually produces a sitemap. No Part 1
// task adds the integration that writes one, so today this renders nothing: a `<link>` to
// a file the build does not produce is the same defect as a download link to a release
// that does not exist (Global Constraint 9), and the same rule applies to the OpenGraph
// image, which is why the tags below carry none until the site ships one.
const sitemapHref = site.sitemapHref

// The self-hosted fonts the artifact ships (D106). Nothing is preloaded that this build
// does not put in `dist/`: a preload is a request the browser makes before it has parsed
// the page, and one aimed at a file that is not there is a request for nothing.
const fonts = site.fonts

// The sections of the site, in two groups (P3's menu, D182, **with the Reference group dropped
// by the owner's feedback of 2026-10-21**: "let's drop the top reference menu. We'll move the
// submenu console under product, and the rest go under Project"). The routes are the ones the
// plan's page list fixes (how-it-works, why-gcp, getting-started, caps-and-costs, console,
// mobile, docs, security, changelog, faq, community) and each label is the route's own words
// rather than a copy of a page's title — a nav that restated the pages would be a second copy
// of them to keep in step. The groups' five-and-six split is the feedback's, not a symmetry:
// *Product* carries the pages about running the thing the visitor came for (how it works,
// how to start, what it costs, the console and the phone app), and *Project*
// the ones about the project itself, Docs and Changelog included. **Why GCP is a *Project*
// item, after Security** (the owner's explicit approval of 2026-10-23, which moved it out of
// *Product*, where D238 had put it second): it is the argument for the project's one platform,
// beside the page about what that platform's boundary protects. Its label and URL are unchanged.
//
// **Mobile is the sixth of them** (the zoom-diagrams plan §3, Part 3, item 6, with the owner's
// answers of 2026-10-21 under it): the phone app's page is the console page's sister, and
// Console is a Product item, so the new item goes beside it rather than into Project. The two
// groups stay two — the plan's Part 3 asks for one item and not a third group — and
// `website/test/base-styles.mjs`'s `GROUPS_WANTED` is what holds both to that.
//
// **Home is not one of them, and it is in the menu all the same** (the owner's feedback of
// 2026-10-21: "I think we need a 'Home' as the first menu"). D182 took Home out of the menu
// and left the wordmark as the one link to `/`; the feedback puts it back, as the item in
// front of the groups, and the wordmark stays the way home it has always been — the two
// links say the same thing to a reader who reaches for either. `/` is therefore listed twice,
// which is why the current-page mark is not decided here: `isCurrent('/')` marks the menu's
// Home link and nothing else on the page, because a page carries exactly one
// `aria-current="page"` (RF4) and the link a reader looks for in a menu is the one to mark.
const NAV_GROUPS = [
  {
    label: 'Product',
    items: [
      { href: '/how-it-works/', label: 'How it works' },
      { href: '/getting-started/', label: 'Getting started' },
      { href: '/caps-and-costs/', label: 'Caps and costs' },
      { href: '/console/', label: 'Console' },
      { href: '/mobile/', label: 'Mobile' },
    ],
  },
  {
    label: 'Project',
    items: [
      { href: '/docs/', label: 'Docs' },
      { href: '/security/', label: 'Security' },
      { href: '/why-gcp/', label: 'Why GCP' },
      { href: '/faq/', label: 'FAQ' },
      { href: '/community/', label: 'Community' },
      { href: '/changelog/', label: 'Changelog' },
    ],
  },
]

// One entry of the menu, by route. It searches the groups — the menu is the only place a
// route and its label are written — and it throws rather than returning nothing, so a footer
// link to a section the menu stopped listing fails the build instead of rendering a bare
// href (W1.7, P3).
function navItem(href: string) {
  const item = NAV_GROUPS.flatMap((group) => group.items).find((entry) => entry.href === href)
  if (!item) throw new Error(`Base.astro: something links ${href}, which the menu's groups do not list`)
  return item
}

// The footer's links into the site: entries of the menu above, picked by route, so a label is
// never written twice — and the privacy statement, which is not a section of the site but the
// page every page owes a reader, and the page where the analytics choice can be taken back
// (W1.12, reconciliation finding 16). Privacy stays a footer link under D182.
const FOOTER_NAV = [...['/security/', '/changelog/'].map(navItem), { href: '/privacy/', label: 'Privacy' }]

// The campaign pages' footer (G2.2, spec §6): the repository, the docs and the privacy
// statement, and nothing else. **The spec's third item is a pricing link and there is none**,
// which is the plan's own ruling: no pricing page exists and pricing is outside this
// repository, so a footer link to it would be a link to nothing (Global Constraint 9). The
// privacy statement stays where every page's does, because it is the page where the analytics
// choice is taken back and the banner on the page links it (W1.12) — and the docs link is the
// site's own Docs item, read from the menu above rather than written here a second time.
const CAMPAIGN_FOOTER_NAV = [navItem('/docs/'), { href: '/privacy/', label: 'Privacy' }]

// Whether a route is the page being built, for the one `aria-current="page"` a page carries:
// the menu's own link to it on every page the menu lists, which is every page of the site
// since the owner's feedback of 2026-10-21 put Home back in the menu (P3, RF4). The wordmark
// carries no mark of its own any more: it links the same route the menu's first item links,
// and two marks on the home page would be two claims about which page is being read.
const isCurrent = (href: string) => pagePath === href

// Analytics (D93, D106; the owner's ruling of 2026-10-18 in the amendment under plan Task
// W3.2). The origin is written here rather than added to `site.yaml`'s `allowed_hosts`,
// because that list is the hosts the site's own pages link to and this one is the single
// third-party exception the owner decided on — admitted by W1.11's origins check as its one
// allowed exception, widened by W1.12 and pinned by the deployed policy's `script-src` in
// `firebase.json`. It reaches the gate through the banner's markup, so nothing under
// `public/scripts/` names a host and a build with the flag off names none at all.
const ANALYTICS_ORIGIN = 'https://www.googletagmanager.com'
const analyticsEnabled = facts.analytics.enabled
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {/* A campaign page is not offered to a crawler (spec §6, F14): it is built for paid
        traffic, it is one of four phrasings of the home page's promise, and an indexed
        campaign page is a page competing with the site's own home page for the same query.
        The canonical below says the same thing to a crawler that reads no `robots` tag, and
        the two are written together because either one alone is a half-stated rule. */}
    {campaign && <meta name="robots" content="noindex" />}

    {/* The canonical URL, composed from site.yaml and the page's own path (step 1). */}
    <link rel="canonical" href={canonicalHref} />

    {sitemapHref && <link rel="sitemap" type="application/xml" href={sitemapHref} />}

    {/* OpenGraph and Twitter cards, from the same facts as the tags above. The card's
        picture is public/og-image.png (1200x630: the logo, the tagline and the subline),
        a file this site ships, named by an absolute URL because a card reader fetches it
        from outside the page. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageHref} />

    {/* The icons and the manifest, all derived from brand/fugaro-logo.png by
        scripts/gen-brand-icons.py and served from public/, so no icon is fetched from
        anywhere but this site (D106). */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {fonts.map((font) => (
      <link rel="preload" as="font" type={font.type} href={font.href} crossorigin />
    ))}

    <style is:global>
      /* The reduced-motion base (step 3, D105).
         One rule, over everything, so that a component written later cannot forget it: a
         visitor whose system asks for less motion gets the end state of every animation and
         transition on the page immediately, rather than having to be given a second
         reduced-motion stylesheet by each component's author. The durations are 1ms rather
         than 0 because a zero-duration animation with `fill-mode: both` still fires its end
         state, and 1ms keeps `animationend` and `transitionend` listeners working, so a
         component that reveals something over time still lands on its finished frame. */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 1ms !important;
          animation-delay: 0ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 1ms !important;
          transition-delay: 0ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* The layout's own box, kept to the minimum a page needs to be a page: a document
         that fills the viewport and a main region that grows. The design itself is W1.2's
         tokens and the pages' own styles. */
      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
      }

      /* The skip link, hidden until it is focused: the first thing a keyboard reaches on
         every page is the way past the navigation (W1.11 checks the site's anchors). Its
         layer is the chrome's, above the header it skips past (tokens.css names the scale):
         the header has a layer of its own now, so a skip link without one would be drawn
         under the row it is about to skip. */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: var(--z-chrome);
      }

      .skip-link:focus {
        left: 0;
        padding: 0.5rem 1rem;
        background: Canvas;
        color: CanvasText;
      }

      /* The campaign chrome (G2.2, spec §6): the wordmark's row and the minimal footer, drawn
         at the frame's own gutter so a campaign page shares the site's left edge at every
         width. The campaign mode is the site's brand with its navigation taken out — the two
         blocks are the site's own boxes with their contents reduced to what the spec keeps,
         the wordmark above and the three footer links below — so the rules live here, where
         the site chrome's rules are, rather than in each page's component.

         **Both classes are declared at more than one width, and the phone is the base.** A
         campaign page is the one page of the site a reader reaches from a phone in a feed, so
         the narrow layout is written down rather than inherited: the wide block below it adds
         the room a desktop has, and the phone block is a `max-width` query of its own rather
         than the absence of the other. */
      .campaign-header,
      .campaign-footer {
        box-sizing: border-box;
        width: 100%;
        padding-inline: var(--frame-gutter);
      }

      .campaign-header {
        display: flex;
        align-items: center;
        padding-block: var(--space-md);
        background: var(--ground);
      }

      .campaign-footer {
        padding-block: var(--space-lg);
      }

      .campaign-footer ul {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs) var(--space-md);
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .campaign-footer a {
        color: var(--text-muted);
        font-size: var(--font-size-sm);
        text-decoration: none;
      }

      .campaign-footer a:hover {
        color: var(--accent-on-dark);
      }

      @media (max-width: 30rem) {
        /* The phone's own block: the footer's three links stand one a line rather than
           wrapping into a ragged row, which is what a 320 px viewport does to a row of a
           repository's name and two labels. */
        .campaign-footer ul {
          flex-direction: column;
          gap: var(--space-2xs);
        }
      }

      @media (min-width: 48rem) {
        /* The wide viewport's: the same two blocks with the room a desktop has, so a campaign
           page at 1280 px is the page with more air rather than a phone layout stretched. */
        .campaign-header {
          padding-block: var(--space-lg);
        }

        .campaign-footer {
          padding-block: var(--space-xl);
        }
      }
    </style>

    {/* The site's one script (D183, P6, W3.2). A file, not an inline block: `firebase.json`'s
        `script-src 'self'` already admits it, so the deployed policy needs no hash for the
        copy control or for the consent gate, and the whole of the site's behaviour is one
        file a reader can read. `defer` puts it after the parse, which is when the blocks it
        drives and the banner it reads its configuration from exist. */}
    <script src="/scripts/site.js" defer></script>

    {/* The banner's early decision (the owner's ruling of 2026-10-23): a few lines, run before
        the page is drawn, that mark `<html>` when the banner is to be shown, so the banner is in
        the page's flow from the first frame and nothing below it moves when it appears. Not
        deferred, on purpose; same origin, so `script-src 'self'` admits it. Rendered only when
        the banner is. */}
    {analyticsEnabled && (
      <script src="/scripts/consent-early.js" data-consent-key={CONSENT_KEY} data-consent-always={alwaysOffer ? 'true' : undefined}></script>
    )}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {/* The consent banner (W1.12, W3.2): the only thing that writes the decision the gate in
        `site.js` reads, and the element the gate reads its configuration from — the property
        id from site.yaml and the one admitted origin above, both as data attributes, so no
        script has to be inline for the gate to know what it gates. It is rendered only when
        analytics are on, so with the flag off there is no banner, no configuration and no
        analytics origin anywhere in the artifact. It sits after the skip link and before the
        header, which is where a keyboard reaches it first. */}
    {/* The campaign mode's own slot for it (G2.2). G2.3 wires the campaign consent — the
        third-party loads the ads bring with them — through this slot; until it does, the site's
        own banner renders in the slot as the fallback, so the page a visitor lands on from an ad
        asks the same question, in the same place, as every other page of the site, and a
        visitor who declines it still has the page's plain booking link. */}
    {campaign ? (
      <slot name="campaign-banner">
        {analyticsEnabled && (
          <ConsentBanner alwaysOffer={alwaysOffer} measurementID={facts.analytics.measurementID} analyticsOrigin={ANALYTICS_ORIGIN} />
        )}
      </slot>
    ) : (
      analyticsEnabled && (
        <ConsentBanner alwaysOffer={alwaysOffer} measurementID={facts.analytics.measurementID} analyticsOrigin={ANALYTICS_ORIGIN} />
      )
    )}

    {campaign ? (
      <header class="campaign-header">
        {/* The way home, and the whole of the campaign chrome: the wordmark the site's own
            header draws, with no menu beside it. A campaign page is one message for one
            audience (spec §6), so the nine sections of the site are not a choice a visitor who
            arrived from an ad is offered — the page's own calls to action are what it asks
            them to do, and the footer carries the three links a reader looks for. */}
        <a class="site-wordmark" href="/" rel="home">
          <img src="/logo.png" alt="" width="47" height="32" decoding="async" /><span class="site-wordmark-name">{SITE_NAME}</span>
        </a>
      </header>
    ) : (
    <header class="site-header">
      {/* The logo is decoration beside the name, so its alt is empty: the link's
          accessible name is the word "Fugaro", said once. The file is 2x the size drawn.
          The link is also a way home — the other is the menu's first item (the owner's
          feedback of 2026-10-21) — and it carries no `aria-current` of its own: the mark is
          on the menu's Home link, so every page still carries exactly one
          `aria-current="page"` (P3, RF4).

          The name is in its own `<span>` because on a phone it is the name — and not the
          group labels beside it — that gives way (the owner's brief of 2026-10-19,
          item 1: the menu's labels stay in the header's row at 375 px, and the wordmark's
          text is hidden below about 380 px, the mark alone standing for the way home).
          `base.css` hides it from the eye and not from a screen reader, so the link keeps
          its name at every width. */}
      <a class="site-wordmark" href="/" rel="home">
        <img src="/logo.png" alt="" width="47" height="32" decoding="async" /><span class="site-wordmark-name">{SITE_NAME}</span>
      </a>

      {/* The menu: the way home and then the site's groups (P3, D182, the Reference group
          dropped by the owner's feedback of 2026-10-21; the owner's feedback of the same day,
          item 2, put Home at the front of it). Home is a plain
          link and not a group — it is one page, and it has nothing under it — and it is drawn
          in the same row as the labels, on a phone and on a wide viewport alike: the
          brief's "first menu" is the first item of the one menu the site has, and the phone
          shows that menu rather than a collapsed version of it (the owner's brief of
          2026-10-19, item 1). The group labels are in the header's one row at every
          width, and each one opens its own panel of links: on a wide viewport a dropdown
          under its label, on a phone a drawer across the header's full width. There is no
          toggle standing in front of the whole menu — the brief of 2026-10-19 took the single
          "Menu" button away, so a phone reaches any section in one tap rather than two.

          Both levels are `<details>`, so both open and close with JavaScript off, need no
          CSP decision and cost nothing of the JavaScript budget; `public/scripts/site.js`
          adds only what `<details>` does not do by itself — Escape and a click outside close
          what is open; on a device whose pointer hovers, a group's submenu opens when the
          pointer arrives at it (the owner's brief of 2026-10-18, item 1); the keyboard's
          focus arriving at a trigger opens its group, so Tab reaches the links inside a
          closed one, while the focus a click or a tap moves opens nothing — the click that
          brought it toggles the group itself; the trigger's `aria-expanded` is kept in step
          with the group; and a close that would strand the reader's focus hands it back to
          the trigger. Two things decide the hover, and the script asks both: `matchMedia` for
          whether the device's pointer hovers at all — watched, not sampled once, so a pointer
          plugged in or taken away after the page loaded is answered too — and the event's own
          pointer, so that a mouse or a pen opens the group and a finger never does, whatever
          the device answers. A tap therefore goes through the click the `<summary>` already
          has, on every device.

          **A group's list is the `<details>`'s own child, and that is the one structural
          decision here.** A closed `<details>` hides its children in a way author CSS cannot
          portably override — the engines that hide them with `display: none` and the ones
          that hide them with `::details-content` need different overrides — so the menu does
          not fight it: `base.css` positions the list (out of the header's flow, so opening
          one never grows the header's one row) and lets the `<details>` decide whether it is
          drawn at all. Nothing has to be shown without an `open` attribute at any width,
          which is what the toggle-and-sibling-panel arrangement used to need, and the drawer
          it belonged to is gone with it.

          The groups share one `name`, which makes them an exclusive set without a line
          of script: opening *Project* closes *Product*, so two panels never hang over each
          other. */}
      <nav class="site-nav" aria-label="Sections">
        <ul class="site-nav-groups">
          <li class="site-nav-home">
            <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
          </li>
          {NAV_GROUPS.map((group) => (
            <li class="site-nav-group">
              <details name="site-nav-group" data-current={group.items.some((item) => isCurrent(item.href)) ? '' : undefined}>
                <summary>{group.label}</summary>
                <ul>
                  {group.items.map((item) => (
                    <li>
                      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    )}

    <main id="main">
      {/* The variant's own picture, when it has one (G2.2): `/crew`'s cat imagery is the owner's
          file and lands here, and a variant that names no image renders nothing in the slot —
          today all four, so the page is complete without the media the owner has not produced
          (F14, G2.5). The slot is inside `main` and ahead of the page's own sections, so the
          image is the first thing a reader meets and the hero's words follow it; nothing is
          drawn around an empty slot. */}
      <slot name="media" />
      <slot />
    </main>

    {campaign ? (
      <footer class="campaign-footer">
        {/* The minimal footer the spec asks for, and the two facts it must carry that the spec
            does not list: the repository, and the privacy statement, which is where consent is
            withdrawn and which the banner on the page links (W1.12, spec §6). It is a `nav`
            with a name, like every other page's footer, so the page has the landmark a screen
            reader lists. */}
        <nav aria-label="Footer">
          <ul>
            <li>
              <a href={facts.repository} rel="noopener">{REPOSITORY_LABEL}</a>
            </li>
            {CAMPAIGN_FOOTER_NAV.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </footer>
    ) : (
    <footer class="site-footer">
      {/* The repository, from site.yaml, and two of the site's own sections from NAV above:
          the security policy and the changelog, the two pages a reader looks for at the foot
          of a project's site. No fact is written here that the layout did not already hold
          (W1.7 links the same repository from the docs hub) — including the link's label,
          which is the repository's own name read off that URL. */}
      <nav aria-label="Footer">
        <ul>
          <li>
            <a href={facts.repository} rel="noopener">{REPOSITORY_LABEL}</a>
          </li>
          {FOOTER_NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </footer>
    )}
  </body>
</html>
