---
/**
 * website/src/layouts/Base.astro — the base layout (website plan, Task W1.3).
 *
 * Every page of the site renders through this file, which is why the four things below
 * are here rather than in each page:
 *
 *   1. **The head's facts.** The canonical URL, the sitemap hint and the OpenGraph tags
 *      are composed from `website/data/site.yaml` — the one absolute origin the site
 *      knows — and never hard-coded, so W2.2's domain change is one line in that file and
 *      a rebuild (D92, step 1). The description is README.md's own tagline line, for the
 *      same reason.
 *   2. **The content pipeline.** `loadSite()` reads every generated file and every fact
 *      the site renders, and throws — naming the file — when one is missing or malformed.
 *      Calling it here means a build that renders a page has checked the whole generated
 *      layer first: there is no build that renders an empty install block or an
 *      ungenerated security page (step 2, the red step this task answers).
 *   3. **The reduced-motion base.** One global rule neutralises the site's animation and
 *      transition durations for a visitor who has asked their system for less motion, and
 *      it is written here rather than in each component so that a new component cannot
 *      forget it (step 3, D105).
 *   4. **The analytics gate.** The loader is emitted only when `site.yaml` says analytics
 *      are on, and even then it fetches nothing until the visitor has consented. The gate,
 *      not the flag, decides (D93, D106) — and W1.12 owns the banner that sets it, and
 *      rewrites this loader with its own tests.
 *
 * Nothing in this file fetches anything at build time: the site is built from the files in
 * this repository, with no network and no clock (Global Constraints 4 and 5).
 */
import { loadSite } from '../content.ts'

// The design tokens (W1.2), then the page chrome and element defaults that apply them.
//
// The order is the point: `tokens.css` declares the vocabulary (and imports the palette in
// force), and `base.css` paints the document with it — the ground, the text, the type, the
// header, the nav, the footer, links, code and tables. Before `base.css` existed the tokens
// were in every built page and nothing used them, so the browser's white page and serif
// text showed through. Both are plain static imports: Astro bundles them into the page.
import '../styles/tokens.css'
import '../styles/base.css'

interface Props {
  /** The page's `<title>` suffix and its `og:title`: the page names itself. */
  title: string
  /** The page's description, when the tagline is not the right one. */
  description?: string
}

const { title, description } = Astro.props

// The whole generated layer, read and validated. A missing file, a file whose generated
// header is gone, a data file this reader does not understand: the build stops here, with
// the file's name in the message, before a page renders anything (step 2).
const site = loadSite()
const facts = site.facts

// The site's name, as README.md's title writes it. It is the `<title>`'s prefix and the
// footer's wordmark, and it is not the tagline: the tagline is a sentence, and this is a
// word.
const SITE_NAME = 'Fugaro'

const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`
const pageDescription = description ?? site.tagline

// The canonical URL: the origin from site.yaml and the path of the page being built.
// `Astro.url` carries the build's own origin — the dev server's `localhost` address,
// because the config declares no `site` — so the page's path is taken from it and the
// origin is not: the one absolute origin the layout knows is the fact in site.yaml, and
// `website/test/layout.mjs` holds it to that (step 1).
const pagePath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`
const canonicalHref = new URL(pagePath, facts.canonicalURL).href

// The sitemap hint, emitted only when the build actually produces a sitemap. No Part 1
// task adds the integration that writes one, so today this renders nothing: a `<link>` to
// a file the build does not produce is the same defect as a download link to a release
// that does not exist (Global Constraint 9), and the same rule applies to the OpenGraph
// image, which is why the tags below carry none until the site ships one.
const sitemapHref = site.sitemapHref

// The self-hosted fonts the artifact ships (D106). Nothing is preloaded that this build
// does not put in `dist/`: a preload is a request the browser makes before it has parsed
// the page, and one aimed at a file that is not there is a request for nothing.
const fonts = site.fonts

// The sections of the site, and the one place they are listed. The routes are the ones the
// plan's page list fixes (index, how-it-works, getting-started, caps-and-costs, console,
// docs, security, changelog, faq, community), and each label is the route's own words
// rather than a copy of a page's title — a nav that restated the pages would be a second
// copy of them to keep in step.
const NAV = [
  { href: '/', label: 'Home' },
  { href: '/how-it-works/', label: 'How it works' },
  { href: '/getting-started/', label: 'Getting started' },
  { href: '/caps-and-costs/', label: 'Caps and costs' },
  { href: '/console/', label: 'Console' },
  { href: '/docs/', label: 'Docs' },
  { href: '/security/', label: 'Security' },
  { href: '/changelog/', label: 'Changelog' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/community/', label: 'Community' },
]

// The footer's links into the site: entries of NAV, picked by route, so a label is never
// written twice.
const FOOTER_NAV = ['/security/', '/changelog/'].map((href) => {
  const item = NAV.find((entry) => entry.href === href)
  if (!item) throw new Error(`Base.astro: the footer links ${href}, which NAV does not list`)
  return item
})

// Analytics (D93): off in site.yaml today, and gated on consent even when it is on. The
// origin is written here rather than added to `site.yaml`'s `allowed_hosts`, because that
// list is the hosts the site's own pages link to and this one is the single third-party
// exception the owner decided on — admitted by W1.11's origins check as its one allowed
// exception and widened by W1.12 (D106, §7's file-conflict note).
const ANALYTICS_ORIGIN = 'https://www.googletagmanager.com'
const ANALYTICS_SCRIPT_PATH = '/gtag/js'
const analyticsEnabled = facts.analytics.enabled

// The consent decision's key. W1.12 owns the banner that writes it, and the loader below
// is deliberately written to read a decision rather than a flag: with the flag on and
// nothing stored, this page fetches nothing.
const CONSENT_KEY = 'fugaro:analytics-consent'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {/* The canonical URL, composed from site.yaml and the page's own path (step 1). */}
    <link rel="canonical" href={canonicalHref} />

    {sitemapHref && <link rel="sitemap" type="application/xml" href={sitemapHref} />}

    {/* OpenGraph and Twitter cards, from the same facts as the tags above. There is no
        og:image: the site ships no image, and a card that points at a file the build does
        not produce is a broken pointer rather than a card. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalHref} />
    <meta name="twitter:card" content="summary" />

    {/* The icons and the manifest, all derived from brand/fugaro-logo.png by
        scripts/gen-brand-icons.py and served from public/, so no icon is fetched from
        anywhere but this site (D106). */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {fonts.map((font) => (
      <link rel="preload" as="font" type={font.type} href={font.href} crossorigin />
    ))}

    <style is:global>
      /* The reduced-motion base (step 3, D105).
         One rule, over everything, so that a component written later cannot forget it: a
         visitor whose system asks for less motion gets the end state of every animation and
         transition on the page immediately, rather than having to be given a second
         reduced-motion stylesheet by each component's author. The durations are 1ms rather
         than 0 because a zero-duration animation with `fill-mode: both` still fires its end
         state, and 1ms keeps `animationend` and `transitionend` listeners working — the
         site's own terminal (W1.4) reaches its finished frame through exactly that. */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 1ms !important;
          animation-delay: 0ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 1ms !important;
          transition-delay: 0ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* The layout's own box, kept to the minimum a page needs to be a page: a document
         that fills the viewport and a main region that grows. The design itself is W1.2's
         tokens and the pages' own styles. */
      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
      }

      /* The skip link, hidden until it is focused: the first thing a keyboard reaches on
         every page is the way past the navigation (W1.11 checks the site's anchors). */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
      }

      .skip-link:focus {
        left: 0;
        padding: 0.5rem 1rem;
        background: Canvas;
        color: CanvasText;
      }
    </style>

    {analyticsEnabled && (
      <script is:inline define:vars={{ measurementID: facts.analytics.measurementID, origin: ANALYTICS_ORIGIN, scriptPath: ANALYTICS_SCRIPT_PATH, consentKey: CONSENT_KEY }}>
        // The analytics gate (D93, D106): nothing is fetched, and nothing is stored, until
        // the visitor has consented. The reasoning is above this element, in the file.
        ;(function () {
          function decide() {
            // Storage the browser refuses is not consent: the loader stays off.
            try {
              return window.localStorage.getItem(consentKey)
            } catch (err) {
              return null
            }
          }

          var loaded = false

          function load() {
            if (loaded) return
            loaded = true
            window.dataLayer = window.dataLayer || []
            function gtag() {
              window.dataLayer.push(arguments)
            }
            gtag('js', new Date())
            gtag('config', measurementID, { anonymize_ip: true })
            var script = document.createElement('script')
            script.async = true
            script.src = origin + scriptPath + '?id=' + encodeURIComponent(measurementID)
            document.head.appendChild(script)
          }

          if (decide() === 'granted') load()
          window.addEventListener('fugaro:consent', function (event) {
            if (event && event.detail && event.detail.analytics === 'granted') load()
          })
        })()
      </script>
    )}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      {/* The logo is decoration beside the name, so its alt is empty: the link's
          accessible name is the word "Fugaro", said once. The file is 2x the size drawn. */}
      <a class="site-wordmark" href="/" rel="home"><img src="/logo.png" alt="" width="47" height="32" decoding="async" />{SITE_NAME}</a>
      <nav class="site-nav" aria-label="Sections">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      {/* The repository, from site.yaml, and two of the site's own sections from NAV above:
          the security policy and the changelog, the two pages a reader looks for at the foot
          of a project's site. No fact is written here that the layout did not already hold
          (W1.7 links the same repository from the docs hub). */}
      <nav aria-label="Footer">
        <ul>
          <li>
            <a href={facts.repository} rel="noopener">{facts.repository}</a>
          </li>
          {FOOTER_NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </footer>
  </body>
</html>
