---
/**
 * website/src/components/Changelog.astro — the release entries (website plan, W1.9).
 *
 * One entry per release, newest first, each one rendered from the lines W0.6's
 * `src/lib/changelog.mjs` read out of `docs/releases/vX.Y.Z.md` at build time, preceded by
 * the summary block the redesign's P4 added (D189; RF24). The component writes nothing of
 * its own: the tag comes from the filename, the bullets and the sections are the file's own
 * lines, and the only words it adds are the summary block's heading and the "not yet
 * released" marker below. Every heading inside an entry is a `###` heading the file itself
 * carries — `### For operators`, `### Known limits` — printed as the heading element it is,
 * so a section the format allows is a section the page renders.
 *
 * Five decisions are worth stating rather than leaving in the code:
 *
 *   1. **No date, and no prose summary.** The release files carry neither a title nor a
 *      date, the site's build is network-free, and the newest entry has no tag to read one
 *      from, so each heading links to its GitHub release — which is where the date is
 *      stated (D100). The page adds no "what's new" prose: the sentence a reader reads is
 *      the file's, and `website/test/changelog-page.mjs` refuses one that is not.
 *   2. **The summary block is the files' lines too** (P4, D189). A reader who lands on a
 *      changelog of thirteen releases wants the gist first, and a summary written here
 *      would be the first sentence on this site that no file backs — so the block shows the
 *      **first Highlights line of the newest few releases**, taken from the entries below
 *      and rendered with the same `inline()`, and `website/test/changelog-page.mjs` pins
 *      each item to the first line of the file its tag names. The block is a gist and not a
 *      second changelog: `SUMMARY_RELEASES` releases, the full list below, and a release
 *      whose file carries no Highlights line stops the build rather than leaving a hole in
 *      the summary (the format requires 3 to 6 bullets, `docs/releases/README.md`).
 *   3. **The file's own line structure is kept.** A line the file writes as a bullet
 *      becomes a list item and any other line becomes a paragraph of its own, so a note
 *      that is prose does not gain a bullet and a list does not lose one.
 *   4. **The file's inline markup is rendered, not printed.** `` `code` `` becomes a
 *      `<code>` element and `**bold**` a `<strong>` one: the markers are markup and not
 *      text, and printing them would put backticks in front of a reader. The files carry
 *      no link, no image and no other construct — the generator hands the lines over as
 *      written — so this is the whole of the inline rendering, and it is applied to text
 *      that is escaped first.
 *   5. **A release with no tag is not a release that happened.** `released` is false where
 *      the checkout the build ran in has no such tag — which is every entry in a shallow
 *      checkout, and the newest entry everywhere, because a Highlights file is committed
 *      to `main` before its tag exists. The entry says so rather than reading as shipped.
 */

/**
 * One section of a release file's body, as W0.6's generator returns it: a `###` heading the
 * format names (`### For operators`, `### Known limits`), its words a title, and the lines
 * under it verbatim. The two headings are the same kind of thing, so a release carries a
 * list of these rather than a field per heading, and a third one later is a room in the list
 * rather than a fourth branch here.
 */
interface Section {
  /** The heading's own words, with the `###` left behind: `For operators`, `Known limits`. */
  title: string
  /** The lines under the heading, verbatim. */
  lines: string[]
}

/** One release, as W0.6's generator returns it: the file's own text and nothing else. */
interface Entry {
  /** The tag, from the filename: `vX.Y.Z`. */
  tag: string
  /** The tag without its `v`, which is the version the filename carries. */
  version: string
  /** True only where the checkout the build ran in has this tag. */
  released: boolean
  /** The file's lines before its first section heading, verbatim. */
  highlights: string[]
  /** Every section the file writes after them, in the file's own order. */
  sections: Section[]
}

interface Props {
  entries: Entry[]
  /**
   * The repository every entry links its GitHub release at: site.yaml's own fact (W0.2),
   * so the page builds the URL and never types it.
   */
  repository: string
}

const { entries, repository } = Astro.props

/** One element of an entry's body, in the order the file writes it. */
type Element = { kind: 'list'; items: string[] } | { kind: 'paragraph'; text: string } | { kind: 'heading'; text: string }

/**
 * The text of a line, escaped for HTML. The release notes carry `<` in their own prose
 * (`fugaro init --firebase <firebase-project-id>`, `--repo <owner/name>`), which is text
 * to a reader and must not become an element in the page.
 */
function escapeHTML(text: string): string {
  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
}

/**
 * The file's inline markup, rendered: `code` as `<code>`, **bold** as `<strong>`. The
 * text is escaped before the markers are turned into elements, so a `<` in a code span
 * stays a `<`.
 */
function inline(text: string): string {
  return escapeHTML(text)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
}

/**
 * The lines as the elements a reader sees: consecutive bullets become one list, and every
 * other line is a paragraph of its own, with the bullet marker left to the list that
 * renders it and everything else kept as written (an operator step's own `1.`, for one).
 */
function elements(lines: string[]): Element[] {
  const out: Element[] = []
  for (const line of lines) {
    const bullet = /^[-*]\s+(.*)$/.exec(line)
    if (bullet !== null) {
      const last = out[out.length - 1]
      if (last !== undefined && last.kind === 'list') last.items.push(bullet[1])
      else out.push({ kind: 'list', items: [bullet[1]] })
      continue
    }
    out.push({ kind: 'paragraph', text: line })
  }
  return out
}

/**
 * An entry's whole body: its highlights, then each section the file writes — the operator
 * steps, the release's known limits — as its own heading with its lines under it, in the
 * order the file writes them. The heading's words are the file's own, printed as the
 * heading element they are; the file's order is kept rather than the format's, so a page
 * never reorders what its source said.
 */
function body(entry: Entry): Element[] {
  const out = elements(entry.highlights)
  for (const section of entry.sections) {
    out.push({ kind: 'heading', text: section.title })
    out.push(...elements(section.lines))
  }
  return out
}

/**
 * How many releases the summary block above the list shows (P4, D189). A summary is a gist,
 * and the newest three releases are what a reader who has been away needs; the full list is
 * the next scroll, so nothing is hidden by the number. A repository with fewer releases than
 * this summarises all of them, which is the honest rendering of a short changelog.
 */
const SUMMARY_RELEASES = 3

/**
 * The summary block's items: the newest releases, each with the first line of its own
 * Highlights, read out of the entry the generator returned and never rewritten. The bullet
 * marker goes the way it goes in the list below — a list renders the marker for itself, and
 * a summary line is a line rather than a list of one. A file with no Highlights line stops
 * the build rather than leaving a hole in the block: `docs/releases/README.md` requires 3 to
 * 6 bullets, so a release file with none has nothing to summarise.
 */
const summary = entries.slice(0, SUMMARY_RELEASES).map((entry) => {
  const first = entry.highlights[0]
  if (first === undefined) {
    throw new Error(
      `docs/releases/${entry.tag}.md carries no Highlights line, and the changelog's summary block renders the newest releases' first one: docs/releases/README.md requires 3 to 6 bullets, so a release file with none has nothing to summarise (P4, D189).`,
    )
  }
  return { tag: entry.tag, line: /^[-*]\s+(.*)$/.exec(first)?.[1] ?? first }
})
---

<div class="changelog">
  {/* The summary block (P4, D189; RF24): the newest releases' first Highlights line, above
      the full list. It is a block of the page's own — its heading names what it is, and
      nothing in it says anything about a release that the release's file does not say. The
      tag links to the entry below rather than to GitHub: the reader is already on this page,
      and the entry is the thing the summary is a gist of. The item's own text is split into
      two elements on purpose — a tag and a line, never one string — so the tag a reader
      reads stays a tag and the line stays the file's line. */}
  <section class="summary">
    <h2 class="summary-heading">The newest releases</h2>
    {summary.map((item) => (
      <div class="summary-release" data-summary-release={item.tag}>
        <p class="summary-tag">
          <a href={`#${item.tag}`}>{item.tag}</a>
        </p>
        <p class="summary-line" set:html={inline(item.line)}></p>
      </div>
    ))}
  </section>

  {entries.map((entry) => (
    <article class="release">
      {/* The tag is the entry's own heading and its anchor, and it links to the GitHub
          release: the one place a date and the artifacts are stated (D100). */}
      <h2 id={entry.tag}>
        <a href={`${repository}/releases/tag/${entry.tag}`} rel="noopener">{entry.tag}</a>
      </h2>

      {/* Not a release that happened: the file is on main, its tag is not in the checkout
          the build ran in (D100). */}
      {!entry.released && <p class="release-status" data-status="not-yet-released">not yet released</p>}

      {body(entry).map((element) =>
        element.kind === 'list' ? (
          <ul>
            {element.items.map((item) => (
              <li set:html={inline(item)}></li>
            ))}
          </ul>
        ) : element.kind === 'heading' ? (
          <h3>{element.text}</h3>
        ) : (
          <p set:html={inline(element.text)}></p>
        ),
      )}
    </article>
  ))}
</div>

<style>
  /* The page's own shape, and nothing else: the spacing, the type scale and the measure
     come from W1.2's tokens, and this component names **no colour** — the palette layer
     paints the site, and a colour chosen here would be a second copy of it that the
     contrast check cannot see. A declaration whose token is not in the build (the styles
     land in W1.2, which the shell reads) resolves to nothing rather than to a value this
     file invented. */
  .changelog {
    max-width: var(--measure);
  }

  /* The summary block: the newest releases' first lines, set apart from the list below by a
     border and the muted type of a gist rather than by a colour of its own. */
  .summary {
    border-bottom: var(--border-width) solid var(--border);
    padding-block: var(--space-md) var(--space-lg);
  }

  .summary-heading {
    margin: 0;
    font-size: var(--font-size-base);
    color: var(--text-muted);
  }

  .summary-release {
    margin-block-start: var(--space-sm);
  }

  .summary-tag {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: var(--leading-tight);
  }

  .summary-line {
    margin: var(--space-3xs) 0 0;
    line-height: var(--leading-normal);
  }

  .release {
    padding-block: var(--space-lg);
  }

  .release h2 {
    margin: 0;
    font-size: var(--font-size-xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .release h3 {
    margin-block: var(--space-md) var(--space-2xs);
    font-size: var(--font-size-base);
  }

  .release-status {
    margin-block: var(--space-2xs) 0;
    font-size: var(--font-size-sm);
  }

  .release ul {
    padding-inline-start: var(--space-md);
  }

  .release li,
  .release p {
    line-height: var(--leading-normal);
  }
</style>
