---
/**
 * website/src/components/ArchitectureDiagram.astro — the flow (website plan, Task W1.4
 * step 3; redesign part P8, findings RF12, RF20 and RF21, decision D185).
 *
 * **The brief's four steps, not the first plan's five stages.** The brief draws the run as
 * task submitted -> ephemeral Cloud Run job -> agent runs -> pull request (spec.md item 4),
 * each step one short line; D185 takes it, and so does this component. The two stages the
 * first diagram had that the brief does not name — `cache` and `security boundary` — stay
 * on the page as two annotations of the job step, which is where both of them happen: the
 * container is the trust boundary (design §6.1) and it is what restores the caches
 * (README step 2). "Agent runs" is the step the first five lacked, and README's step 3 is
 * its source.
 *
 * **Every caption is a line the repository already writes.** A step's caption and an
 * annotation's caption each go through `comparable()` below at build time, and the build
 * stops naming the file when one of them is not in the document it cites;
 * `website/test/home.mjs` makes the same check against the built page from outside, and
 * reads the four steps and the two annotations out of D185's own row in
 * `docs/website/redesign/reconciliation.md`. Nothing here is written for the page.
 *
 * **The two names the README does not use.** `cache` and `security boundary` are this
 * page's labels for facts the design and the README state in other words, so they are
 * annotation *names* and never quotations: the test refuses a build in which either name is
 * written as a word of README.md's `## How it works`, and holds each annotation's caption —
 * the quoted half — to the document it cites.
 *
 * **The flow is a list, and its picture is decoration.** The steps are an `<ol>` of
 * headings and captions, which is the whole content, and each step's arrow is an SVG marked
 * `aria-hidden`, because a picture of four boxes and three arrows is not a thing a screen
 * reader should have to describe when the four boxes are right there as text. Nothing about
 * the flow depends on the arrows having been drawn.
 *
 * **The animation.** The steps fade in as the reader scrolls to them, using a scroll-driven
 * animation (`animation-timeline: view()`), which costs no JavaScript at all. It is inside a
 * feature query and a preference query: a browser that cannot run scroll-driven animations,
 * and a reader whose system asks for less motion, both get the flow as it stands — every
 * step visible, nothing moving (W1.4 step 3). The arrows and the annotations are never
 * animated, so the annotated job step reads the same in every case.
 */
import { readFileSync } from 'node:fs'
import path from 'node:path'
import { REPO_ROOT } from '../content.ts'

/**
 * A string with its markdown markers and its whitespace removed: how a caption and the
 * document it claims to come from are compared. Emphasis and code spans are markers rather
 * than text, and where a document breaks a line or pads a column is its layout rather than
 * its words — most of the README's ASCII diagram is padding, so a caption quoted from it is
 * compared with the drawing taken out.
 */
function comparable(document: string): string {
  return document.replace(/[`*]/g, '').replace(/\s+/g, '')
}

/**
 * The documents a caption may come from, by the path each step cites. The README is read
 * whole rather than section by section: the first step's caption is the invocation the
 * README's getting-started block prints, and the rest are lines of its `## How it works`
 * section — one document, and a caption is held to all of it.
 */
const SOURCES: { [file: string]: string } = {
  'README.md': readFileSync(path.join(REPO_ROOT, 'README.md'), 'utf8'),
  'docs/design/v1.md': readFileSync(path.join(REPO_ROOT, 'docs/design/v1.md'), 'utf8'),
}

/**
 * The brief's four steps, in its order, each with the file its caption is a line of. The
 * job step carries the two annotations, in the order the brief names them. `source` is
 * checked below rather than trusted: a caption that is a paraphrase of the document fails
 * the build instead of shipping as a quotation (Global Constraint 6).
 */
const STEPS = [
  {
    name: 'task submitted',
    source: 'README.md',
    // README.md's getting-started block: the command a person runs to hand Fugaro a task,
    // and the same line Terminal.astro types in the hero.
    caption: 'fugaro run "add a --verbose flag to the export command"',
    command: true,
  },
  {
    name: 'ephemeral Cloud Run job',
    source: 'README.md',
    // README.md's ASCII diagram: the far end of the CLI's arrow, in its own words.
    caption: 'one execution per task, then gone',
    annotations: [
      {
        name: 'cache',
        source: 'README.md',
        // Step 2 of the README's numbered steps, which is what the label names.
        caption: 'Sync to the exact target commit and restore the dependency caches.',
      },
      {
        name: 'security boundary',
        source: 'docs/design/v1.md',
        // v1.md §6.1, opening sentence: the sentence the label is named after.
        caption: 'The trust boundary is the container, not the process.',
      },
    ],
  },
  {
    name: 'agent runs',
    source: 'README.md',
    // Step 3's opening clause: what the container is doing while it is alive.
    caption: 'Claude Code implements, writes tests, runs the build and tests',
  },
  {
    name: 'pull request',
    source: 'README.md',
    // Step 4's first words, which is the brief's fourth step in the README's own voice.
    caption: 'Push and open the pull request',
  },
]

// Hold every caption — a step's and an annotation's — to the document it cites, here, so a
// paraphrase stops the build with the file's name in the message rather than reaching a
// reader as the repository's words.
const CAPTIONS = STEPS.flatMap((step) => [step, ...(step.annotations ?? [])])
for (const caption of CAPTIONS) {
  const source = SOURCES[caption.source]
  if (!source || !comparable(source).includes(comparable(caption.caption))) {
    throw new Error(
      `website/src/components/ArchitectureDiagram.astro: the ${caption.name} caption ${JSON.stringify(caption.caption)} is not a line of ${caption.source}, and every caption in the flow is the repository's own words rather than one written for the page (P8, D185).`,
    )
  }
}

/** A step's name as a heading: the brief writes the four lowercase, a heading does not. */
function title(name: string): string {
  return name[0].toUpperCase() + name.slice(1)
}
---

<figure class="flow" aria-label="How a task becomes a pull request" data-source="docs/website/redesign/reconciliation.md">
  <ol class="flow-steps">
    {
      STEPS.map((step, index) => (
        <li class="flow-step" data-step={step.name} data-source={step.source}>
          <div class="step-card">
            <div class="step-head">
              {/* The step's place in the flow, as a number: the list carries the order, so
                  this is decoration and a screen reader reads the `<ol>` instead. */}
              <span class="step-number" aria-hidden="true">{index + 1}</span>
              <h2 class="step-name">{title(step.name)}</h2>
            </div>
            <p class="step-caption">
              {step.command ? <code class="step-command">{step.caption}</code> : step.caption}
            </p>
            {step.annotations && (
              <ul class="step-annotations">
                {step.annotations.map((annotation) => (
                  <li class="annotation" data-annotation={annotation.name} data-source={annotation.source}>
                    <span class="annotation-name">{annotation.name}</span>
                    <span class="annotation-caption">{annotation.caption}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
          {/* The arrow between this step and the next: decoration, and the last step has
              none. It is inside the step rather than between two of them because a list of
              steps may not carry anything but steps. */}
          {index < STEPS.length - 1 && (
            <svg class="step-arrow" viewBox="0 0 24 32" aria-hidden="true" focusable="false">
              <path class="arrow-line" d="M12 1 V 25" />
              <path class="arrow-head" d="M4 19 L12 29 L20 19" />
            </svg>
          )}
        </li>
      ))
    }
  </ol>
</figure>

<style>
  /* Tokens only (W1.2): the flow's boxes, its numbers and its arrows are named through the
     palette rather than given colours of their own. */
  .flow {
    margin: 0;
    max-width: var(--page-max);
  }

  .flow-steps {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow-step {
    max-width: var(--measure);
  }

  .step-card {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-md);
    border: var(--border-width) solid var(--border);
    border-left-width: calc(var(--border-width) * 4);
    border-radius: var(--radius-md);
    background: var(--ground);
  }

  .step-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .step-number {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--text-muted);
  }

  .step-name {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
  }

  .step-caption {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);
    /* The first step's caption is a command, and a command is one unbroken word to a
       renderer: at 390 px it has to be allowed to break rather than push the card wider. */
    overflow-wrap: anywhere;
  }

  .step-command {
    font-family: var(--font-mono);
    color: var(--text);
  }

  .step-annotations {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: var(--space-2xs) 0 0;
    padding: 0;
    list-style: none;
  }

  .annotation {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding: var(--space-3xs) var(--space-xs);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: var(--font-size-xs);
    line-height: var(--leading-normal);
  }

  .annotation-name {
    font-family: var(--font-mono);
    color: var(--text);
  }

  .annotation-caption {
    color: var(--text-muted);
  }

  .step-arrow {
    display: block;
    width: 1.5rem;
    height: 2rem;
    margin: var(--space-2xs) auto;
  }

  .arrow-line,
  .arrow-head {
    fill: none;
    stroke: var(--border);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The reveal, as the reader scrolls to each step: a scroll-driven animation, which is a
     timeline the browser drives and not a script the page ships. Guarded twice — once for a
     browser that cannot run it, once for a reader who asked for less motion — so that in
     both of those cases the flow is simply there, in full, with nothing moving. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      @keyframes step-in {
        from {
          opacity: 0;
          transform: translateY(var(--space-xs));
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      .flow-step {
        animation: step-in linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 40%;
      }
    }
  }
</style>
