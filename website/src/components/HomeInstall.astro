---
/**
 * website/src/components/HomeInstall.astro — the homepage's install paths (website plan, Task
 * W1.4 step 1; changes spec of 2026-10-18, items 3 and 4).
 *
 * **The commands are `website/data/install.yaml`'s commands**, rendered from the file rather
 * than copied out of it (W0.1, W1.4 step 1). Each path also renders the note that file
 * carries, so the development-only path says so where it is offered.
 *
 * **Why it is not in the hero any more.** The hero used to carry the promise, the install
 * commands and the chat, and item 4 asks for the run's picture to be the thing under the
 * promise rather than the fourth block down: the homepage is now the promise and its call to
 * action, the chat, the diagram, and then this — the commands, for the reader who has read
 * what Fugaro is and decided. It sits below the diagram and it is the page's last section, and
 * the quietest of the three: smaller type, one step of border, no accent of its own, so the
 * loudest thing on the page stays the diagram (spec item 4's acceptance). The order is the
 * built `dist/index.html`'s — `index.astro` renders Hero, then `.home-chat`, then `.home-flow`,
 * then this component; review round 5 moved the chat above the diagram, which is the reverse of
 * the order the earlier rounds recorded.
 *
 * **The commands wrap rather than being cut off.** The two paths share a row of about 22 rem
 * each, and `go install github.com/dimipaun/fugaro/cmd/fugaro@latest` is wider than that at
 * the size a command is set: with `overflow-x: auto` alone the line was silently clipped at
 * the card's edge (`…@late`), which is a command a reader cannot read and cannot see is
 * incomplete. A command block's `pre` wraps its command instead — `white-space: pre-wrap` with
 * `overflow-wrap: anywhere`, so a long token breaks rather than running out of the card — and
 * `website/test/base-styles.mjs` refuses a command block whose rule clips one. The wrapping is
 * declared once, on `base.css`'s `.command-block > pre`, rather than here: the control sits in
 * the command's own row, so every command on the site gives up the control's width, and this
 * component's own rule would have reached only this page's two.
 */
import { loadSite } from '../content.ts'
import { copyControlHTML } from '../lib/copy-control.mjs'

const site = loadSite()
const install = site.install

// The two install paths the homepage shows: the two that install the CLI with a command. The
// archive and the cosign block are on the getting-started page, where their notes have room
// (W1.5) and where a reader who has decided to install goes.
const HOME_PATHS = ['homebrew', 'go-install']
const paths = HOME_PATHS.map((id) => {
  const found = install.paths.find((candidate) => candidate.id === id)
  if (!found) {
    // The pipeline validated the file; this is the other failure, and it is this component's
    // own: the paths named above are the ones this page renders, and one of them is gone.
    throw new Error(
      `website/src/components/HomeInstall.astro: website/data/install.yaml carries no install path with id "${id}", which the homepage renders`,
    )
  }
  return found
})
---

<section class="home-install" aria-labelledby="home-install-title" data-source="website/data/install.yaml">
  {/* A section heading, and a real one: it is what ends the page's lead at the promise and
      what a reader navigating by headings lands on. It is set larger than a label (the
      review's nit: the section's own name was the smallest type in the block it named) and
      still quieter than the diagram's step names. */}
  <h2 class="home-install-title" id="home-install-title">Install</h2>

  <div class="home-install-paths">
    {
      paths.map((path) => (
        <div class="home-install-path" data-path={path.id} data-source={path.source}>
          <p class="home-install-name">{path.name}</p>
          {/* Written on one line: whitespace inside `<pre>` is shown, so an indented
              template would indent the command on the page. The control beside it is
              `src/lib/copy-control.mjs`'s markup, emitted `hidden` and revealed by the
              site's script (P6, D183). */}
          {path.commands.map((command) => (
            <div class="command-block" data-copy>
              <Fragment set:html={copyControlHTML('Copy the install command')} />
              <pre class="home-install-command"><code>{command}</code></pre>
            </div>
          ))}
          {path.note && <p class="home-install-note">{path.note}</p>}
        </div>
      ))
    }
  </div>

  <p class="home-install-more">
    <a href="/getting-started/">Every install path, and what each one sets up</a>
  </p>
</section>

<style>
  /* Tokens only (W1.2), and no colour of this component's own: the accent is the diagram's
     and the chat's, and this block is deliberately the quietest of the three.

     **No top padding, because the block above already carries the gap** (review round 5).
     Every top-level block on this page carries the gutter and the room below itself — the
     hero's `--space-lg`, the two figures' `--space-3xl` — and the install paths are the last
     of them, so a top padding here was a second gap stacked on the figure's: 7 rem plus this
     2 rem was the 144 px band the review of the built site measured as empty page between the
     flow's cards and the "Install" heading, the block above the heading being where the room
     belonged. The bottom stays: it is the page's own tail, the same 7 rem between the last
     line of prose and the footer. */
  .home-install {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-md) var(--space-3xl);
  }

  .home-install-title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
  }

  .home-install-paths {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  /* A 22 rem basis rather than a share of the row: two of them fit the page's 72 rem column
     with room for the gutter between, and a card that cannot hold the `go install` line
     wraps it rather than clipping it (see the header). */
  .home-install-path {
    flex: 1 1 22rem;
    padding: var(--space-sm);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--ground);
  }

  .home-install-name {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
  }

  /* The command's own look. What it does *not* do here is decide that the command wraps: the
     copy control sits in the command's row, so every command block's `pre` gives up the
     control's width, and `base.css`'s `.command-block > pre` is where the wrapping is declared
     — for this page's commands and for Getting Started's, which this rule never reached
     (review of this branch). One rule, one place, and `website/test/base-styles.mjs`'s
     `installCommandFailures` reads that selector as well as this class. */
  .home-install-command {
    margin: 0;
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .home-install-note {
    margin: var(--space-2xs) 0 0;
    font-size: var(--font-size-xs);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .home-install-more {
    margin: var(--space-sm) 0 0;
    font-size: var(--font-size-sm);
  }
</style>
