---
/**
 * website/src/components/HomeInstall.astro — the homepage's closing call to action and the
 * command under it (the owner's approved board `website/design-ref/HomeV3.dc.html`, 2026-10-20;
 * redesign part P1; the draft "Home, draft 2 (slider)", 2026-10-19).
 *
 * **One button, one command.** The page used to end with two install cards — Homebrew and
 * `go install` — each with its own command, its own copy control and its own note, which is a
 * reader choosing between two ways to install something before they have decided to install
 * it. The draft replaces the pair with the thing a reader does next: one large "Get started"
 * button at `/getting-started/`, where every path is laid out with what each one sets up, and
 * the command most readers run under it.
 *
 * **The board draws the block as a panel** — a box with the accent's hairline, a wash of the
 * panel tones and the site's largest radius — and that is what this component draws: the
 * heading, the command a reader copies, the file's own note about what the path sets up, and
 * the button. The heading is the board's line ("Ship your first run") and is listed in the
 * pull request for the owner to veto; the command and the note are the site's own data.
 *
 * **The command is `website/data/install.yaml`'s**, rendered from the file rather than copied
 * out of it (W0.1, W1.4 step 1), and so is the note under it: a command typed into this
 * component is a second copy of the install text, and the one that drifts. The path it renders
 * is `HOME_PATH` below — the tap the README documents first — and a path missing from the file
 * stops the build here, naming itself.
 *
 * **The `go install` path is not on this page any more.** It is a development build with no
 * release images and no plugin pin (README.md says so), so it is a path for somebody working on
 * Fugaro rather than for a reader arriving at the site; `/getting-started/` still carries it,
 * with the note that says what it is for.
 *
 * **One link, and it is the button.** `website/test/home.mjs` reads this block's links out of
 * the built page and holds it to the draft's one: a second link here — the `go install` card's,
 * or a release page's — is the choice the draft takes off this page.
 */
import { loadSite } from '../content.ts'
import { copyControlHTML } from '../lib/copy-control.mjs'

const site = loadSite()
const install = site.install

// The one install path the homepage offers: the quick path, the one the README's
// "## Getting started" prints first, and the one whose command a reader can run as it stands.
const HOME_PATH = 'homebrew'
const path_ = install.paths.find((candidate) => candidate.id === HOME_PATH)
if (!path_) {
  // The pipeline validated the file; this is the other failure, and it is this component's own:
  // the path named above is the one this page renders, and it is gone.
  throw new Error(
    `website/src/components/HomeInstall.astro: website/data/install.yaml carries no install path with id "${HOME_PATH}", which the homepage's call to action offers`,
  )
}
const command = path_.commands[0]
---

<section class="home-install" aria-labelledby="home-install-title" data-source="website/data/install.yaml">
  <div class="home-install-panel">
    {/* The block's own name, and the board's line: what a reader does next. It is the heading
        a reader navigating by headings lands on, and the button below it is the same
        instruction as a control. */}
    <h2 class="home-install-title display-md" id="home-install-title">Ship your first run</h2>

    {/* Written on one line: whitespace inside `<pre>` is shown, so an indented template would
        indent the command on the page. The control beside it is `src/lib/copy-control.mjs`'s
        markup, emitted `hidden` and revealed by the site's script (P6, D183) — and it is a
        `<button>`, not a link, which is what keeps this block's one link the button below. */}
    <div class="command-block" data-copy>
      <Fragment set:html={copyControlHTML('Copy the install command')} />
      <pre class="home-install-command"><code>{command}</code></pre>
    </div>

    {path_.note && <p class="home-install-note">{path_.note}</p>}

    {/* The one call to action: filled with the accent, the same pair the hero's own primary
        link is set in, and larger than it — this is the page's last word on what to do, and
        the reader who has read the slider is the reader it is for. */}
    <p class="home-install-cta">
      <a class="home-install-button" href="/getting-started/">Get started</a>
    </p>
  </div>
</section>

<style>
  /* Tokens only (W1.2), and no colour of this component's own: the accent is the page's, and
     the button is the second place it is used as a fill (the hero's call to action is the
     first, and `a11y.mjs` computes that pair at 4.5:1).

     **No top padding, because the block above already carries the gap**: every top-level block
     on this page carries the gutter and the room below itself, so a top padding here would be a
     second gap stacked on the grid's (`website/test/base-styles.mjs`'s `homeRhythmFailures`
     refuses exactly that). The bottom stays: it is the page's own tail, the same room between
     the last line of prose and the footer. */
  .home-install {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-md) var(--space-3xl);
  }

  /* The panel: the board's box around the whole block. The hairline is the accent's, because
     this is the page's last word and the one box on it that is a call to action rather than a
     section; the wash behind it is a gradient of palette tones in `background-image` (a colour
     function would be a literal no palette holds, and `background` would make the contrast
     check read a gradient as the one colour the text sits on). */
  .home-install-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-2xl) var(--space-lg);
    border: var(--border-width) solid var(--accent);
    border-radius: var(--radius-xl);
    background-image: linear-gradient(120deg, var(--panel) 0%, var(--surface) 60%, var(--panel) 100%);
  }

  .home-install-title {
    margin: 0;
  }

  /* The bar the command sits in, held to the site's measure rather than the page's: one command
     does not need the whole page, and a bar that spanned it would read as a band across the
     foot of the page rather than as a command a reader copies. */
  .home-install .command-block {
    width: 100%;
    max-width: var(--measure);
  }

  /* The command's own look. What it does *not* do here is decide that the command wraps:
     `base.css`'s `.command-block > pre` is where the wrapping is declared, for this page's
     command and for every other command on the site. */
  .home-install-command {
    margin: 0;
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-md);
    background: var(--ground);
    color: var(--accent-on-dark);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .home-install-note {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .home-install-cta {
    margin: var(--space-2xs) 0 0;
  }

  /* The button, at the size the board asks for: the site's own filled primary, one step up in
     type and in padding from the hero's, and a target well over the 44 px the owner's brief
     measures every control against. `display: inline-flex` rather than `inline-block` so the
     label is centred in the box it makes, and `text-decoration: none` because it is a button
     rather than a link in running text. */
  .home-install-button {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding: 0 var(--space-xl);
    border-radius: var(--radius-lg);
    background: var(--accent);
    color: var(--ground);
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-black);
    text-decoration: none;
  }
</style>
