---
/**
 * website/src/components/HomeWhatYouGet.astro: what a run leaves behind, and where you watch it
 * (the owner's rulings of 2026-10-23, the redesign's Step 3, levers 1, 4 and 8).
 *
 * **Three things a run leaves, every line a line of this repository.** The pull request, the
 * diff and the report with it, and the logs: the sentences are `README.md`'s, quoted through
 * `src/lib/repo-quote.mjs`, which stops the build naming the file when a line is not in the
 * document it cites. The cost and where the agent runs, which this block carried before, moved
 * to the cost section and the "Why Fugaro?" section.
 *
 * **Where you watch them**: the console's real screenshots (`website/data/home-screens.yaml`,
 * the rows other than the `fugaro watch` capture, which the hero shows), the `fugaro watch`
 * command with its copy control, and links to the console and the phone app pages. Lever 8 lets
 * the home page surface Console and Mobile in its content without touching the navigation. The
 * console link is rendered only while `site.yaml`'s `features.console_downloads` is on.
 */
import { readFileSync } from 'node:fs'
import path from 'node:path'
import { REPO_ROOT, loadHomeSliderScreens, loadSite } from '../content.ts'
import { copyControlHTML } from '../lib/copy-control.mjs'
import { holdLabels, section } from '../lib/repo-quote.mjs'
import ScreenshotSlider from './ScreenshotSlider.astro'

const README_WHY = 'README.md#Why Fugaro'
const README_HOW = 'README.md#How it works'
const README_SAFETY = 'README.md#Safety and cost controls'
const GCP_RUN = README_HOW

const SOURCES = {
  [README_WHY]: section('README.md', 'Why Fugaro'),
  [README_HOW]: section('README.md', 'How it works'),
  [README_SAFETY]: section('README.md', 'Safety and cost controls'),
}

const LEAD = {
  text: 'Every run that pushed ends in a pull request, a draft one if it failed.',
  source: GCP_RUN,
}

const ITEMS = [
  {
    name: 'A pull request per task',
    line: {
      text: 'a draft opens at the first push (marked not verified), and it is marked ready only when the run passes',
      source: README_HOW,
    },
  },
  {
    name: 'The diff and the report',
    line: { text: 'with the diff, the report and the logs', source: README_WHY },
  },
  {
    name: 'The logs',
    line: {
      text: "Run logs carry agent output, so by default they go to Fugaro's own log bucket, which only launchers and operators (and the project's owners and editors) can read.",
      source: README_SAFETY,
    },
  },
]

holdLabels({ lead: LEAD, ...Object.fromEntries(ITEMS.map((item) => [item.name, item.line])) }, SOURCES, 'website/src/components/HomeWhatYouGet.astro')

/** The console's screens: the home page's data file, less the terminal capture the hero shows.
 *  The four campaign pages' own slider renders this same list (the owner's feedback of
 *  2026-10-30, D412's finding 3), so the set is `loadHomeSliderScreens()`'s rather than a filter here. */
const SCREENS = loadHomeSliderScreens()

const consoleExists = loadSite().facts.features.consoleDownloads

/** The command and the plugin skill's own line about it (held to the skill below). */
const WATCH = 'fugaro watch'
const WATCH_TAIL = 'is the live screen of spend, repositories and running agents.'
{
  const skill = readFileSync(path.join(REPO_ROOT, 'plugin/skills/working/SKILL.md'), 'utf8').replace(/[`*]/g, '').replace(/\s+/g, ' ')
  if (!skill.includes(`${WATCH} ${WATCH_TAIL}`)) {
    throw new Error(
      `website/src/components/HomeWhatYouGet.astro: plugin/skills/working/SKILL.md no longer says "${WATCH} ${WATCH_TAIL}", and the line under the command is that skill's own (Global Constraint 6).`,
    )
  }
}
---

<section class="home-get" data-reveal-block aria-labelledby="home-get-title">
  <div class="home-get-head">
    <h2 class="home-get-title display-lg" id="home-get-title">Pull requests, not promises</h2>
    <p class="home-get-lead" data-source={LEAD.source}>{LEAD.text}</p>
  </div>

  <ul class="home-get-items">
    {
      ITEMS.map((item) => (
        <li class="home-get-item">
          <h3 class="home-get-name">{item.name}</h3>
          <p class="home-get-line" data-source={item.line.source}>
            {item.line.text}
          </p>
        </li>
      ))
    }
  </ul>

  {/* The console's real screens, in the slider the console page uses: a track that scrolls
      sideways with snap points and dots that are anchors, so it works with no script. */}
  <div class="home-get-show">
  <div class="watch-shot" data-slot="watch-screenshot">
    <ScreenshotSlider
      screens={SCREENS}
      heading="Watch every run"
      slot="home-screens"
      idPrefix="home-screen"
      label="Screenshots of the Fugaro desktop console. Scroll sideways to see the rest."
    />
  </div>

  <div class="home-get-watch">
    <div class="watch-block command-block" data-copy>
      <Fragment set:html={copyControlHTML('Copy the command')} />
      <pre class="watch-command"><code>{WATCH}</code></pre>
    </div>
    <p class="watch-note">
      <code>{WATCH}</code> {WATCH_TAIL}
    </p>
    <p class="home-get-more">
      {consoleExists && <a class="home-get-link" href="/console/">The desktop console</a>}
      <a class="home-get-link" href="/mobile/">The phone app, in progress</a>
    </p>
  </div>
  </div>
</section>

<style>
  /* Tokens only (W1.2). The section carries its gutter and its room below, and no top padding
     (`website/test/base-styles.mjs`'s `homeRhythmFailures`). */
  .home-get {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl) var(--space-2xl);
    padding: 0 var(--frame-gutter) var(--space-4xl);
  }

  .home-get-title {
    margin: 0 0 var(--space-md);
    max-width: 14ch;
  }

  .home-get-lead {
    margin: 0;
    max-width: 30ch;
    color: var(--text);
    font-size: var(--font-size-xl);
    line-height: var(--leading-snug);
  }

  .home-get-items {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-get-name {
    margin: 0 0 var(--space-3xs);
    color: var(--text);
    font-size: var(--font-size-xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .home-get-line {
    margin: 0;
    max-width: 52ch;
    color: var(--text);
    font-size: var(--font-size-lg);
    line-height: var(--leading-normal);
  }

  .home-get-show {
    display: grid;
    gap: var(--space-xl);
  }

  /* The slot the screenshots are in: it draws no box of its own, and while it is empty it is
     not in the page at all (`website/test/base-styles.mjs`'s `watchSlotFailures`). */
  .watch-shot:empty {
    display: none;
  }

  .watch-shot > :global(.screens) {
    margin: 0;
  }

  .home-get-watch {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  .watch-block {
    max-width: 24rem;
  }

  .watch-command {
    margin: 0;
    padding: var(--space-2xs) var(--space-sm);
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--accent-on-dark);
    font-family: var(--font-mono); /* taste-skill-ignore: a real command in <pre><code> */
    font-size: var(--font-size-base);
  }

  .watch-note {
    margin: 0;
    max-width: 40ch;
    color: var(--text);
    font-size: var(--font-size-base);
  }

  .home-get-more {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-lg);
    margin: 0;
  }

  .home-get-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-on-dark);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-semibold);
  }

  /* The wide composition: the heading and the lead on the left, the three things a run leaves
     on the right; then the console's screens across eight columns with the terminal command
     and the two links beside them. */
  @media (min-width: 64rem) {
    .home-get {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .home-get-show {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: var(--space-2xl);
      align-items: end;
    }
  }
</style>
