    const title = "The developer's view"
    const subtitle = 'Level 3 of 4. Level 2 collapses into one box in the cloud.'
    const fine = [
      label(words, 'Your laptop', 354, 176, { size: 12, ink: 'zoom-ink-muted', weight: 600, upper: true }),
      label(words, 'Your cloud project', 964, 176, { size: 12, ink: 'zoom-ink-accent', weight: 600, upper: true }),
      label(words, 'many jobs, draft PRs back', 964, 443, { size: 13, ink: 'zoom-ink-muted' }),
      label(words, 'talk or type', 272, 373, { size: 13, ink: 'zoom-ink-muted', anchor: 'middle' }),
      label(words, 'you watch', 210, 241, { size: 13, ink: 'zoom-ink-muted', anchor: 'middle' }),
      label(words, 'reads status and spend', 620, 579, { size: 13, ink: 'zoom-ink-muted', anchor: 'middle' }),
    ]
    const body = [
      entity('zoom-laptop', 330, 150, 520, 330),
      entity('zoom-cloud', 940, 150, 280, 330),
      card(words, { id: 'zoom-developer', icon: 'zoom-person', x: 56, y: 346, w: 160, h: 96, lines: [{ text: 'You', size: 16, weight: 700 }] }),
      card(words, { id: 'zoom-card', x: 370, y: 214, w: 200, h: 96, lines: [{ text: 'Console', size: 16, weight: 700 }, { text: 'shows runs, spend', size: 14 }, { text: 'and reviews', size: 14 }] }),
      card(words, { id: 'zoom-orchestrator', x: 370, y: 346, w: 200, h: 96, lines: [{ text: 'Orchestrator agent', size: 16, weight: 700 }, { text: 'Claude Code', size: 14 }, { text: '(talk to it, or type)', size: 14 }] }),
      card(words, { id: 'zoom-card-accent', x: 650, y: 280, w: 160, h: 96, lines: [{ text: 'Fugaro', size: 16, weight: 700 }, { text: 'the CLI: launches', size: 14 }, { text: 'runs, reads status', size: 14 }] }),
      ...[206, 280, 354].map((top) => card(words, { id: 'zoom-job', x: 980, y: top, w: 200, h: 60, lines: [{ text: 'Job', size: 14, weight: 700 }] })),
      card(words, { id: 'zoom-phone', x: 56, y: 560, w: 160, h: 80, lines: [{ text: 'Phone app', size: 16, weight: 700 }, { text: 'planned', size: 14 }] }),
      card(words, { id: 'zoom-firebase', x: 960, y: 560, w: 240, h: 80, lines: [{ text: 'Firebase', size: 16, weight: 700 }, { text: 'live data the apps read', size: 14 }] }),
      arrow('M136 262 V346', 'grey'),
      arrow('M136 262 H370', 'grey'),
      arrow('M216 394 H370', 'grey'),
      arrow('M136 442 V560', 'planned', { start: true }),
      arrow('M570 394 H730', 'grey', { end: false }),
      arrow('M730 394 V376', 'grey'),
      arrow('M570 262 H730', 'grey', { end: false }),
      arrow('M730 262 V280', 'grey'),
      arrow('M810 324 H940', 'grey'),
      arrow('M216 600 H960', 'planned', { dashed: true, end: false }),
      arrow('M1080 560 V480', 'grey'),
      label(words, title, 64, 90, { size: 32, weight: 700, display: true }),
      label(words, subtitle, 64, 121, { size: 16, ink: 'zoom-ink-muted' }),
      paragraph(
        words,
        'You work with an orchestrator agent on your laptop. It uses the Fugaro CLI, which launches runs in your cloud project; the console reads the same project through the CLI. The phone app is planned and will read the live data from Firebase.',
        64,
        678,
        1152,
      ),
    ]
    return { body, fine, title, subtitle }
  })
}

/** Level 4 — the whole project: two workstations, one project, and what is planned in it. */
function level4() {
  return level('level-4', (words) => {
    const title = 'The whole project'
    const subtitle = 'Level 4 of 4. Everything sits in one project; dashed parts are planned.'
    const fine = [
      label(words, 'Laptop or workstation', 224, 169, { size: 11, ink: 'zoom-ink-muted', weight: 600, upper: true }),
      label(words, 'Laptop or workstation', 224, 379, { size: 11, ink: 'zoom-ink-muted', weight: 600, upper: true }),
      label(words, 'One Firebase and GCP project', 504, 158, { size: 12, ink: 'zoom-ink-project', weight: 600, upper: true }),
    ]
    const body = [
      entity('zoom-laptop', 208, 150, 224, 160),
      entity('zoom-laptop', 208, 360, 224, 160),
      entity('zoom-project', 480, 130, 640, 420),
      ...[170, 380].map((top) =>
        card(words, { id: 'zoom-developer', icon: 'zoom-person', x: 32, y: top, w: 128, h: 120, step: 18, lead: 12, lines: [{ text: 'Developer', size: 15, weight: 700 }] }),
      ),
      card(words, { id: 'zoom-developer-planned', icon: 'zoom-person-planned', x: 1148, y: 300, w: 112, h: 120, step: 18, lead: 12, lines: [{ text: 'Developer', size: 15, weight: 700 }, { text: 'on the phone', size: 13 }, { text: 'planned', size: 13 }] }),
      ...[182, 392].flatMap((top) => [
        card(words, { id: 'zoom-orchestrator', x: 224, y: top, w: 192, h: 56, lines: [{ text: 'Orchestrator agent', size: 14, weight: 700 }] }),
        card(words, { id: 'zoom-card-accent', x: 224, y: top + 68, w: 192, h: 48, lines: [{ text: 'Fugaro', size: 14, weight: 700 }] }),
      ]),
      card(words, { id: 'zoom-job', x: 504, y: 186, w: 176, h: 84, lines: [{ text: 'Cloud Run jobs', size: 16, weight: 700 }, { text: 'one execution per run', size: 14 }] }),
      card(words, { id: 'zoom-card', x: 712, y: 186, w: 176, h: 84, lines: [{ text: 'Secret Manager', size: 16, weight: 700 }, { text: 'credentials runs use', size: 14 }] }),
      card(words, { id: 'zoom-card', x: 920, y: 186, w: 176, h: 84, lines: [{ text: 'Runs bucket', size: 16, weight: 700 }, { text: 'results and logs', size: 14 }] }),
      card(words, { id: 'zoom-card', x: 504, y: 304, w: 176, h: 84, lines: [{ text: 'Budget caps', size: 16, weight: 700 }, { text: 'and the kill switch', size: 14 }] }),
      card(words, { id: 'zoom-card', x: 712, y: 304, w: 176, h: 84, lines: [{ text: 'Live counters', size: 16, weight: 700 }, { text: 'and history', size: 14 }] }),
      card(words, { id: 'zoom-card-planned', x: 920, y: 304, w: 176, h: 84, lines: [{ text: 'Security service', size: 16, weight: 700 }, { text: 'planned', size: 14 }] }),
      card(words, { id: 'zoom-card', x: 504, y: 422, w: 176, h: 84, lines: [{ text: 'Policy', size: 16, weight: 700 }, { text: 'who may launch', size: 14 }] }),
      card(words, { id: 'zoom-card-planned', x: 712, y: 422, w: 176, h: 84, lines: [{ text: 'Coordinator', size: 16, weight: 700 }, { text: 'advisory, planned', size: 14 }] }),
      card(words, { id: 'zoom-card-planned', x: 920, y: 422, w: 176, h: 84, lines: [{ text: 'Central orchestrators', size: 16, weight: 700 }, { text: 'optional, planned', size: 14 }] }),
      arrow('M160 230 H208', 'grey'),
      arrow('M160 440 H208', 'grey'),
      arrow('M432 230 H480', 'grey'),
      arrow('M432 440 H480', 'grey'),
      arrow('M1148 360 H1120', 'planned'),
      label(words, title, 64, 90, { size: 32, weight: 700, display: true }),
      label(words, subtitle, 64, 121, { size: 16, ink: 'zoom-ink-muted' }),
      paragraph(
        words,
        'Each developer works from a laptop or workstation with an orchestrator agent and the Fugaro CLI. Jobs, secrets, budgets, live counters and history, and who may launch all live in one integrated project. The local orchestrators will report to the coordinator, which only advises.',
        64,
        604,
        1152,
      ),
    ]
    return { body, fine, title, subtitle }
  })
}

const LEVELS = [level1(), level2(), level3(), level4()]
holdZoomBoards(LEVELS)
---

<section class="zoom" aria-labelledby="zoom-title">
  <h2 class="zoom-title" id="zoom-title">The four levels</h2>

  <p class="zoom-legend">
    A dashed outline is a part that is planned rather than built.
  </p>

  <nav class="zoom-nav" aria-label="The four levels">
    <ul class="zoom-marker-list">
      {
        LEVELS.map((entry, index) => (
          <li>
            <a class="zoom-marker" href={`#${entry.id}`} aria-label={`Level ${index + 1} — ${entry.name}`}>
              {index + 1}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <svg class="zoom-defs" aria-hidden="true" focusable="false" width="0" height="0">
    <defs set:html={SYMBOLS} />
  </svg>

  {
    LEVELS.map((entry) => (
      <figure class="zoom-figure" id={entry.id}>
        <svg class="zoom-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${entry.id}-title`} set:html={entry.markup} />
        <figcaption class="zoom-caption">
          <span class="zoom-level-name">{entry.name}</span>
        </figcaption>
      </figure>
    ))
  }
</section>

<style>
  /* The section takes the page's column, like every other block on the page, and the drawings
     sit on the boards' own ground — `--ground`, which is the one colour of the boards that is
     exactly a token of the palette in force — inside the hairline and the radius every raised
     thing on this site has.

     The `--zoom-*` variables are the boards' colours, named once here: the boards are drawn with
     a set of colours the site does not otherwise use, and the brief of 2026-10-22 asks for a
     board colour that is not an exact palette token to stay as a named CSS variable rather than
     be rounded to the nearest one. They are declared at the document root rather than on the
     section because that is where this site declares a variable, and because the accessibility
     contract reads a rule other than `:root` for a colour literal — a component that painted one
     would be a colour no contrast pair of the palette covers. The drawings' own paint and
     contrast are held instead by `website/test/how-it-works.mjs`, which resolves these names
     against the boards themselves (`zoomPaintFailures`, `boardTokens`): every value below is a
     value a board writes, and the day the boards are redrawn in the palette these go. */
  :global(:root) {
    --zoom-ink: #E6ECF5;
    --zoom-muted: #8DA0BC;
    --zoom-accent: #FF8B3D;
    --zoom-card: #111826;
    --zoom-edge: #2B364A;
    --zoom-panel: #0E1420;
    --zoom-blue: #6AB0FF;
    --zoom-green: #4ADE80;
    --zoom-green-card: #16231C;
    --zoom-planned: #5C6B85;
    --zoom-loop-edge: #4A5A78;
    --zoom-loop-card: #101827;
    --zoom-project: #C9D5EA;
  }

  .zoom {
    margin-top: var(--space-3xl);
  }

  .zoom-title {
    margin: 0 0 var(--space-2xs);
  }

  .zoom-legend {
    margin: 0 0 var(--space-md);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  /* The markers: the level's own number, one per level, in a row above the drawings. They are
     anchors rather than buttons (D245), so a reader with no script still has them, and the
     linkcheck gate resolves every one of them. */
  .zoom-nav {
    margin: 0 0 var(--space-md);
  }

  .zoom-marker-list {
    display: flex;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The target size every control on this site carries (the owner's brief of 2026-10-19),
     as the homepage slider's dots write it: these are four controls a reader taps. */
  .zoom-marker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }

  figure.zoom-figure {
    margin: 0 0 var(--space-lg);
  }

  /* The drawing scales to the column: the `viewBox` is the board's own 1280x720 and `width:
     100%` maps it onto the column. Below the phone breakpoint the figure keeps a floor and
     scrolls inside its own box instead — a 1280-unit board at a 390 px column would set the
     board's 11 px labels at 3.4 px, which is not text — and the labels under that floor are
     hidden there (`.zoom-fine`), so nothing is ever drawn smaller than a reader can read. */
  .zoom-svg {
    display: block;
    width: 100%;
    height: auto;
    background: var(--ground);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-xl);
  }

  /* The one `<defs>`: it is the drawing's shapes and nothing a reader sees, so it takes no
     room of its own. It is not `display: none` — a reference from another `<svg>` of this
     document is what every level's `<use>` is, and a hidden subtree is a subtree some engines
     resolve and others do not. */
  .zoom-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .zoom-caption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-xs);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .zoom-level-name {
    color: var(--text);
    font-weight: var(--weight-medium);
  }

  /* The phone reading: the drawing keeps 920 units of width — the 14-unit labels the boards set
     at 14 px are 10.06 px there, which is the floor — and the figure scrolls sideways rather
     than shrinking past it. The board's small print goes, which is what a `<g>` this rule hides
     is for; the title, the subtitle, the cards and the paragraph all stay. */
  @media (max-width: 60rem) {
    figure.zoom-figure {
      overflow-x: auto;
    }

    .zoom-svg {
      min-width: 57.5rem;
    }

    .zoom :global(.zoom-fine) {
      display: none;
    }
  }

  /* Every shape of the drawing is markup this component generates and hands to `set:html`,
     which Astro's scope attribute never reaches: a scoped rule cannot match it, and the shape
     would fall back to SVG's initial values — a black fill (the defect of 2026-10-21).
     `:global()` opts the shape's own compound out of the scoping and leaves the rule reaching
     the shape. */
  .zoom :global(.zoom-word) {
    font-family: var(--font-sans);
    /* A label of a board is placed by its coordinates: an SVG `<text>` is not laid out in the
       run of words beside it, however the markup puts one element after another. The site's
       spacing gate reads the page's own stylesheet for exactly that — a class the artifact
       lays out as a block is a boundary a reader sees — so two labels written one after the
       other are two labels and not one word, which is how the run diagram's own labels say
       the same thing. */
    display: block;
  }

  .zoom :global(.zoom-ink) {
    fill: var(--zoom-ink);
  }

  .zoom :global(.zoom-ink-muted) {
    fill: var(--zoom-muted);
  }

  .zoom :global(.zoom-ink-accent) {
    fill: var(--zoom-accent);
  }

  .zoom :global(.zoom-ink-project) {
    fill: var(--zoom-project);
  }

  /* The boards set their eyebrows in caps with 1.2 px of tracking and their headlines tight;
     the text is the board's own string either way, and the case is the type's business. */
  .zoom :global(.zoom-upper) {
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  .zoom :global(.zoom-display) {
    letter-spacing: -0.5px;
  }

  .zoom :global(.zoom-shape) {
    stroke-linejoin: round;
  }

  .zoom :global(.zoom-fill-card) {
    fill: var(--zoom-card);
  }

  .zoom :global(.zoom-fill-panel) {
    fill: var(--zoom-panel);
  }

  .zoom :global(.zoom-fill-loop) {
    fill: var(--zoom-loop-card);
  }

  .zoom :global(.zoom-fill-green) {
    fill: var(--zoom-green-card);
  }

  .zoom :global(.zoom-line-edge) {
    stroke: var(--zoom-edge);
    stroke-width: 1;
  }

  .zoom :global(.zoom-line-accent) {
    stroke: var(--zoom-accent);
    stroke-width: 2;
  }

  .zoom :global(.zoom-line-accent-thin) {
    stroke: var(--zoom-accent);
    stroke-width: 1;
  }

  .zoom :global(.zoom-line-blue) {
    stroke: var(--zoom-blue);
    stroke-width: 1;
  }

  .zoom :global(.zoom-line-green) {
    stroke: var(--zoom-green);
    stroke-width: 1;
  }

  .zoom :global(.zoom-line-project) {
    stroke: var(--zoom-project);
    stroke-width: 2;
  }

  .zoom :global(.zoom-line-planned) {
    stroke: var(--zoom-planned);
    stroke-dasharray: 6 6;
    stroke-width: 1;
  }

  .zoom :global(.zoom-line-loop) {
    stroke: var(--zoom-loop-edge);
    stroke-dasharray: 6 6;
    stroke-width: 1;
  }

  /* The person in a developer card: the board's own two strokes, and the planned one in the
     grey the dashed cards are drawn in. */
  .zoom :global(.zoom-person) {
    fill: none;
    stroke: var(--zoom-blue);
    stroke-linecap: round;
    stroke-width: 2;
  }

  .zoom :global(.zoom-person-planned) {
    fill: none;
    stroke: var(--zoom-planned);
    stroke-linecap: round;
    stroke-width: 2;
  }

  /* The connectors between a level's parts, and their arrowheads. A tone is one class on the
     path and one on the marker's own head, so a green arrow's head is green. */
  .zoom :global(.zoom-arrow) {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .zoom :global(.zoom-arrow-grey) {
    stroke: var(--zoom-muted);
  }

  .zoom :global(.zoom-arrow-accent) {
    stroke: var(--zoom-accent);
  }

  .zoom :global(.zoom-arrow-green) {
    stroke: var(--zoom-green);
  }

  .zoom :global(.zoom-arrow-planned) {
    stroke: var(--zoom-planned);
  }

  .zoom :global(.zoom-head) {
    stroke: none;
  }

  .zoom :global(.zoom-head-grey) {
    fill: var(--zoom-muted);
  }

  .zoom :global(.zoom-head-accent) {
    fill: var(--zoom-accent);
  }

  .zoom :global(.zoom-head-green) {
    fill: var(--zoom-green);
  }

  .zoom :global(.zoom-head-planned) {
    fill: var(--zoom-planned);
  }
</style>
