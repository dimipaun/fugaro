---
/**
 * website/src/components/ZoomLevels.astro — the four levels, as the owner's approved boards.
 *
 * The four boards (`website/design-ref/zoom-levels/level1.dc.html` … `level4.dc.html`, 1280x720,
 * drawn in Claude Design) are shown as the PNGs rendered from them at twice the size
 * (`public/images/zoom/level1.png` … `level4.png`). Redrawing them as inline SVG looked worse than
 * the boards and cost more than it was worth (owner, 2026-10-22), so the picture is the board's
 * own render. A reader who cannot see it is given the `alt` text; the page's `<nav>` of anchors
 * (`#level-1` … `#level-4`) is the same as ever and needs no script.
 */
const LEVELS = [
  {
    id: 'level-1',
    name: 'Inside one job',
    alt: 'Level 1 of 4, inside one job. One run is one ephemeral cloud job. Checks run first when the recipe asks for them; the coder and the first-line reviewer go round; then a senior review judges the result and a draft pull request becomes ready only when it ships and the tests pass on the final commit.',
  },
  {
    id: 'level-2',
    name: 'One orchestrator, many jobs',
    alt: 'Level 2 of 4, one orchestrator, many jobs. The orchestrator on the developer’s machine asks Fugaro for several runs; Fugaro checks the budget and launches the jobs in parallel; every job opens a draft pull request that flows back to the orchestrator.',
  },
  {
    id: 'level-3',
    name: 'The developer’s view',
    alt: 'Level 3 of 4, the developer’s view. You work with an orchestrator agent on your laptop. It uses the Fugaro CLI, which launches runs in your cloud project; the console reads the same project through the CLI.',
  },
  {
    id: 'level-4',
    name: 'The whole project',
    alt: 'Level 4 of 4, the whole project. Each developer works from a laptop or workstation with an orchestrator agent and the Fugaro CLI. Jobs, secrets, budgets, live counters and history, and who may launch all live in one cloud project; the coordinator and central orchestrators, the security service and the phone app are planned.',
  },
]
---

<section class="zoom" aria-labelledby="zoom-title">
  <h2 class="zoom-title" id="zoom-title">The four levels</h2>

  <p class="zoom-legend">
    A dashed outline is a part that is planned rather than built.
  </p>

  <nav class="zoom-nav" aria-label="The four levels">
    <ul class="zoom-marker-list">
      {
        LEVELS.map((entry, index) => (
          <li>
            <a class="zoom-marker" href={`#${entry.id}`} aria-label={`Level ${index + 1} — ${entry.name}`}>
              {index + 1}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    LEVELS.map((entry, index) => (
      <figure class="zoom-figure" id={entry.id}>
        <img
          class="zoom-img"
          src={`/images/zoom/level${index + 1}.png`}
          width="2560"
          height="1440"
          alt={entry.alt}
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
        <figcaption class="zoom-caption">
          <span class="zoom-level-name">{entry.name}</span>
        </figcaption>
      </figure>
    ))
  }
</section>

<style>
  .zoom {
    margin-top: var(--space-3xl);
  }

  .zoom-title {
    margin: 0 0 var(--space-2xs);
  }

  .zoom-legend {
    margin: 0 0 var(--space-md);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .zoom-nav {
    margin: 0 0 var(--space-md);
  }

  .zoom-marker-list {
    display: flex;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zoom-marker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    text-decoration: none;
  }

  .zoom-marker:hover,
  .zoom-marker:focus-visible {
    border-color: var(--accent);
  }

  .zoom-figure {
    margin: 0 0 var(--space-xl);
    scroll-margin-top: var(--space-2xl);
  }

  .zoom-img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
  }

  .zoom-caption {
    margin-top: var(--space-xs);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }
</style>
