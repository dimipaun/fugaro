---
/**
 * website/src/components/Terminal.astro — the homepage run animation (website plan, Task
 * W1.4 step 2; redesign part P7, decisions D184 and RF9–RF11).
 *
 * A hero that shows the product doing something, and every line of what it shows is a line
 * the repository already writes: the invocation is README.md's own example command (a
 * `fugaro run` the generated CLI reference documents), and the four lines after it are the
 * numbered steps of the README's `## How it works`, in the order that section writes them.
 * Both are held here at build time — the command to README.md and to
 * `website/content/cli-reference.md`, each step to the section it cites, in that section's
 * order — and again from outside by `website/test/home.mjs`, which reads the built page. A
 * terminal in a hero is where a site shows a command that does not exist, and a transcript
 * is where it invents a run that never happened (RF11).
 *
 * **What the lines are, and what they are not.** They are the documented sequence of a run,
 * not a recording of one: no job identifier, elapsed time, branch, run URL or pull-request
 * number appears here, because every one of those would be a fact about a run that did not
 * happen (D184's rejected alternatives). The caption under the window says so on the page,
 * and the build refuses to emit a step the README does not write, in the order it writes it
 * — the arrangement `ArchitectureDiagram.astro` uses for its captions.
 *
 * **How the typing is done, and why this way.** No JavaScript, no island, no framework: the
 * whole transcript is in the markup and the animation reveals it a line at a time, so the
 * page ships zero bytes of script for it (D105's budget is W1.11's to enforce, and a hero
 * that spent it on a decoration would be spending the console's budget before the console
 * arrives). One line is one reveal — `max-width` growing from nothing to that line's own
 * width in one step per character — and the lines are staggered by adding up the durations
 * in front of them. The command is typed at the pace of a hand (the 2.4 s the single command
 * took before P7, whatever the command's length); the four lines after it arrive at the pace
 * of a machine, because that is what they are.
 *
 * **The end state.** The whole transcript is in the markup and the animation's fill mode is
 * `both`, so the three states line up like this:
 *
 *   - motion allowed: the lines reveal one after another and stay revealed;
 *   - `prefers-reduced-motion: reduce`: the layout's global rule (W1.3, D105) sets every
 *     duration to 1ms and every delay to 0ms with the fill mode kept, so after one
 *     millisecond every line is on the keyframes' end state — the whole transcript, whole
 *     and immediately;
 *   - CSS animation unsupported, or turned off by the reader: no animation applies at all
 *     and each line is what its own rule says, which is the finished line — the reveal is a
 *     keyframe rather than a base rule, so nothing is clipped by a style that never ran.
 *
 * The caret follows the same shape: it blinks while motion is allowed and, when it is not,
 * sits still and visible — the global rule caps it at a single iteration, and its base rule
 * is the visible caret rather than the blank half of the blink. Even with motion allowed it
 * blinks four times (4.4 s) once its line has arrived and then holds still: a blink that ran
 * for ever would be motion past five seconds with no way to stop it (WCAG 2.2.2).
 */
import { readFileSync } from 'node:fs'
import path from 'node:path'
import { REPO_ROOT, loadSite } from '../content.ts'
import { copyControlHTML } from '../lib/copy-control.mjs'

const site = loadSite()

// The invocation: README.md's own example line. Not a command written for this page, and
// held to the README below, so the two cannot drift.
const COMMAND = 'fugaro run "add a --verbose flag to the export command"'

// The program and subcommand the reference has to document for the line above to be a real
// invocation rather than a plausible-looking one (W0.4).
const PROGRAM = 'fugaro run'

// The prompt the shell draws in front of the command. It is two columns of the terminal's
// monospace font, which is what the reveal counts it as below — the same text, rendered and
// counted, so the line is revealed exactly as wide as it is.
const PROMPT = '$ '

const readme = readFileSync(path.join(REPO_ROOT, 'README.md'), 'utf8')
if (!readme.includes(COMMAND)) {
  throw new Error(
    `website/src/components/Terminal.astro: README.md no longer prints ${JSON.stringify(COMMAND)}, and the terminal shows the README's own example rather than a command invented for the page. Pick a command the README prints today (W1.4 step 2).`,
  )
}

const reference = site.documents['cli-reference.md']
if (!reference.body.includes(`\`${PROGRAM}\``)) {
  throw new Error(
    `website/src/components/Terminal.astro: ${reference.path} does not document \`${PROGRAM}\`, and the terminal types an invocation the generated CLI reference carries. Either the reference lost the command or the terminal is showing one that does not exist (W0.4, W1.4 step 2).`,
  )
}

/**
 * A string with its markdown markers and its whitespace removed: how a line and the document
 * it claims to come from are compared. Emphasis and code spans are markers rather than text,
 * and where a document breaks a line is its layout rather than its words. The same function,
 * for the same reason, is in `ArchitectureDiagram.astro`.
 */
function comparable(document: string): string {
  return document.replace(/[`*]/g, '').replace(/\s+/g, '')
}

/** README.md's `## How it works` section: its heading to the next `## `. */
function readmeHowItWorks(): string {
  const start = readme.indexOf('\n## How it works\n')
  if (start === -1) {
    throw new Error(
      'website/src/components/Terminal.astro: README.md carries no "## How it works" section, and the four lines after the command are the steps that section writes (D184).',
    )
  }
  const rest = readme.slice(start + 1)
  const next = rest.indexOf('\n## ', 1)
  return next === -1 ? rest : rest.slice(0, next)
}

// The document each step line cites. The section rather than the file: the claim these lines
// make is that they are the steps of `## How it works`, in its order, and a line quoted from
// somewhere else in the README is not that. The command above cites the file, because the
// README's example command is an example anywhere it appears.
const HOW_IT_WORKS = 'README.md#How it works'

/**
 * The four lines after the command: the README's numbered steps, shortened to what fits a
 * line of a terminal — Start, Sync, Loop, Push and open the pull request. Each is a
 * substring of its step, in the section's order, which is what the loop below holds them to.
 */
const STEPS = [
  { line: "Start from the image of the repository's workflow" },
  { line: 'Sync to the exact target commit and restore the dependency caches.' },
  { line: 'Loop: Claude Code implements, writes tests, runs the build and tests' },
  { line: 'Push and open the pull request' },
]

// Hold every step to the section it cites, here, so a paraphrase — or a step quoted out of
// order — stops the build naming the file rather than reaching a reader as the repository's
// own words. `cursor` walks forward through the section, so each line has to appear after
// the one before it: the transcript is the documented sequence, and a sequence that is not
// the document's order is the animation saying something the README does not.
{
  const section = comparable(readmeHowItWorks())
  let cursor = 0
  for (const [index, step] of STEPS.entries()) {
    const line = comparable(step.line)
    const at = section.indexOf(line, cursor)
    if (at === -1) {
      throw new Error(
        `website/src/components/Terminal.astro: the terminal's line ${index + 1} after the command, ${JSON.stringify(step.line)}, is not a line of README.md's "## How it works" at or after the step before it, and the transcript is the documented sequence of a run rather than a run that happened (D184, RF11). Quote a step of that section, in the order it writes them.`,
      )
    }
    cursor = at + line.length
  }
}

// How long each line takes to arrive, and the pause before the next one starts.
//
// The command is typed at the pace of a hand, and the hero's opening beat is the 2.4 s the
// single command took before P7 — so its reveal is that duration whatever the command's
// length, rather than a pace the length is multiplied by. The four lines after it are output
// — what a run prints — and output arrives at the pace of the machine rather than the hand:
// 0.013 s a character. From this build, the whole transcript takes about six seconds.
const TYPED_SECONDS = 2.4
const OUTPUT_SECONDS_PER_CHARACTER = 0.013
const GAP_SECONDS = 0.18

// The caret is the last line's last column. It is inside that line, so the line's reveal has
// to be one column wider than its text: at exactly the text's width the caret would stay
// clipped beside it for good. One column covers the caret's 0.6ch of ink and its margin.
const CARET_COLUMNS = 1

const LINES = [
  { text: COMMAND, source: 'README.md', command: true, prompt: PROMPT },
  ...STEPS.map((step) => ({ text: step.line, source: HOW_IT_WORKS, command: false, prompt: '' })),
]

// The transcript, with each line's reveal worked out: how many columns of the monospace font
// it takes (its text, the prompt in front of the command, the caret in the last line), how
// long it takes to arrive, and how long the lines before it take. Written as custom
// properties on the line and read by the stylesheet below, so the counts are stated once.
let clock = 0
const TRANSCRIPT = LINES.map((line, index) => {
  const last = index === LINES.length - 1
  const duration = line.command ? TYPED_SECONDS : line.text.length * OUTPUT_SECONDS_PER_CHARACTER
  const entry = {
    ...line,
    last,
    characters: line.prompt.length + line.text.length + (last ? CARET_COLUMNS : 0),
    duration: duration.toFixed(3),
    delay: clock.toFixed(3),
  }
  clock += duration + GAP_SECONDS
  return entry
})
---

<figure class="terminal-figure">
  {/* The window. `data-copy` is what the site's script binds to (P6), and each line below
     says which document it is quoted from — the check `website/test/home.mjs` reads. */}
  <div class="terminal" data-copy>
    {/* The window's chrome. The dots are decoration — three circles with nothing behind them
       — and they are marked as such one by one rather than by hiding the whole bar, because
       the copy control sits in the bar too and a focusable control inside `aria-hidden` is a
       control the keyboard reaches and a screen reader cannot see (P6). */}
    <div class="terminal-chrome">
      <div class="terminal-dots" aria-hidden="true">
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
      </div>

      <Fragment set:html={copyControlHTML('Copy the command')} />
    </div>

    {/* Every line on one source line, for the reason `Hero.astro`'s install blocks give: a
       newline or an indent inside a line is a character of it. The `<pre>` is the block
       the copy control sits on (P6), and what the script copies out of it is the
       `[data-copy-source]` span — the invocation, without the prompt drawn beside it. */}
    <pre class="terminal-body"><code>{TRANSCRIPT.map((line) => <span class="terminal-line" data-source={line.source} style={`--terminal-characters: ${line.characters}; --terminal-duration: ${line.duration}s; --terminal-delay: ${line.delay}s`}>{line.command ? <><span class="terminal-prompt" aria-hidden="true">{PROMPT}</span><span class="terminal-command" data-copy-source>{line.text}</span></> : line.text}{line.last && <span class="terminal-caret" aria-hidden="true"></span>}</span>)}</code></pre>
  </div>

  {/* The one caption (D184): the lines are the documented sequence, and the page says so
     rather than leaving a reader to take a transcript for a recording. */}
  <figcaption class="terminal-caption">
    The documented sequence of a run — the command, then the steps the documentation gives,
    in their order. Not a recording of a run.
  </figcaption>
</figure>

<style>
  .terminal-figure {
    max-width: var(--measure);
    margin: 0;
  }

  .terminal {
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  .terminal-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-sm);
    border-bottom: var(--border-width) solid var(--border);
    background: var(--ground);
  }

  .terminal-dots {
    display: flex;
    gap: var(--space-3xs);
  }

  .terminal-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--border);
  }

  /* The transcript. `white-space: normal` here rather than the `<pre>`'s own `pre`: the
     lines below are blocks and each carries the whitespace it means, so an indented template
     between them must not print. A line longer than the window scrolls this box sideways
     rather than being cut off — the lines are `max-content` wide, so they overflow it. */
  .terminal-body {
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    overflow-x: auto;
    white-space: normal;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);
  }

  /* One line of the transcript, and its reveal. `width: max-content` is the line's own
     width — the same width the reveal below grows to — so a line is clipped by its own
     reveal and not by the window, and a line the window cannot hold scrolls it. The reveal
     is in the keyframes and nowhere else: a browser that runs no animation therefore clips
     nothing, and the line is simply there. */
  .terminal-line {
    display: block;
    width: max-content;
    overflow: hidden;
    white-space: pre;
    animation: terminal-type var(--terminal-duration) steps(var(--terminal-characters), end) var(--terminal-delay) both;
  }

  @keyframes terminal-type {
    from {
      max-width: 0;
    }
    to {
      max-width: calc(var(--terminal-characters) * 1ch);
    }
  }

  .terminal-prompt {
    color: var(--text-muted);
    user-select: none;
  }

  /* The typed invocation. No style of its own: it is the element `data-copy-source` marks,
     so it is what the copy control copies and what `website/test/home.mjs` reads the command
     out of — the prompt and the caret beside it are `aria-hidden` decoration. */
  .terminal-command {
    display: inline;
  }

  /* The caret: visible at rest, blinking while motion is allowed — four times, starting when
     its line has arrived (the line's own delay and duration, inherited), so the blink is over
     inside five seconds (WCAG 2.2.2) — and inside the last line
     so that it arrives with the line rather than sitting at the end of a line that has not
     been typed yet. The global reduced-motion rule caps it at one iteration, so it lands
     back on this rule rather than on the blank half of the blink (W1.3 step 3). */
  .terminal-caret {
    display: inline-block;
    width: 0.6ch;
    height: 1.1em;
    margin-left: 0.15ch;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: terminal-caret 1.1s step-end calc(var(--terminal-delay) + var(--terminal-duration)) 4;
  }

  @keyframes terminal-caret {
    50% {
      opacity: 0;
    }
  }

  .terminal-caption {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }
</style>
