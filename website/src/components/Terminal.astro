---
/**
 * website/src/components/Terminal.astro — the animated terminal (website plan, Task W1.4
 * step 2).
 *
 * A hero that shows the product doing something, and what it shows is a real invocation:
 * README.md's own example command, printed by the README in its getting-started block, and a
 * `fugaro run` whose commands the generated CLI reference documents (W0.4's file under
 * `website/content/`). Both are checked here at build time — and again from outside by
 * `website/test/home.mjs`, which reads the built page — because a terminal in a hero is
 * where a site shows a command that does not exist.
 *
 * **How the typing is done, and why this way.** No JavaScript, no island, no framework: the
 * command is in the markup in full and the animation reveals it, so the page ships zero
 * bytes of script for it (D105's budget is W1.11's to enforce, and a hero that spent it on a
 * decoration would be spending the console's budget before the console arrives). The reveal
 * is `max-width` growing from nothing to the command's own width in one step per character.
 *
 * **The end state.** The rule outside the keyframes is the finished command, and the
 * keyframes animate *from* empty, so the three states line up like this:
 *
 *   - motion allowed: the reveal runs once on load and lands on the finished command;
 *   - `prefers-reduced-motion: reduce`: the layout's global rule (W1.3, D105) sets every
 *     duration to 1ms with the fill mode kept, so after one millisecond the element is on
 *     the keyframes' end state — the finished command, whole and immediately;
 *   - CSS animation unsupported, or turned off by the reader: no animation applies at all,
 *     and the element is what its own rule says, which is the same finished command.
 *
 * The caret follows the same shape: it blinks while motion is allowed and, when it is not,
 * sits still and visible — the global rule caps it at a single iteration, and its base rule
 * is the visible caret rather than the blank half of the blink.
 */
import { readFileSync } from 'node:fs'
import path from 'node:path'
import { REPO_ROOT, loadSite } from '../content.ts'

const site = loadSite()

// The invocation: README.md's own example line. Not a command written for this page, and
// held to the README below, so the two cannot drift.
const COMMAND = 'fugaro run "add a --verbose flag to the export command"'

// The program and subcommand the reference has to document for the line above to be a real
// invocation rather than a plausible-looking one (W0.4).
const PROGRAM = 'fugaro run'

const readme = readFileSync(path.join(REPO_ROOT, 'README.md'), 'utf8')
if (!readme.includes(COMMAND)) {
  throw new Error(
    `website/src/components/Terminal.astro: README.md no longer prints ${JSON.stringify(COMMAND)}, and the terminal shows the README's own example rather than a command invented for the page. Pick a command the README prints today (W1.4 step 2).`,
  )
}

const reference = site.documents['cli-reference.md']
if (!reference.body.includes(`\`${PROGRAM}\``)) {
  throw new Error(
    `website/src/components/Terminal.astro: ${reference.path} does not document \`${PROGRAM}\`, and the terminal types an invocation the generated CLI reference carries. Either the reference lost the command or the terminal is showing one that does not exist (W0.4, W1.4 step 2).`,
  )
}

// How many characters the reveal steps through, so the typing ends exactly on the finished
// command rather than somewhere near it. Written as the animation's step count and as the
// end of the reveal, both in `ch` of the terminal's monospace font.
const characters = COMMAND.length
---

<div class="terminal" data-source="website/content/cli-reference.md">
  {/* The window's chrome, which is decoration: three dots with nothing behind them. */}
  <div class="terminal-chrome" aria-hidden="true">
    <span class="terminal-dot"></span>
    <span class="terminal-dot"></span>
    <span class="terminal-dot"></span>
  </div>

  <pre class="terminal-body"><code><span class="terminal-prompt" aria-hidden="true">$ </span><span
        class="terminal-command"
        style={`--terminal-characters: ${characters}`}>{COMMAND}</span><span
        class="terminal-caret"
        aria-hidden="true"></span></code></pre>
</div>

<style>
  .terminal {
    max-width: var(--measure);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  .terminal-chrome {
    display: flex;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-sm);
    border-bottom: var(--border-width) solid var(--border);
    background: var(--ground);
  }

  .terminal-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--border);
  }

  .terminal-body {
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    overflow-x: auto;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);
  }

  .terminal-prompt {
    color: var(--text-muted);
    user-select: none;
  }

  /* The typed command. Its own rule is the end state — the whole command — so that a reader
     whose animation does not run at all still reads a command rather than a blank line; the
     keyframes below take it from empty to that state, and `both` holds the end state after
     the reveal has finished (W1.4 step 2). */
  .terminal-command {
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    animation: terminal-type 2.4s steps(var(--terminal-characters), end) both;
  }

  @keyframes terminal-type {
    from {
      max-width: 0;
    }
    to {
      max-width: 60ch;
    }
  }

  /* The caret: visible at rest, blinking while motion is allowed. The global reduced-motion
     rule caps it at one iteration, so it lands back on this rule rather than on the blank
     half of the blink (W1.3 step 3). */
  .terminal-caret {
    display: inline-block;
    width: 0.6ch;
    height: 1.1em;
    margin-left: 0.15ch;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: terminal-caret 1.1s step-end infinite;
  }

  @keyframes terminal-caret {
    50% {
      opacity: 0;
    }
  }
</style>
