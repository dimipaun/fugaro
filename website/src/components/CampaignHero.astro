---
/**
 * website/src/components/CampaignHero.astro — the campaign hero (go-to-market plan, Task G2.2;
 * spec §6, section 1).
 *
 * **The two lines are the variant's, and this file types neither.** The headline is the `h1`
 * and the supporting line is the sentence under it, both read from `website/data/landing.yaml`
 * by the page and passed in here (G2.1, D102): the spec quotes three of the four headlines and
 * the data file writes them, so a campaign whose message changes changes the file and not this
 * component.
 *
 * **The first screen carries the action** (the owner's feedback of 2026-10-30, finding 1). The
 * live preview's hero promised something, drew a small box beside the promise and put the only
 * way to act at the bottom of the page, so a visitor who had read the headline had nothing to
 * press. The booking link is now the hero's own third element, directly under the supporting
 * line and above the picture, at 1440x900 and at 390x844 — the consent bar and the header are
 * both above it in the flow and both counted. It is the same link the closing band offers
 * (`CampaignCalls.astro`), read from the same file, so the two are one booking and not two.
 *
 * **The headline is the page's, so its measure is the page's.** `.display-xl` is
 * `clamp(44px, 7.2vw, 104px)`, which is a size for a headline that owns the width of a band:
 * in the half-width column the hero used to give it, the longest variant's headline (48
 * characters) wrapped to five lines at 768 px and three at 1440 px. The owner's answer was to
 * widen the measure and cap the size, and the two are one rule below — the headline spans the
 * band and `clamp(17px, 5.2vw, 56px)` caps it. The size is read against the column at 390, 768
 * and 1440 px in `website/test/base-styles.mjs`, which is what keeps a later edit from putting
 * the fifth line back.
 *
 * **The hero's third element — the muted looping video — is not here.** A variant's `video` is
 * a path under `website/public/` that the owner produces, no variant names one yet, and the
 * layout's `media` slot is where a picture or a video lands when one does (spec §6, F14, G2.5).
 * The hero therefore renders complete without it rather than with a hole where a file would go.
 *
 * **What the eye lands on is the campaign's own drawing.** The owner's feedback of 2026-10-30
 * asked the hero to hold a picture that carries the idea in one look rather than a third
 * paragraph saying it again, and `CampaignHeroArt.astro` is that picture: a task, the
 * short-lived cloud job it starts and the pull request the job ends in, drawn inline and painted
 * from the variant's tone. It is rendered here rather than in the layout's `media` slot because
 * that slot sits *above* the headline — a variant's own video belongs there, and a phone's first
 * screen belongs to the promise and the sentence that backs it — so the drawing follows the
 * words on a narrow viewport and sits beside them from the wide breakpoint, and it is
 * suppressed outright while a variant names its own media, which then takes that slot instead
 * (F14, G2.5).
 *
 * **The tone rides on the section, not on a second stylesheet.** `data-tone` is the variant's
 * own word from the file (`playful` is `/crew`'s), and the campaign pages' own rules key their
 * accents off it, so the four pages are one template with one difference the data file states.
 */
import CampaignHeroArt from './CampaignHeroArt.astro'

interface Props {
  /** The variant's headline, from `website/data/landing.yaml`: the page's one `h1`. */
  headline: string
  /** The variant's supporting line, the sentence under the headline. */
  supportingLine: string
  /** The variant's tone (`savings`, `control`, `scale`, `playful`). */
  tone: string
  /** The owner's booking link, from `website/data/landing.yaml`: the first screen's one action. */
  calendlyURL: string
  /**
   * Whether the hero draws the campaign's own picture. False while the variant names media of
   * its own, which takes the layout's `media` slot at the top of the page instead.
   */
  art: boolean
}

const { headline, supportingLine, tone, calendlyURL, art } = Astro.props
---

<section class="campaign-hero" data-section="hero" data-tone={tone} data-source="website/data/landing.yaml">
  {/* The words first in the markup, so the reading order is the order a phone shows and a
      screen reader hears: the promise, the sentence that backs it, the way to act on it, and
      then the picture. */}
  <h1 class="campaign-hero-headline display-xl">{headline}</h1>
  <div class="campaign-hero-body">
    <div class="campaign-hero-copy">
      <p class="campaign-hero-line">{supportingLine}</p>
      <p class="campaign-hero-action">
        <a class="campaign-hero-button" href={calendlyURL}>Book a demo</a>
      </p>
    </div>
    {art && <CampaignHeroArt tone={tone} />}
  </div>
</section>

<style>
  /* Tokens only (W1.2): the type scale's steps, the site's ground and the tone the sentence
     under the headline is set in. */
  .campaign-hero {
    padding-block: var(--space-2xl) var(--space-xl);
    padding-inline: var(--frame-gutter);
  }

  /* The headline takes the band, and its size is capped. The two are one rule and the arithmetic
     is `base-styles.mjs`'s: at 390 px the band's content box is 358 px and the longest headline
     is 48 characters, which is two lines at 20 px and three at the 44 px `.display-xl` floors
     at. 5.2 vw is that size written as the viewport's, and `--font-size-4xl` is the ceiling a
     wide viewport stops at — 56 px at 1440, where the band is 1168 px wide. The floor is
     `--font-size-base`, so a viewport narrower than 390 px keeps the headline on the page
     rather than overflowing it. */
  .campaign-hero-headline {
    margin: 0;
    max-width: none;
    font-size: clamp(var(--font-size-base), 5.2vw, var(--font-size-4xl));
  }

  .campaign-hero-line {
    margin: 0;
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--font-size-lg);
    line-height: var(--leading-snug);
  }

  .campaign-hero-action {
    margin: var(--space-lg) 0 0;
  }

  /* The first screen's one action: the accent as its fill and the ground as its label, the pair
     `a11y.mjs` computes for a filled button, and the shape the homepage's own button is — a
     56 px control a thumb finds, at the width of its column. It is a link and not a button
     element because the booking is a page the visitor goes to. */
  .campaign-hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 56px;
    padding: 0 var(--space-xl);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--ground);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-black);
    text-decoration: none;
  }

  .campaign-hero-button:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .campaign-hero-button:hover {
      background: var(--accent-on-dark);
    }
  }

  /* The entrance (the owner's feedback of 2026-10-30, finding 5). The headline's own rise is
     `base.css`'s — `main h1.display-xl:not(.hero-tagline)` is every inner page's header, and a
     campaign hero is one — so what is written here is the rest of the stagger: the sentence
     100 ms after it, the button 200 ms after, and the picture 300 ms after that, each rising
     the same 18 px over the site's own entrance duration. CSS only, on the first frame the
     browser draws: a page with no script, or a browser without `@starting-style`, shows the
     hero as it is, and a reader who asked their system for less motion never gets the block at
     all rather than getting it neutralised. The button's own feedback — its hover and its
     press — is declared here too and for the same reason: the campaign's motion is written for
     a reader who has not asked for less, so nothing on these four pages leans on a rule
     elsewhere to undo it (`website/test/base-styles.mjs` reads that, and `base.css`'s universal
     reduce rule is the second half of the pair for everything the site does not gate). */
  @media (prefers-reduced-motion: no-preference) {
    .campaign-hero-button {
      transition:
        background-color var(--duration-fast) var(--ease-out),
        transform var(--duration-fast) var(--ease-out);
    }

    .campaign-hero-line,
    .campaign-hero-action {
      transition:
        opacity var(--duration-entrance) var(--ease-out),
        transform var(--duration-entrance) var(--ease-out);
    }

    .campaign-hero-line {
      transition-delay: 100ms;
    }

    .campaign-hero-action {
      transition-delay: 200ms;
    }

    @starting-style {
      .campaign-hero-line,
      .campaign-hero-action {
        opacity: 0;
        transform: translateY(18px);
      }
    }
  }

  /* The wide viewport is where the hero becomes two columns: the sentence and the action on the
     reading start and the drawing on the outer edge, level with each other. The headline is
     above both, which is what lets it be the width of the band at every width — the measure the
     owner asked for — and it is the reason the picture can be the biggest thing in the hero
     without the action being under it. The two-column rule is inside the breakpoint and nowhere
     else, so the phone's hero is the plain stack the markup's order gives it. */
  @media (min-width: 60rem) {
    .campaign-hero {
      padding-block: var(--space-3xl) var(--space-2xl);
    }

    .campaign-hero-body {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: end;
      column-gap: var(--space-xl);
    }

    /* The copy keeps the first column and the drawing the second, whether or not a drawing is
       rendered: a variant with media of its own is the same hero with one column painted. */
    .campaign-hero-copy {
      grid-column: 1;
    }
  }
</style>
