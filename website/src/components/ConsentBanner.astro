---
/**
 * website/src/components/ConsentBanner.astro — the consent banner (website plan, Task W1.12;
 * reconciliation findings 16, 18 and 55; decisions D93 and D106).
 *
 * D93 chose analytics for the site and answered the question that comes with it: nothing is
 * requested from the analytics origin until the visitor consents. The gate itself is code,
 * and since W3.2 it lives in the site's one first-party script file — `public/scripts/site.js`,
 * because D183 admits no inline script and the deployed policy needs no hash for one. This
 * component is the markup that code drives: it carries the consent key, the property id and
 * the one admitted origin as data attributes, it is the only thing that writes a decision,
 * and it is rendered only when `site.yaml` says analytics are on — so with the flag off the
 * artifact carries no banner, no configuration and no analytics origin at all.
 *
 * The decisions this file makes, and why:
 *
 *   - **Two choices, equally offered.** Both are native `<button type="button">` elements
 *     with the same class, the same size and the same treatment. There is no "reject all"
 *     buried in a settings page and no pre-ticked box: accepting and declining are one press
 *     each, and neither is the one the layout nudges a visitor towards.
 *   - **Dismissal is a refusal.** Escape hides the banner and records `denied`, and a
 *     visitor who navigates away without choosing loads nothing either — the default when
 *     nobody chooses is that nothing is measured, because the gate needs a stored `granted`
 *     to fetch anything at all.
 *   - **Nothing is loaded to ask the question.** The markup carries no script and names no
 *     host that is fetched; the gate that wakes on a choice is `site.js`, and it is gated in
 *     turn. The two attributes below are the whole of the gate's configuration, and
 *     `website/test/origins.mjs` holds the origin to the one the deployed policy admits.
 *   - **Storage that is refused is treated as no decision.** Reads and writes are wrapped,
 *     the write is read back (a private-mode browser may accept a write and keep nothing),
 *     and when the choice cannot be kept the banner stays, says so in a `role="status"`
 *     line, and loads nothing. The visitor is asked again rather than answered for.
 *   - **No focus trap, and no focus stolen.** The banner does not take focus on load, does
 *     not intercept Tab, and on a choice it moves focus to `<main>` — the content the
 *     visitor asked for — rather than leaving it on a control that has just vanished.
 *   - **Withdrawal.** On the privacy page the banner is offered even when a decision is
 *     stored (`alwaysOffer`), which is how consent is withdrawn: the one page that says how
 *     is the one page where the choice is always available again.
 *
 * The markup is emitted hidden and `site.js` reveals it: a browser that runs no script shows
 * no control it cannot honour, and loads nothing.
 */
interface Props {
  /** Offer the choice even when a decision is stored: the privacy page's job (withdrawal). */
  alwaysOffer?: boolean
  /** The analytics property the gate reports to, from `site.yaml` (W3.2). */
  measurementID: string
  /** The one third-party origin the gate may load from (D93, D106). */
  analyticsOrigin: string
}

const { alwaysOffer = false, measurementID, analyticsOrigin } = Astro.props

// The key the decision is stored under. It is written once, here: `site.js` reads it back out
// of the markup below, so the banner that writes the decision and the gate that reads it
// cannot drift apart, and there is no second literal anywhere.
const CONSENT_KEY = 'fugaro:analytics-consent'
---

<aside
  class="consent-banner"
  id="consent-banner"
  role="region"
  aria-label="Analytics consent"
  data-consent-key={CONSENT_KEY}
  data-consent-always={alwaysOffer ? 'true' : undefined}
  data-analytics-id={measurementID}
  data-analytics-origin={analyticsOrigin}
  hidden
>
  <div class="consent-banner__inner">
    <p class="consent-banner__text">
      This site counts page views with <strong>Google Analytics</strong>, a third-party script that sets identifiers in your browser, and it loads nothing from Google until you accept. <a href="/privacy/">What this site measures</a>
    </p>
    <div class="consent-banner__choices">
      <button type="button" class="consent-banner__button" data-consent="granted">Accept analytics</button>
      <button type="button" class="consent-banner__button" data-consent="denied">Decline analytics</button>
    </div>
    <p class="consent-banner__status" id="consent-banner-status" role="status" hidden>
      Your browser is not storing this choice, so this site cannot keep it: nothing is loaded from Google, and you will be asked again on your next visit.
    </p>
  </div>
</aside>

<style>
  /* A bar at the foot of the window, so the page a visitor asked for is not pushed around by
     a question about measurement. `.consent-banner` deliberately declares no `display`, so
     that the `hidden` attribute keeps it hidden; the rule below says so out loud, because a
     fixed-position element is exactly the one that grows a `display` later. Its `z-index` is
     the scale's chrome layer (tokens.css): the banner is fixed to the window's foot and has to
     be drawn over the page and over the header, whose own layer is named there too. */
  .consent-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: var(--z-chrome);
    padding: var(--space-md);
    /* The panel, since the bold redesign, and not the surface: the banner is a thing laid on
       the page rather than a band of it, and the redesign's step between the ground and the
       surface is what says so. It is drawn the same way every other raised thing on the site
       is — a panel, a hairline border and a radius — because a shadow is a colour literal no
       palette token holds (`src/styles/base.css`, section 2c). */
    background: var(--panel);
    color: var(--text);
    border-top: var(--border-width) solid var(--border);
  }

  .consent-banner[hidden] {
    display: none;
  }

  .consent-banner__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    max-width: var(--page-max);
    margin-inline: auto;
  }

  .consent-banner__text {
    margin: 0;
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .consent-banner__choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  /* One rule for both choices: the same control, at the same size, with nothing that makes
     one of them easier to press than the other. */
  .consent-banner__button {
    padding: var(--space-2xs) var(--space-md);
    border: var(--border-width) solid var(--accent);
    border-radius: var(--radius-lg);
    background: transparent;
    color: var(--accent-on-dark);
    font: inherit;
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .consent-banner__button:hover {
    background: var(--accent);
    color: var(--ground);
  }

  .consent-banner__status {
    flex-basis: 100%;
    margin: 0;
    color: var(--warn);
    font-size: var(--font-size-xs);
  }
</style>
