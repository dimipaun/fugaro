---
/**
 * website/src/components/Downloads.astro — the console's downloads section (website plan,
 * Task W1.6).
 *
 * This is the section the spec asks for as *"per-OS download links (placeholder until the
 * console ships)"*, and the console has **shipped**: `console/` holds the application, its
 * packaging and the workflow that signs, notarises and staples its macOS artifacts, that
 * workflow created the `console-v0.9.0` release, and `site.yaml`'s
 * `features.console_downloads` is true — so the section renders the release's own downloads
 * (W3.1, 2026-10-19). The placeholder it used to render is still here, and it is what the
 * unreleased branch below is: while `available` is false the section renders one sentence and
 * nothing a reader can follow, which is the state a copy of the repository is built into and
 * a test holds (`website/test/console.mjs`), rather than the state this checkout ships
 * (finding 23, finding 25, D95, Global Constraint 9).
 *
 * **The rule is structural, not editorial.** The two states are one `if`: the link list is
 * rendered from `downloads.json`'s `downloads` array and *only* when `available` is true,
 * and the unavailable branch has no element a reader can follow. That is what makes "the
 * placeholder carries no link and no button" a property of the component rather than a
 * promise about its copy — and the module that reads the data file refuses, in the build, a
 * flag that disagrees with `site.yaml`'s (W1.6 steps 1 and 2).
 *
 * **The URLs are derived, not stored.** Each entry carries the name the release *serves* its
 * asset under — the release's own files spell `Fugaro Console-X.Y.Z-universal.dmg` and GitHub
 * serves `Fugaro.Console-X.Y.Z-universal.dmg` — and `src/lib/console-downloads.mjs` composes
 * the URL from it, from the release's tag and from `site.yaml`'s repository. So no file under
 * `website/` carries a download URL at all, and a version bump moves every button (the owner's
 * changes spec of 2026-10-18, item 6; Global Constraint 9).
 *
 * The facts come in as props rather than being read here, because the module owns the one
 * reader for them: `website/src/pages/console.astro` loads and validates
 * `website/content/downloads.json`, and this component renders what it was handed. Nothing
 * below is typed into the markup: the note is the data file's own sentence, and each
 * label is the platform and the asset's own extension — the site invents no distribution
 * (D4, D11).
 *
 * **What a reader gets now that the console has shipped.** The release's own sentence
 * about the console (macOS only, one universal disk image and one archive, signed and
 * Apple-notarised, the CLI first because the CLI is the data plane), one link per published
 * asset with the SHA-256 the release recorded for its bytes beside it, and the command that
 * prints the checksum of the file a reader downloaded — in a command block, so a reader copies
 * it rather than selecting it by hand (D183, P6). All of it comes from the data file: the
 * checksum is the one fact here that is not derived, because it is a fact about bytes and no
 * build can compute it.
 */
import { copyControlHTML } from '../lib/copy-control.mjs'

interface DownloadFacts {
  /**
   * The data file's own id for the asset (`macos-dmg`): the key a per-platform block's
   * `assets` list names, which `console-downloads.mjs` resolves against this list. The
   * section filters on it when it draws a block's own rows under that block rather than
   * above it, so telling one row from another never needs the file names to be compared.
   */
  id: string
  /** What a reader sees on the link: the platform and the asset's extension (`macOS .dmg`). */
  label: string
  /** Where a reader downloads it from. Only ever rendered while `available` is true. */
  url: string
  /** The SHA-256 of the published bytes, printed beside the link to check a download with. */
  sha256: string
}

/**
 * A platform whose own artifact exists but whose facts the released sentence above does not
 * describe: Linux, whose build is unsigned and whose files are an AppImage and a `.deb` rather
 * than disk images (the owner's ruling of 2026-10-20; `docs/design/desktop-console.md` D10).
 */
interface PlatformFacts {
  /** The data file's own sentence for this platform — rendered, never restated here. */
  text: string
  /**
   * The data file's own entries for the assets this block links, in the file's order. Every id
   * the block names in `downloads.json` has been resolved to an entry of the file's `downloads`
   * list by `src/lib/console-downloads.mjs`, so a link here is always a link to an asset the
   * data file names — and the file refuses a block naming an id it does not carry.
   */
  downloads: DownloadFacts[]
}

interface Props {
  /** `downloads.json`'s `available`: the console's own artifact exists (W3.1 flipped it). */
  available: boolean
  /** The data file's `not_released` sentence, rendered while `available` is false. */
  note: string
  /**
   * The data file's `released` block: what the console is once it has shipped (macOS only,
   * signed and notarised, the CLI first) and the command that verifies a download. Rendered
   * while `available` is true, and rendered from the data file rather than written here.
   */
  released: { text: string; verify: string }
  /**
   * The data file's `downloads` entries: the release's published names, which the data file
   * carries from the day they are known and not only once the console ships. They are rendered
   * while `available` is true and never otherwise, which is what makes the unreleased state
   * structural rather than editorial.
   */
  downloads: DownloadFacts[]
  /**
   * The data file's optional per-platform block, or `null` when it carries none — which is the
   * state this checkout ships. It is rendered **only** when it is there, and while it is not
   * there this component draws nothing for it: no heading, no sentence, no link, and no word
   * saying which platform is missing. So the page's sentence about the platform the release
   * carries stays the only one it makes, without the markup having to say "and not Linux"
   * (`src/lib/console-downloads.mjs`, D10).
   */
  linux: PlatformFacts | null
}

const { available, note, released, downloads, linux } = Astro.props

// A label rather than a fact: the section's own heading, which is the navigation's word
// for this page and not a claim about the product (the layout's nav carries the same one).
const HEADING = 'Downloads'

// The assets a platform block links are rendered *under that block* and not in the list above
// it: one asset of a release is one row on the page, and a Linux artifact listed twice — once
// by the block that explains it and once by the sentence about the disk images — would be two
// links to one file with one of them under a sentence that does not describe it. With no block
// the list above is every asset the data file names, which is what the section renders today.
const inBlock = new Set((linux?.downloads ?? []).map((download) => download.id))
const listedAbove = downloads.filter((download) => !inBlock.has(download.id))
---

<section id="downloads" aria-labelledby="downloads-heading">
  <h2 id="downloads-heading">{HEADING}</h2>

  {
    available ? (
      <>
        {/* What the console is now that it has shipped: the platform, the signing and
            notarisation, and the CLI-first rule — the data file's own sentence, rendered
            rather than written here. */}
        <p class="downloads-released">{released.text}</p>

        <ul class="downloads">
          {listedAbove.map((download) => (
            <li>
              <a href={download.url} rel="noopener">
                {download.label}
              </a>{' '}
              {/* The published bytes' own checksum, beside the link it belongs to: a
                  reader who has the file can see whether what arrived is what the
                  release published, without trusting the transfer. The space above is a
                  fact and not a style: the two elements are inline, so a whitespace-only
                  text node between them is what Astro's compression drops — and the row
                  would read "macOS .dmga434f3…" (website/test/spacing.mjs holds it). */}
              <code class="download-sha256">{download.sha256}</code>
            </li>
          ))}
        </ul>

        {/* The command that checks a download, in the site's own command block so a
            reader copies it rather than selecting it by hand (D183, P6). */}
        <div class="command-block" data-copy>
          <Fragment set:html={copyControlHTML('Copy the checksum verification command')} />
          <pre><code>{released.verify}</code></pre>
        </div>

        {/* A platform whose artifact exists and whose facts the sentence above does not
            carry — Linux, unsigned, an AppImage and a `.deb` (D10). One expression and one
            condition: while the data file carries no block for it this renders nothing at
            all, and the rows it does render are the same rows as above, from the same
            entries, so a link here can only ever be an asset the data file names. */}
        {linux && (
          <div class="downloads-linux">
            <p>{linux.text}</p>
            <ul class="downloads">
              {linux.downloads.map((download) => (
                <li>
                  <a href={download.url} rel="noopener">
                    {download.label}
                  </a>{' '}
                  <code class="download-sha256">{download.sha256}</code>
                </li>
              ))}
            </ul>
          </div>
        )}
      </>
    ) : (
      <div class="downloads-unreleased">
        {/* One paragraph, and nothing else: while the console is unreleased this branch
            renders no `<a>` and no `<button>` — not because a rule says not to, but
            because there is no element here that could be one. That is the red step's
            fix, and website/test/console.mjs asserts it over the built page. */}
        <p>{note}</p>
      </div>
    )
  }
</section>
