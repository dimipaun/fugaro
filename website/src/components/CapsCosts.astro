---
/**
 * website/src/components/CapsCosts.astro — the caps-and-costs guide (website plan, Task W1.5;
 * reworked by the owner's brief of 2026-10-19; the bold redesign of 2026-10-21, from the
 * owner's approved board `website/design-ref/CapsAndCostsV2.dc.html`).
 *
 * The page answers two questions in this order, and the order is the point:
 *
 *   1. **What a job costs.** One card per kind of run, each with the sample size, the median,
 *      the middle half and the figure nine runs in ten stayed under, rendered from
 *      `website/data/typical-costs.yaml`, the owner's own measurement of this project's
 *      development runs. It is a hand-written fact file, and the page writes no figure of its
 *      own: every number below is the file's, and `website/test/caps-and-costs.mjs` fails on a
 *      figure the file does not carry or a figure the file carries that the page does not
 *      render (Global Constraint 6, D96, D97). Each card also draws its figures against the
 *      per-run cap as a bar, and **the bar's geometry is the file's figures divided by the
 *      file's cap** — the board's own arithmetic, computed here rather than drawn by hand, so
 *      a refreshed figure moves its own mark and a mark nothing supports cannot be drawn.
 *   2. **How to set the caps.** The commands are the detail and they sit below the figures, as
 *      one card each: the whole of `fugaro budget` is on the page, always visible. Every card
 *      is a `Usage:` line and a one-line description read out of
 *      `website/content/cli-reference.md` (W0.4, generated from the command tree), so the guide
 *      cannot print a flag the command does not ship and a renamed flag reaches this page the
 *      day the reference is regenerated (finding 26, Global Constraint 6). The page writes no
 *      command of its own — `website/test/caps-and-costs.mjs` asserts that nothing here carries
 *      `fugaro budget` outside an element the reference filled.
 *
 * **What the bold redesign changed, and what it removed.** The figures were a six-column table
 * whose rows were stacked by hand below the site's breakpoint (the owner's feedback of
 * 2026-10-19: "these render terrible on mobile"); they are three job cards now, each with its
 * figures as a `<dl>` of labelled rows, so the phone's layout is the markup's own shape rather
 * than a second reading of a table. The caps were six rows behind one `<details>`; they are six
 * cards, always open. And **the per-recipe ranges section is removed until there is data** (the
 * owner's ruling of 2026-10-21): `website/content/costs.json` is the owner-run aggregation's
 * output and is absent from this checkout, so the section rendered an empty state on every page
 * of the site, and a band that says nothing is worse than a band that is not there.
 * `website/test/caps-and-costs.mjs` holds the removal — a page that grows the band back has to
 * do it deliberately — and `src/content.ts` still validates the file if one is published.
 *
 * **The board's "Hide commands" toggle is not built.** It is the page's one control that needs
 * the site's script (`website/public/scripts/site.js`) to do anything, and this change touches
 * only this page's files: a button that toggles nothing is worse than no button, so the caps are
 * the board's expanded state and there is no toggle. It is recorded in the pull request.
 *
 * **What the page still does not do.** It does not restate the reference's long descriptions
 * (they carry the amounts' own bounds, which are the command's business and not a page's), and
 * it does not print a total no file carries. The cap the callout prints is the installation's,
 * not the product's: `fugaro budget set --per-run N` is what sets a per-run cap, the flag's
 * default is 0, which sets none, and an enforcing project with no per-run cap on any of the
 * three scopes refuses every lease (`internal/cli/budget.go`, and "Set caps" in
 * `docs/gcp-setup.md`). So the figure is Fugaro's own installation's cap, the one these runs
 * ran under, and the callout says whose it is rather than reading as something `fugaro` ships.
 *
 * **The board's own new lines** — the pill, the two calls to action, the bar legend and the
 * callout's label — are listed in the pull request for the owner to veto. Everything else a
 * reader reads is a file's: the job names, the counts and the figures are
 * `website/data/typical-costs.yaml`'s, the caps cards' names and descriptions are the generated
 * reference's, and the window line is the file's own window.
 */
import { loadSite } from '../content.ts'
import { copyControlHTML } from '../lib/copy-control.mjs'

const site = loadSite()

// The generated reference, as bytes. It is a required document of the content pipeline, so
// its header and its body have already been checked before this line runs (W1.3).
const reference = site.documents['cli-reference.md'].body

interface ReferenceCommand {
  /** The command path the reference's heading names, e.g. `fugaro budget set`. */
  path: string
  /** The reference's one-line description: cobra's own `Short`, as generated. */
  short: string
  /** The reference's `Usage:` line: cobra's own `Use` string, as generated. */
  usage: string
}

/**
 * The reference's budget sections: its heading, its one-line description and its usage
 * line. The generated document's shape is fixed by `internal/clidoc` (`## \`fugaro x\``,
 * then the short description, then the long one, then `Usage: \`...\``), and this reader
 * takes exactly those three facts and refuses to guess at anything else.
 */
function readReference(body: string): Map<string, ReferenceCommand> {
  const commands = new Map<string, ReferenceCommand>()
  const lines = body.split('\n')
  let current: ReferenceCommand | null = null
  let sawShort = false

  for (let i = 0; i < lines.length; i++) {
    const heading = /^## `(.+)`$/.exec(lines[i])
    if (heading) {
      if (current !== null) commands.set(current.path, current)
      current = { path: heading[1], short: '', usage: '' }
      sawShort = false
      continue
    }
    if (current === null) continue
    if (!sawShort) {
      // The first non-empty line under the heading is the command's one-line description.
      if (lines[i].trim() !== '') {
        current.short = lines[i].trim()
        sawShort = true
      }
      continue
    }
    if (current.usage === '' && lines[i].startsWith('Usage: `')) {
      current.usage = /^Usage: `(.+)`$/.exec(lines[i])?.[1] ?? ''
    }
  }
  if (current !== null) commands.set(current.path, current)
  return commands
}

const commands = readReference(reference)

/**
 * The commands the guide prints, in the order a reader meets them: the caps and the mode,
 * what is set now, the estimate before a batch runs, the price table behind it, and both
 * halves of the kill switch.
 *
 * The same array is the coverage the guide owes — every subcommand of `fugaro budget` the
 * reference carries, checked just below, so a subcommand added to the command tree cannot
 * be left off the page while the page says it prints the whole of the interface. What each
 * command does is the reference's own line, rendered beside it, and not a claim of this
 * file's.
 */
const GUIDE = [
  'fugaro budget set',
  'fugaro budget show',
  'fugaro budget preview',
  'fugaro budget prices',
  'fugaro budget kill',
  'fugaro budget resume',
]

/**
 * The guide's claim is coverage, so coverage is what is checked: the reference carries the
 * whole `fugaro budget` command tree, and a subcommand it has and this guide does not is a
 * sentence on the page that is false — the F50 class of defect, a public claim nothing
 * backs. The build stops rather than dropping a subcommand silently, which is why the page
 * may say it prints the whole of the interface. A subcommand added to the command is
 * carried by the regenerated reference and lands here, or the rebuild stops.
 */
const uncovered = [...commands.keys()].filter(
  (path) => path.startsWith('fugaro budget ') && !GUIDE.includes(path),
)
if (uncovered.length > 0) {
  throw new Error(
    `the CLI reference carries ${uncovered.join(', ')}, which the caps guide does not cover: this page prints the whole of the command's interface, so an omitted subcommand makes its own sentence false. Add it to GUIDE in website/src/components/CapsCosts.astro, or stop the page claiming coverage (W1.5).`,
  )
}

for (const path of ['fugaro budget', ...GUIDE]) {
  const command = commands.get(path)
  if (command === undefined || command.short === '' || command.usage === '') {
    throw new Error(
      `website/content/cli-reference.md carries no usable section for \`${path}\`: the caps guide prints the CLI reference's own usage lines and one-line descriptions, so a command the reference does not carry is a command this page cannot print. Regenerate the reference with \`go run ./internal/clidoc\` (W0.4, W1.5).`,
    )
  }
}

/** The figures the owner measured on this project's own runs. */
const typical = site.typicalCosts

/**
 * A figure as a reader reads it: dollars and cents, from the value the file carries. This is
 * padding and never rounding — `website/data/typical-costs.yaml` carries `1` for a dollar and
 * the page prints `$1.00` — and the loader makes that true rather than trusting it: a figure
 * that is not a whole number of cents is refused at the build (`asCents` in `src/content.ts`),
 * so there is no figure here for `toFixed` to round, and the test holds the printed figure to
 * the digits the file itself carries.
 */
function money(value: number): string {
  return `$${value.toFixed(2)}`
}

/**
 * A figure's position along its bar, as a percentage of the per-run cap: **the board's own
 * arithmetic** (each bar runs from nothing to the cap), computed from the file's figures
 * rather than drawn by hand, so a refreshed figure moves its own mark and a mark nothing
 * supports cannot be drawn. The viewBox is `0 0 100 22`, so a percentage is a coordinate.
 */
function along(value: number): number {
  return Number(((value / typical.perRunCapUSD) * 100).toFixed(2))
}

/** A dash where the file carries no figure: an absent figure is not a figure of zero. */
const DASH = '—'

/**
 * What one job's card draws, computed once: the four figures as the file spells them, the
 * bar's marks as coordinates, and the sentence the bar carries for a reader who cannot see
 * it. The sentence names the marks the bar actually draws — the review job has no middle
 * half and no worst run, and a label that promised them would describe a picture that is
 * not there.
 */
const JOBS = typical.jobs.map((job) => {
  const marks = ['the middle half', 'the median', 'nine runs in ten stayed under this']
  if (job.worstUSD !== null) marks.push('the worst run')
  return {
    id: job.id,
    name: job.name,
    runs: String(job.runs),
    median: money(job.medianUSD),
    middleHalf:
      job.middleHalfUSD === null
        ? null
        : {
            text: `${money(job.middleHalfUSD.low)}–${money(job.middleHalfUSD.high)}`,
            from: along(job.middleHalfUSD.low),
            width: Number((along(job.middleHalfUSD.high) - along(job.middleHalfUSD.low)).toFixed(2)),
          },
    nineInTen: { text: money(job.nineInTenUnderUSD), at: along(job.nineInTenUnderUSD) },
    worst: job.worstUSD === null ? null : { text: money(job.worstUSD), at: along(job.worstUSD) },
    medianAt: along(job.medianUSD),
    label: `${job.name} against our per-run cap: ${marks.slice(0, -1).join(', ')} and ${marks.at(-1)}.`,
  }
})

/**
 * The legend: the four marks a bar draws, each with the name of the figure it is. The names
 * are the same names the cards' rows carry, and the swatches are decoration — a reader who
 * cannot see the bar is told which mark is which by the bar's own label.
 */
const LEGEND = [
  { name: 'Middle half', mark: 'range' },
  { name: 'Median', mark: 'median' },
  { name: '9 in 10 under', mark: 'nine' },
  { name: 'Worst', mark: 'worst' },
]

/** The mode cards' glyphs: the board's two drawings, as the paths each one is made of. */
const MODE_GLYPHS: { [name: string]: string[] } = {
  observe: ['M2 12 C5 6 9 4 12 4 C15 4 19 6 22 12 C19 18 15 20 12 20 C9 20 5 18 2 12 Z', 'M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0'],
  enforce: ['M8 3 H16 L21 8 V16 L16 21 H8 L3 16 V8 Z', 'M8 12 H16'],
}

/**
 * The two modes, as the page's own two cards: the word is the flag's own value
 * (`--mode observe|enforce`, in the reference's usage line above) and the line is what the
 * mode does. The words and the lines are the board's, and they are the two lines of this
 * page a reader is asked to act on, so they are listed in the pull request with the rest.
 */
const MODES = [
  { id: 'observe', name: 'observe', line: 'Counts and logs.' },
  { id: 'enforce', name: 'enforce', line: 'Halts.' },
]
---

<section class="caps-hero" aria-labelledby="caps-title">
  {/* The board's background: the two soft glows and the grid behind the headline. It is
      decoration and says so, and it paints no text — the pattern is `base.css`'s
      `.hero-glow`, written once for the site. */}
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="caps-hero-copy">
    <p class="pill caps-pill">
      <span class="caps-pill-dot" aria-hidden="true"></span>
      What Fugaro's own jobs cost, and the commands that set the caps
    </p>

    <h1 class="caps-title display-xl" id="caps-title">
      Caps <span class="gradient-text">and costs</span>
    </h1>

    <p class="caps-lede">A cap is a ceiling on what a run may spend.</p>

    {/* The two things a reader can do here: read the figures, or go straight to the
        commands. The first is filled with the accent, which is the one colour on the page
        that means "this is the action"; the second is a quiet link, because two filled
        buttons are two primaries. */}
    <p class="caps-actions">
      <a class="caps-cta" href="#typical-costs">See what a job costs</a>
      <a class="caps-cta-quiet" href="#caps">Set the caps</a>
    </p>
  </div>

  <ul class="caps-modes">
    {
      MODES.map((mode) => (
        <li class="card caps-mode" data-mode={mode.id}>
          <span class="caps-mode-glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              {MODE_GLYPHS[mode.id].map((d) => (
                <path d={d} />
              ))}
            </svg>
          </span>
          <span class="caps-mode-text">
            <code class="caps-mode-name">{mode.name}</code>
            <span class="caps-mode-line">{mode.line}</span>
          </span>
        </li>
      ))
    }
  </ul>
</section>

<section id="typical-costs" class="caps-band" aria-labelledby="caps-costs-title">
  <div class="caps-band-head">
    <h2 class="display-lg caps-band-title" id="caps-costs-title">What a job costs</h2>
    <p class="caps-window">
      Fugaro's own runs, {typical.from} to {typical.to}: {typical.runs} finished, model plus compute, an estimate.
    </p>
  </div>

  {/* One card per kind of run the file carries, in the file's own order. Every figure in a
      card is the file's, printed as the file carries it and never rounded. */}
  <ul class="caps-jobs">
    {
      JOBS.map((job) => (
        <li class="card caps-job" data-job={job.id}>
          <h3 class="caps-job-name">{job.name}</h3>
          <p class="caps-job-runs">
            Runs <strong class="caps-job-runs-value">{job.runs}</strong>
          </p>

          <p class="caps-job-median">
            <span class="caps-job-median-label">Median</span>
            <span class="caps-job-median-value">{job.median}</span>
          </p>

          <dl class="caps-job-figures">
            <div class="caps-figure-row">
              <dt>Middle half</dt>
              <dd>{job.middleHalf === null ? DASH : job.middleHalf.text}</dd>
            </div>
            <div class="caps-figure-row">
              <dt>9 in 10 under</dt>
              <dd>{job.nineInTen.text}</dd>
            </div>
            <div class="caps-figure-row">
              <dt>Worst</dt>
              <dd>{job.worst === null ? DASH : job.worst.text}</dd>
            </div>
          </dl>

          {/* The bar: the track is the per-run cap, and each mark is one of the figures
              above it, placed by the arithmetic in `along()` rather than by hand. */}
          <svg
            class="caps-bar"
            viewBox="0 0 100 22"
            preserveAspectRatio="none"
            role="img"
            aria-label={job.label}
            focusable="false"
          >
            <rect class="caps-bar-track" x="0" y="8" width="100" height="6" rx="3" />
            {job.middleHalf !== null && (
              <rect
                class="caps-bar-range"
                x={job.middleHalf.from}
                y="8"
                width={job.middleHalf.width}
                height="6"
              />
            )}
            <rect class="caps-bar-median" x={job.medianAt} y="3" width="0.8" height="16" />
            <rect class="caps-bar-nine" x={job.nineInTen.at} y="5" width="0.6" height="12" />
            {job.worst !== null && <rect class="caps-bar-worst" x={job.worst.at} y="5" width="0.8" height="12" />}
            <rect class="caps-bar-cap" x="99.2" y="2" width="0.8" height="18" />
          </svg>
        </li>
      ))
    }
  </ul>

  <div class="caps-key-row">
    <div class="card caps-key">
      <p class="caps-key-title">Each bar runs to our per-run cap</p>
      <dl class="caps-key-items">
        {
          LEGEND.map((item) => (
            <div class="caps-key-item">
              <dt>{item.name}</dt>
              <dd>
                <span class="caps-key-mark" data-mark={item.mark} aria-hidden="true" />
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    {/* The cap, which is the installation's own and not a default `fugaro` ships: the callout
        says whose it is. */}
    <p class="card caps-cap" data-cap>
      <span class="caps-cap-glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M12 3 L20 6 V12 C20 16.5 16.5 20 12 21 C7.5 20 4 16.5 4 12 V6 Z" />
        </svg>
      </span>
      <span class="caps-cap-text">
        <span class="caps-cap-label">Our per-run cap</span>
        <span class="caps-cap-value">{money(typical.perRunCapUSD)}</span>
      </span>
    </p>
  </div>

  <p class="caps-note">
    Mostly DeepSeek through OpenRouter; a Claude model costs more. Not a quote: the caps below
    are the safety net.
  </p>
</section>

<section id="caps" class="caps-band" aria-labelledby="caps-commands-title">
  <div class="caps-band-head">
    <h2 class="display-lg caps-band-title" id="caps-commands-title">Set the caps</h2>
  </div>

  <ul class="caps-commands">
    {
      GUIDE.map((path) => {
        const command = commands.get(path)
        return (
          <li class="card caps-command" data-guide={path}>
            <h3 class="caps-command-name">{command?.short}</h3>
            <div class="command-block" data-copy>
              <Fragment set:html={copyControlHTML('Copy the usage line')} />
              <code class="usage" data-command={command?.usage}>
                {command?.usage}
              </code>
            </div>
          </li>
        )
      })
    }
  </ul>
</section>

<style>
  /* The page's own box. Every space, radius, size and colour below is a token from
     `src/styles/tokens.css` or the palette, and nothing here is a colour literal (D104,
     D105). The card, the pill, the display scale, the gradient and the command block are
     `base.css`'s, written once for the site; what is this page's own is the layout. */
  .caps-band {
    padding-block: var(--space-2xl);
    border-top: var(--border-width) solid var(--border);
  }

  .caps-band-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
  }

  .caps-band-title {
    margin: 0;
  }

  .caps-window,
  .caps-note {
    margin: 0;
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--font-size-base);
    line-height: var(--leading-normal);
  }

  /* ---- the hero -------------------------------------------------------------------------- */

  /* The board's first screen: the promise on the left and the two modes on the right, over
     the glow the site's hero uses. `position: relative` and `overflow: hidden` are what the
     glow layer needs (`base.css`, section 2c). */
  .caps-hero {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    padding-block: var(--space-sm) var(--space-2xl);
  }

  .caps-hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    min-width: 0;
  }

  .caps-pill {
    font-size: var(--font-size-sm);
  }

  /* The pill's dot: the warning tone, which is the colour that asks a reader to pay
     attention, and the caps are what this page is about. A mark and not text, so it carries
     no pair of its own. */
  .caps-pill-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--warn);
  }

  /* `base.css`'s `.display-xl`, with the board's own line break: `max-width: 20ch` keeps the
     two words of the headline on two lines rather than running the width of the page. */
  .caps-title {
    max-width: 20ch;
  }

  .caps-lede {
    margin: 0;
    max-width: 34rem;
    font-size: var(--font-size-xl);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  .caps-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    margin: var(--space-2xs) 0 0;
  }

  /* The primary: the accent as a fill and the ground as its label, which is the pair
     `a11y.mjs` computes at 4.5:1 for a label a reader reads, at the 44 px minimum every
     control on the site keeps. */
  .caps-cta {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 44px;
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-lg);
    background: var(--accent);
    color: var(--ground);
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-black);
    text-decoration: none;
  }

  /* The second action is a link, not a second button: it keeps the underline `base.css` gives
     every link in running text, so it reads as a link at a glance rather than as a disabled
     control beside the filled one — and it is a control all the same, so it carries the same
     44 px minimum. */
  .caps-cta-quiet {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 44px;
    font-size: var(--font-size-base);
    font-weight: var(--weight-semibold);
  }

  /* The two modes: one card each, and the enforce card tinted with the warning tone, which
     is the one that stops a run. */
  .caps-modes {
    position: relative;
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    max-width: none;
    list-style: none;
  }

  .caps-mode {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .caps-mode[data-mode='enforce'] {
    border-color: var(--warn);
    background-image: linear-gradient(135deg, var(--panel) 0%, var(--surface) 70%);
  }

  /* The glyph's box: the panel, one step under the card it is drawn on. It is decoration and
     the name beside it is the point, so it is `aria-hidden` in the markup. */
  .caps-mode-glyph {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--space-xl);
    height: var(--space-xl);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--panel);
    color: var(--accent-on-dark);
  }

  .caps-mode[data-mode='enforce'] .caps-mode-glyph {
    color: var(--warn);
  }

  .caps-mode-glyph svg {
    width: var(--space-md);
    height: var(--space-md);
  }

  .caps-mode-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-width: 0;
  }

  .caps-mode-name {
    background: none;
    padding: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--weight-black);
    color: var(--accent-on-dark);
  }

  .caps-mode[data-mode='enforce'] .caps-mode-name {
    color: var(--warn);
  }

  .caps-mode-line {
    font-size: var(--font-size-lg);
    line-height: var(--leading-snug);
  }

