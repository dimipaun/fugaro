---
/**
 * website/src/components/HomeRunBand.astro — the run, as the homepage's one section about it
 * (the owner's rulings of 2026-10-23, the redesign's Step 3, lever 1: "the run as ONE section
 * instead of the three overlapping explainers").
 *
 * **What it is.** The heading "How a task becomes a pull request", the run's four steps, and a
 * real picture beside each step: the zoom diagrams `/how-it-works/` draws in full, from the
 * developer's view down to the inside of one job, and the console's run screen for the pull
 * request a run ends in. On a wide screen each picture stays in place while its step is read
 * (`position: sticky` inside the step's own row, so it needs no script), and the next step's
 * picture takes over as the reader scrolls on. On a phone each step is followed by its picture.
 *
 * **Every word of it is already held to a document.** The four step names and the line under
 * each one are `RunDiagram.astro`'s own (its `BOXES` names and four of its `LABELS`), held to the
 * documents they cite at build time in `src/lib/run-labels.mjs`. The zoom diagrams' names and alt
 * texts are `src/lib/zoom-levels.mjs`'s, the same ones `/how-it-works/` uses; the console
 * screen's are `website/data/console-screens.yaml`'s.
 *
 * The section pads below itself and not above, because every top-level block of the homepage
 * pads the gap below itself once (`website/test/base-styles.mjs`'s `homeRhythmFailures`).
 */
import { loadConsoleScreens } from '../content.ts'
import { BOXES, LABELS } from '../lib/run-labels.mjs'
import { LEVELS } from '../lib/zoom-levels.mjs'

const RUN_SCREEN = loadConsoleScreens().screens.find((screen) => screen.src.endsWith('/console-run.webp'))
if (!RUN_SCREEN) {
  throw new Error(
    'website/src/components/HomeRunBand.astro: website/data/console-screens.yaml lists no console-run.webp row, and the run section shows that screen beside the pull request step.',
  )
}

const level = (id: string) => {
  const found = LEVELS.find((entry) => entry.id === id)
  if (!found) throw new Error(`website/src/components/HomeRunBand.astro: src/lib/zoom-levels.mjs has no ${id}.`)
  return { src: found.src, alt: found.alt, width: 2560, height: 1440, caption: found.name }
}

const STEPS = [
  { name: BOXES[0].name, line: LABELS.howItStarts, done: false, picture: level('level-3') },
  { name: BOXES[1].name, line: LABELS.yourCredential, done: false, picture: level('level-2') },
  { name: BOXES[2].name, line: LABELS.oneExecution, done: false, picture: level('level-1') },
  {
    name: BOXES[3].name,
    line: LABELS.checkpoint,
    done: true,
    picture: { src: RUN_SCREEN.src, alt: RUN_SCREEN.alt, width: RUN_SCREEN.width, height: RUN_SCREEN.height, caption: 'The console’s run screen' },
  },
]
---

<section class="home-run" data-reveal-block aria-labelledby="home-run-title">
  <h2 class="home-run-title display-lg" id="home-run-title">How a task becomes a pull request</h2>

  {/* The run's four steps, in order: an `ol` because it is a sequence, and the order is shown
      by position rather than by a printed number. */}
  <ol class="home-run-steps">
    {
      STEPS.map((step) => (
        <li class="home-run-step" data-state={step.done ? 'done' : undefined}>
          <div class="home-run-words">
            <h3 class="home-run-step-name">{step.name}</h3>
            <p class="home-run-step-line" data-source={step.line.source}>
              {step.line.text}
            </p>
          </div>
          <figure class="home-run-figure">
            <figcaption class="home-run-caption">{step.picture.caption}</figcaption>
            <img
              class="home-run-image"
              src={step.picture.src}
              alt={step.picture.alt}
              width={step.picture.width}
              height={step.picture.height}
              loading="lazy"
              decoding="async"
            />
          </figure>
        </li>
      ))
    }
  </ol>

  {/* The link to the page that draws the run whole. It is a control a reader taps, so it carries
      the 44 px minimum the owner's brief measures every control against
      (`website/test/home.mjs`'s `controlTargetFailures`). */}
  <p class="home-run-more">
    <a class="home-run-link" href="/how-it-works/">See the whole run on How it works</a>
  </p>
</section>

<style>
  /* Tokens only (W1.2). The band is a field one tone step above the ground, the width of the
     page, with no rule above or below it (lever 5: hairlines become tone steps). */
  .home-run {
    padding: var(--space-3xl) var(--frame-gutter);
    margin-bottom: var(--space-4xl);
    background: var(--panel);
  }

  .home-run-title {
    margin: 0 0 var(--space-2xl);
    max-width: 16ch;
  }

  .home-run-steps {
    display: grid;
    max-width: none;
    gap: var(--space-2xl);
    margin: 0 0 var(--space-xl);
    padding: 0;
    list-style: none;
  }

  .home-run-step {
    display: grid;
    gap: var(--space-md);
  }

  .home-run-step-name {
    margin: 0 0 var(--space-xs);
    color: var(--text);
    font-size: var(--font-size-2xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  /* The last step is the one that finished: its name is the green that means "finished". */
  .home-run-step[data-state='done'] .home-run-step-name {
    color: var(--ok);
  }

  .home-run-step-line {
    margin: 0;
    max-width: 36ch;
    color: var(--text);
    font-size: var(--font-size-lg);
    line-height: var(--leading-normal);
  }

  .home-run-figure {
    margin: 0;
    min-width: 0;
  }

  .home-run-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--radius-sm);
    background: var(--ground);
  }

  .home-run-caption {
    margin: 0 0 var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .home-run-more {
    margin: 0;
  }

  .home-run-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-on-dark);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-semibold);
  }

  /* The wide composition: each step is a row of two parts on a 5/7 split, the words on the left
     and the picture on the right. The row is taller than the picture, and the picture is sticky
     inside it, so it holds while its step is read and the next row's picture takes its place. */
  @media (min-width: 64rem) {
    .home-run-steps {
      gap: 0;
    }

    .home-run-step {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: var(--space-2xl);
      min-height: 72vh;
    }

    .home-run-words {
      padding-top: 14vh;
    }

    .home-run-figure {
      position: sticky;
      top: 12vh;
    }
  }
</style>
