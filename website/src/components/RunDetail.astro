---
/**
 * website/src/components/RunDetail.astro — the run, step by step (website changes spec of
 * 2026-10-18, item 4: "HOW IT WORKS page: opens with the SAME diagram (one shared component,
 * not two copies), then adds the detailed explanation underneath, so it reads as a zoom-in").
 *
 * The page opens with `ArchitectureDiagram.astro` — its four steps and one short line each,
 * and the one page that renders it since the owner's approved draft of 2026-10-19 ("Home,
 * draft 2 (slider)") took the flow off the homepage — and this is what comes under it: the
 * five steps README.md's `## How it works` numbers, in that section's own words, and the one
 * line of `docs/design/v1.md` §6.1 that says where the boundary of a run is. A reader who has
 * read the four boxes gets the detail of what happens inside them; a reader who stops at the
 * picture has still been told the run.
 *
 * **Why the lines are quotations rather than a page written for the reader.** Global
 * Constraint 6 and D102: every sentence the site publishes is traceable to a document of
 * this repository, and a page that summarised the run in its own words would be a second
 * description of it to keep in step with README.md. So each step's line is a substring of
 * the step it belongs to, `comparable()` at build time holds it there in the section's order
 * — a step quoted out of order, or a line that only paraphrases one, stops the build naming
 * the file — and `website/test/home.mjs` makes the same check against the built page. The
 * trust-boundary line cites the design document, which is where the sentence is written.
 *
 * **The steps are one list.** Each step is a list item with its own heading, so a screen
 * reader reads five steps in the section's order; nothing here is a picture, and nothing
 * depends on a font, a colour or an animation to be read.
 *
 * **And the list is one vertical timeline** (the owner's feedback of 2026-10-19: "The run,
 * step by step section does not look good"). What it was: the five steps were a
 * `repeat(auto-fit, minmax(18rem, 1fr))` grid, so a desktop read three blocks beside two with
 * a hole in the last row, a tablet read two-by-two, and nothing joined one step to the next —
 * five short paragraphs in boxes, which is a list of facts rather than a run. What it is now:
 * one column at every width, each step a numbered marker on a rail with a one-pixel line drawn
 * from it down to the marker below, and the step's name and its line in the column beside the
 * rail. The line is drawn by the step's own `::before` and not by the list, because it has to
 * stop at the last step: the geometry is `top` at the marker's own height and `bottom` at the
 * step's, so the segment between two steps is exactly the step's own bottom padding — and the
 * last step draws none. `website/test/base-styles.mjs` reads the three claims that shape makes
 * (one column at 360, 768 and 1280; a line that joins the steps and stops at the last one —
 * every declaration that makes it exist, take it out of the flow and land it on the rail
 * included; and nothing in the section wider than a phone's content box) and refuses each of
 * them being broken.
 */
import { readFileSync } from 'node:fs'
import path from 'node:path'
import { REPO_ROOT } from '../content.ts'

const HOW_IT_WORKS = 'README.md#How it works'
const DESIGN = 'docs/design/v1.md'

/**
 * A string with its markdown markers and its whitespace removed: how a line and the section
 * it claims to come from are compared, the same reading `ArchitectureDiagram.astro` uses.
 * Emphasis and code spans are markers rather than text, so a line quoted here is the
 * section's sentence with `**Start**` read as `Start`.
 */
function comparable(document: string): string {
  return document.replace(/[`*]/g, '').replace(/\s+/g, '')
}

/** One `## <heading>` section of README.md, up to the next `## `. */
function readmeSection(heading: string): string {
  const readme = readFileSync(path.join(REPO_ROOT, 'README.md'), 'utf8')
  const start = readme.indexOf(`\n## ${heading}\n`)
  if (start === -1) {
    throw new Error(
      `website/src/components/RunDetail.astro: README.md carries no "## ${heading}" section, and the page's steps are quoted from it (changes spec 2026-10-18, item 4). Either the section was renamed or the steps moved.`,
    )
  }
  const rest = readme.slice(start + 1)
  const next = rest.indexOf('\n## ', 1)
  return next === -1 ? rest : rest.slice(0, next)
}

const SOURCES: { [name: string]: string } = {
  [HOW_IT_WORKS]: readmeSection('How it works'),
  [DESIGN]: readFileSync(path.join(REPO_ROOT, 'docs/design/v1.md'), 'utf8'),
}

/**
 * README.md's five numbered steps, each as the step's own bold words and a line of the step.
 * The names are the section's (`Start`, `Sync`, `Loop`, …) rather than headings written for
 * the page, and each line is the part of the step that says what happens in it; the whole of
 * step 4 is a paragraph of `git.pr.checkpoints` instructions that belongs in the
 * documentation rather than on a page.
 */
const STEPS = [
  {
    name: 'Start',
    line: "from the image of the repository's workflow (a named build-and-test setup in its fugaro.yaml)",
  },
  {
    name: 'Sync',
    line: 'Sync to the exact target commit and restore the dependency caches.',
  },
  {
    name: 'Loop',
    // The step's whole sentence: the loop is implement, verify and review, for as many rounds
    // as the repository configures, and the tail is the part of it that says the rounds repeat
    // (the owner's feedback of 2026-10-19 names the review and fix rounds as a step of the run).
    line: 'Claude Code implements, writes tests, runs the build and tests through a recording wrapper, reviews and fixes, for as many review rounds as configured.',
  },
  {
    name: 'Push and open the pull request',
    line: 'a draft opens at the first push (marked not verified), and it is marked ready only when the run passes',
  },
  {
    name: 'Write caches back and exit',
    line: 'The run record and the PR remain; the container does not.',
  },
]

/**
 * The line under the steps: where the boundary of a run is. It is `docs/design/v1.md` §6.1's
 * opening sentence, and it is the one fact of the picture the steps do not state.
 */
const NOTE = 'The trust boundary is the container, not the process.'

// Hold every line to the section it cites, in that section's order: the steps are the
// section's steps, and `cursor` walks forward through it, so a line quoted out of order —
// which would put the pull request before the loop — stops the build with the file's name in
// the message.
//
// A step's name and its line are both searched from where the step before it ended, and the
// cursor moves to the end of the *line*: the section writes `**Sync** to the exact target
// commit…`, so the line begins inside the name, and a cursor advanced past the name would sit
// past the start of the line that belongs to it.
{
  const section = comparable(SOURCES[HOW_IT_WORKS])
  let cursor = 0
  for (const [index, step] of STEPS.entries()) {
    let end = cursor
    for (const [what, line] of [
      ['name', step.name],
      ['line', step.line],
    ] as const) {
      const quoted = comparable(line)
      const at = section.indexOf(quoted, cursor)
      if (at === -1) {
        throw new Error(
          `website/src/components/RunDetail.astro: step ${index + 1}'s ${what} ${JSON.stringify(line)} is not a line of README.md's "## How it works" at or after the step before it, and the page's steps are that section's own words in its own order (changes spec 2026-10-18, item 4; Global Constraint 6).`,
        )
      }
      end = Math.max(end, at + quoted.length)
    }
    cursor = end
  }
}

if (!comparable(SOURCES[DESIGN]).includes(comparable(NOTE))) {
  throw new Error(
    `website/src/components/RunDetail.astro: the note ${JSON.stringify(NOTE)} is not a line of ${DESIGN}, and the page quotes the design document rather than describing it (Global Constraint 6).`,
  )
}

/** The step's own words as a slug, for the attribute `website/test/home.mjs` reads. */
function slug(name: string): string {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
}
---

<section class="run-detail" aria-labelledby="run-detail-title" data-source="README.md#How it works">
  <h2 class="run-detail-title" id="run-detail-title">The run, step by step</h2>

  <ol class="run-steps">
    {
      STEPS.map((step, index) => (
        <li class="run-step" data-step={slug(step.name)} data-source="README.md#How it works">
          {/* The step's place in the run, on the rail: the list carries the order, so this is
              decoration and a screen reader reads the `<ol>` instead. It is a sibling of the
              step's heading rather than inside it, because it is a column of the step's own
              grid — the rail the line is drawn down — and the heading and its line are the
              column beside it. */}
          <span class="run-step-number" aria-hidden="true">{index + 1}</span>
          <div class="run-step-body">
            <h3 class="run-step-name">{step.name}</h3>
            <p class="run-step-line">{step.line}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <p class="run-note" data-source="docs/design/v1.md">{NOTE}</p>
</section>

<style>
  /* Tokens only (W1.2), and the same accent vocabulary the diagram above uses, so the two
     read as one page: the steps are quieter than the picture — the picture is what the
     section is for — and the accent here is the markers' outline rather than their fill,
     which is the whole of the difference.

     **The detail takes the page's column, not the measure.** The review of this branch saw
     the zoom-in below the picture drawn as a narrow left column: the five steps are an
     `<ol>`, `base.css` holds a list to `--measure` (68 ch, about 578 px at the body's 17 px),
     and each line inside it carried the same cap again — so two thirds of the column the
     picture above fills were empty beside the detail of it. The list declares `max-width:
     none` for the same reason the flow's does (see `ArchitectureDiagram.astro`).

     **And it starts at the page's own left edge** (review round 3, item 3d). This rule used
     to carry `var(--space-md)` of inline padding of its own — 24 px on top of the gutter
     `main` already gives it — so "The run, step by step" and the five steps under it were
     indented 24 px relative to the `h1` and to the picture between them, which is the defect
     the review measured. The vertical padding stays: the space above the heading is the
     breathing room between the picture and the detail of it.

     **The run is one column, at every width** (the owner's feedback of 2026-10-19). There is
     no breakpoint in this stylesheet and nothing here needs one: the timeline is the same
     shape at 360 px as at 1280, which is what a sequence reads as. The widths the shape is
     read at are `website/test/base-styles.mjs`'s, and the grid's single track is declared
     rather than left implicit so that the one-column rule is a declaration a check can read.
     `minmax(0, 1fr)` and not `1fr`: the track may shrink below its longest unbreakable line,
     which is the same guard `base.css` gives every box in `main`. */
  .run-detail {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-2xl) 0 var(--space-3xl);
  }

  /* The heading over the timeline. Its room under it is `--space-lg`, the same 32 px that
     separates two steps, so the heading sits in the run's own rhythm rather than in one of its
     own: the title, the five markers and the note then read down one column at one spacing.
     This was `--space-md` while the steps were a grid, where the title opened a row of boxes
     rather than a sequence. **It is written down here rather than gated**, because a gap
     between 24 and 32 px is a preference and not a defect a reader would see — the claims
     `website/test/base-styles.mjs` reads are all of the second kind — and this is the one place
     a later round can find the reason for the value. */
  .run-detail-title {
    margin: 0 0 var(--space-lg);
    font-family: var(--font-sans);
    font-size: var(--font-size-2xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
  }

  .run-steps {
    /* See the block comment above: the list is the page's width — an `<ol>` inherits
       `base.css`'s measure otherwise — and it is one column of it. */
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A step: the rail and its marker in the first column, the step's name and its line in the
     second. `align-items: start` is what keeps a long line off the marker's box — the marker
     is a fixed square and stretches nowhere — and the step's own bottom padding is the room
     between it and the step below, which the line below is drawn down. */
  .run-step {
    position: relative;
    display: grid;
    grid-template-columns: var(--space-lg) minmax(0, 1fr);
    align-items: start;
    column-gap: var(--space-md);
    padding-bottom: var(--space-lg);
  }

  .run-step:last-child {
    padding-bottom: 0;
  }

  /* The line between two steps, drawn by the step above: `top` is the marker's own height —
     the line starts where the marker ends — and `bottom` is the step's own edge, which is the
     next step's top, where its marker begins. So the segment a reader sees between two markers
     is exactly the room the step above carries, and the last step, which has no step below it,
     draws none: there is no line hanging off the end of the run. `--border` is the site's
     separator — one pixel of it against the ground — and it is deliberately the quiet half of
     the picture: the markers carry the accent and the rail joins them. */
  .run-step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: var(--space-lg);
    bottom: 0;
    left: calc(var(--space-lg) / 2);
    width: var(--border-width);
    margin-left: calc(var(--border-width) / -2);
    background: var(--border);
  }

  /* The marker: the step's number in a drawn circle, one step of the rail's own width so that
     the line above and below it meet its centre. Outlined in the accent rather than filled —
     the picture above is what the page opens with, and five filled dots under it would
     compete with it — and `box-sizing: border-box` keeps the outline inside that width, which
     is the whole reason the line is centred on it. */
  .run-step-number {
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: var(--space-lg);
    height: var(--space-lg);
    border: var(--border-width) solid var(--accent);
    border-radius: var(--radius-pill);
    background: var(--ground);
    color: var(--accent-on-dark);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    line-height: 1;
  }

  /* What the step says: the name over its line, packed from the top of the column the grid
     gives them — `align-content: start`, because a step the grid has stretched would centre
     the two against a height they do not have — and `min-width: 0`, so the column may shrink
     below its longest unbreakable word the way `base.css` lets every box in `main` do. The
     name's own box is the next rule's: its `min-height` is the marker's, which is what puts
     the first line of a step on the marker's centre. */
  .run-step-body {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    min-width: 0;
  }

  .run-step-name {
    display: flex;
    align-items: center;
    min-height: var(--space-lg);
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
    /* A name longer than its column — a future step the section words in one long word —
       breaks rather than running out of the page. */
    overflow-wrap: anywhere;
  }

  .run-step-line {
    margin: 0;
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);
    overflow-wrap: anywhere;
  }

  /* The one fact under the steps, in the column their own lines are in: the section then
     reads as one column — the title and the rail at the page's left edge, every line of the
     run from the same place — and the note is set off from them by the room above it rather
     than by a rule, so it closes the timeline instead of joining it. */
  .run-note {
    margin: var(--space-xl) 0 0 calc(var(--space-lg) + var(--space-md));
    max-width: var(--measure);
    color: var(--text);
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);
  }
</style>
