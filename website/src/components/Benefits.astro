---
/**
 * website/src/components/Benefits.astro — the benefits (the owner's feedback of
 * 2026-10-19; README.md's `## Why Fugaro`).
 *
 * The brief: "we need a section with Benefits or somesuch as we have in the README, no?" So
 * the section is the README's own list of reasons, one line each — the four names the README
 * gives them, and for each one a sentence out of the paragraph that reason is argued in. This
 * page writes no benefit of its own: every name and every line is the README's, held to it
 * here at build time, which is what keeps a section whose whole job is to persuade from
 * becoming the one place on the site that says something the repository does not (Global
 * Constraint 6, D102: a page renders a fact and never restates one).
 *
 * **Four reasons, and no fifth.** `reasons()` below reads the README's `**N. Name.**`
 * paragraphs in the order the README writes them, and the build stops if the page does not
 * render exactly those: a reason the README drops, or one this page quietly leaves out, is a
 * section whose list is neither the README's nor shorter than it — and taking only the
 * claims the code and the docs support is a choice about *this* list, which is why the four
 * below are the four the repository backs, each named here with the document that carries it:
 *
 *   1. *Safe by construction* — the run is a throwaway container in the reader's own cloud
 *      project, so it does not read their laptop (`README.md## How it works`,
 *      `docs/design/v1.md`).
 *   2. *Scale out, and walk away* — one job execution per task, up to `max_parallel`
 *      (`README.md`, the same section, and `docs/design/v1.md`).
 *   3. *Team control in one place* — the project layer publishes the shared policy every
 *      repository inherits (`docs/project-layer.md`).
 *   4. *The newest tools and models, ready to use* — one pinned base image, and the model
 *      chosen per role (`docs/base-image.md`, `docs/multi-model.md`).
 *
 * **Why a line cites its own reason and not the section.** The four paragraphs are one
 * section, so a line held to the section alone could be moved from the reason above it to
 * the one below and still be a quotation, while the page then sold the reader the wrong
 * sentence under the wrong name. Each line is therefore read against the paragraph its own
 * reason is written in, and `website/test/home.mjs` makes the same check against the built
 * page from outside the build.
 *
 * **The names are the README's, with the number off.** `**1. Safe by construction.**` is a
 * list in the README and a heading here, and the number goes because the grid's own order is
 * the order: a number in front of a name is the README's device for counting reasons, and a
 * reader of the page counts four boxes. The names are marked up as `h3` under the section's
 * `h2`, so a screen reader gets four headings under one, in the README's order.
 */
import { readFileSync } from 'node:fs'
import path from 'node:path'
import { REPO_ROOT } from '../content.ts'

/**
 * A string with its markdown markers and its whitespace removed: how a line and the
 * paragraph it claims to come from are compared, the same reading the other components use.
 * Emphasis and code spans are markers rather than text, and where a document breaks a line
 * is its layout rather than its words.
 */
function comparable(document: string): string {
  return document.replace(/[`*]/g, '').replace(/\s+/g, '')
}

/**
 * One `## <heading>` section of README.md, up to the next `## ` — the same reader
 * `website/test/home.mjs` uses, so the build and the check resolve a section the same way.
 * A heading the README does not carry is a defect in this file rather than in the README:
 * the section cites it by name, and a renamed heading has to fail here, naming itself.
 */
function readmeSection(heading: string): string {
  const readme = readFileSync(path.join(REPO_ROOT, 'README.md'), 'utf8')
  const start = readme.indexOf(`\n## ${heading}\n`)
  if (start === -1) {
    throw new Error(
      `website/src/components/Benefits.astro: README.md carries no "## ${heading}" section, and the benefits are the reasons that section argues (the owner's feedback of 2026-10-19). Either the section was renamed or the page moved off it.`,
    )
  }
  const rest = readme.slice(start + 1)
  const next = rest.indexOf('\n## ', 1)
  return next === -1 ? rest : rest.slice(0, next)
}

/** The document the section is quoted from, as every message about it names it. */
const SOURCE = 'README.md#Why Fugaro'

/**
 * The reasons a section argues, in the order it writes them: each `**N. Name.**` paragraph,
 * as its name and the paragraph whole — the paragraph because a line is held to its own
 * reason and not to the section. A `## Why Fugaro` that stopped writing its reasons as
 * numbered bold paragraphs is a defect in this file's reader rather than in the README, and
 * it fails here with the section's name on the message.
 */
function reasons(section: string): { name: string; paragraph: string }[] {
  const out: { name: string; paragraph: string }[] = []
  for (const block of section.split(/\n{2,}/)) {
    const match = /^\*\*\d+\.\s*(.+?)\.\*\*/.exec(block.trim())
    if (match) out.push({ name: match[1], paragraph: block })
  }
  if (out.length === 0) {
    throw new Error(
      `website/src/components/Benefits.astro: ${SOURCE} carries no "**N. Name.**" reason paragraph, and the benefits are those paragraphs read in order (the owner's feedback of 2026-10-19). Either the section was rewritten or this reader is out of date.`,
    )
  }
  return out
}

const REASONS = reasons(readmeSection('Why Fugaro'))

/**
 * The four reasons the page renders, in the README's order: the name the README gives each
 * one, and one line of the paragraph it is argued in. Nothing here is written for the page —
 * `line` is a sentence of the README's own reason paragraph, and the loop below is what
 * makes that true of the artifact rather than of this file.
 */
const BENEFITS = [
  { name: 'Safe by construction', line: 'The agent does not run on your machine.' },
  { name: 'Scale out, and walk away', line: 'Each task is its own job execution' },
  { name: 'Team control in one place', line: 'Policy lives in the project, not on each laptop.' },
  { name: 'The newest tools and models, ready to use', line: 'You choose the model per role' },
]

// Hold every benefit to the reason it is, in the reason's own paragraph, here, so a
// paraphrase — or a line that moved from the reason above it to the one below — stops the
// build naming the file rather than reaching a reader as the repository's own words.
{
  if (BENEFITS.length !== REASONS.length) {
    throw new Error(
      `website/src/components/Benefits.astro: the page renders ${BENEFITS.length} benefit(s) and ${SOURCE} argues ${REASONS.length}: the section is the README's reasons, and one dropped is a claim the README makes that the page does not (the owner's feedback of 2026-10-19).`,
    )
  }
  for (const [index, benefit] of BENEFITS.entries()) {
    const reason = REASONS[index]
    const position = index + 1
    if (reason.name !== benefit.name) {
      throw new Error(
        `website/src/components/Benefits.astro: benefit ${position} is called ${JSON.stringify(benefit.name)} and ${SOURCE}'s reason ${position} is called ${JSON.stringify(reason.name)}: the page renders the README's reasons in the README's order, with the numbers off (the owner's feedback of 2026-10-19).`,
      )
    }
    if (!comparable(reason.paragraph).includes(comparable(benefit.line))) {
      throw new Error(
        `website/src/components/Benefits.astro: benefit ${position}'s line ${JSON.stringify(benefit.line)} is not in ${SOURCE}'s reason ${position}, and every line of the benefits is a sentence of the reason its name names rather than one written for the page (the owner's feedback of 2026-10-19; Global Constraint 6). Either the reason was reworded or the line was edited.`,
      )
    }
  }
}
---

<section class="home-benefits" aria-labelledby="benefits-title" data-source={SOURCE}>
  <h2 class="benefits-title" id="benefits-title">Benefits</h2>
  <ul class="benefit-list">
    {
      BENEFITS.map((benefit) => (
        <li class="benefit">
          <h3 class="benefit-name">{benefit.name}</h3>
          <p class="benefit-line">{benefit.line}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Tokens only (W1.2): the section names the palette, the spacing scale, the type scale and
     the radii, and defines none of them.

     **The section's own gutter and its room below are declared here, in this component's rule**
     (review round 6). They were in `src/pages/index.astro`'s `.home-chat, .home-flow,
     .home-benefits` rule, and Astro scopes a page's selector to the elements the page renders:
     the `<div class="home-chat">` and `<div class="home-flow">` carry the page's scope, and this
     `<section>` is rendered by this component and carries `Benefits.astro`'s — so the page's
     rule never matched the section, the section kept no padding at all, and its text ran edge to
     edge on a phone. The rule is where the element is rendered, the same as `Hero.astro`'s and
     `HomeInstall.astro`'s; and it is one block's rule rather than the page's three, so a block
     that pads both sides of a gap is now visible in one file. The gap is padded once: this
     section pads below itself and not above, which is what
     `website/test/base-styles.mjs`'s `homeRhythmFailures` refuses a pair of blocks for. */
  .home-benefits {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-md) var(--space-3xl);
  }

  .benefits-title {
    margin: 0 0 var(--space-md);
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
  }

  /* The grid, and its one departure from the site's measure. `base.css` holds lists to the
     measure (`:where(p, ul, ol, dl, blockquote, figcaption) { max-width: var(--measure) }`),
     and two columns of a 68 ch box is a column of two words. The list is not prose; it is
     the section's grid, and it is as wide as the page's column — the same escape, and the
     same reason, as the flow's own list. */
  .benefit-list {
    max-width: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg) var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Two columns from 40 rem up: four reasons read as a two-by-two rather than as a column
     of four, and the column repeats rather than `auto-fit`, so the grid is the same shape at
     every width above the breakpoint instead of re-flowing into a row of three and a
     widow. */
  @media (min-width: 40rem) {
    .benefit-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* The benefit: a name and its one line, with the site's own separator above them rather
     than a card or an icon — the brief asks for "a small grid or list, no icons required",
     and a rule is what the site already draws between things that are not one thing. */
  .benefit {
    padding-top: var(--space-sm);
    border-top: var(--border-width) solid var(--border);
  }

  .benefit-name {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: var(--weight-semibold);
    color: var(--text);
    /* A name longer than its column breaks rather than running out of it. */
    overflow-wrap: anywhere;
  }

  /* The line, muted: `--text-muted` on `--ground` is a pair `a11y.mjs` computes at 4.5:1 in
     all four palettes, the same requirement as body text rather than a decorative grey. */
  .benefit-line {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-base);
    line-height: var(--leading-normal);
    overflow-wrap: anywhere;
  }
</style>
