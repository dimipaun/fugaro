---
/**
 * website/src/components/Hero.astro — the hero (website plan, Task W1.4; the owner's redesign
 * Step 3, rulings of 2026-10-23, levers 2 and 3).
 *
 * The first screen says what Fugaro is and lets the reader see it happen:
 *
 *   1. **The headline is README.md's line**, read through the content pipeline (W1.3) and
 *      rendered byte for byte, in one colour (lever 2: no gradient text), at a size that keeps
 *      it to two lines at every width.
 *   2. **The supporting sentence is README.md's next line** (D102, Global Constraint 6).
 *   3. **One action: Get started** (lever 2). How it works and the console are reached from the
 *      sections below, which is where the run and the console are shown.
 *   4. **The live card** (lever 3): the request `src/lib/agent-request.mjs` holds, the jobs it
 *      launches and the pull requests they end in, in the words `fugaro watch` prints. With no
 *      script it is the static picture of that one request; `public/scripts/site.js` reveals a
 *      text field and redraws the jobs for whatever task the reader types. It is captioned as
 *      an illustration, because it is one.
 *   5. **The real picture**: the `fugaro watch` capture, large, beside and under the card.
 *   6. **The video slot is empty while `site.yaml` says the video does not exist** (D107).
 *
 * **The card prints no `<pre>`.** `website/test/home.mjs` refuses a `<pre>` in the hero: the
 * command a reader copies is the install block at the foot of the page.
 */
import { readFileSync } from 'node:fs'
import path from 'node:path'
import { loadHomeScreens, loadSite, REPO_ROOT } from '../content.ts'
import { REQUEST, REQUEST_SOURCE } from '../lib/agent-request.mjs'

const site = loadSite()
const facts = site.facts

/** A string with its markdown markers and its whitespace removed: how a line and the
 *  document it claims to come from are compared, the reading every component of this site
 *  uses. */
function comparable(document: string): string {
  return document.replace(/[`*]/g, '').replace(/\s+/g, '')
}

// The headline: the pipeline reads README.md's tagline line, under its "# Fugaro" title,
// and it is the page's `h1` (F48, D102; changes spec item 2).
const tagline = site.tagline

const LEAD = site.subline

// The prompt line: the request `src/lib/agent-request.mjs` holds, which is where the line is
// held to the changes spec it is quoted from (the owner's feedback of 2026-10-19; Global
// Constraint 6). `data-source` names that document, and `website/test/home.mjs` reads the
// attribute and holds the line to it from outside the build.
const PROMPT = REQUEST

/**
 * The number of jobs the card draws, which is the request's own number and not a figure of
 * this file's: the request says `three bug fixes`, and a card that launched a different
 * number of them would be the picture disagreeing with the line above it.
 */
const NUMBER_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine']
const JOBS = 3

// Hold the card's job count to the request. It is a build-time refusal rather than a test-time
// one, because it is this file's own composition out of another document's words: a card that
// promised a number the request does not name is the page saying something no document of this
// repository says (Global Constraint 6).
{
  const count = NUMBER_WORDS[JOBS]
  if (!comparable(PROMPT).includes(comparable(count))) {
    throw new Error(
      `website/src/components/Hero.astro: the hero's card launches ${JOBS} jobs and the request it draws, ${JSON.stringify(PROMPT)}, does not name ${JSON.stringify(count)}: the card is a picture of the request above it, and a picture of a different number of jobs is the page contradicting itself (Global Constraint 6).`,
    )
  }
}

// The video slot's flag. Read from site.yaml rather than assumed, so the day the video
// exists this component changes in one place and the flag is what decides (D107).
const videoExists = facts.features.video


/** The pull request the card's rows are drawn with, inline and `currentColor`, so the card
 *  fetches nothing for its drawing. `public/scripts/site.js` draws the same shape when it
 *  rebuilds the rows for a task the reader types. */
const PR_GLYPH =
  '<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M6 8.5v7"/><path d="M18 15.5V11a3 3 0 0 0-3-3h-4"/><path d="m13 6-2 2 2 2"/>'

const ROWS = Array.from({ length: JOBS }, (_, index) => index + 1)

/**
 * The largest number of jobs the live card launches for a typed task: README.md's own default
 * for `max_parallel` ("up to `max_parallel`, 20 by default"). It is held to the README here
 * and handed to the script as an attribute, so the script names no figure of its own.
 */
const MAX_PARALLEL = 20
{
  const readme = readFileSync(path.join(REPO_ROOT, 'README.md'), 'utf8')
  if (!comparable(readme).includes(comparable(`up to \`max_parallel\`, ${MAX_PARALLEL} by default`))) {
    throw new Error(
      `website/src/components/Hero.astro: README.md no longer says max_parallel is ${MAX_PARALLEL} by default, and the hero's live card caps a typed task's jobs at that figure (Global Constraint 6).`,
    )
  }
}

/** The capture beside the card: the `fugaro watch` screen, the real terminal capture the
 *  homepage's data file lists, with its alt text from there. */
const WATCH = loadHomeScreens().screens.find((screen) => screen.src.endsWith('/fugaro-watch.png'))
if (!WATCH) {
  throw new Error(
    'website/src/components/Hero.astro: website/data/home-screens.yaml lists no fugaro-watch.png row, and the hero shows that capture with the alt text the row carries.',
  )
}
---

<section class="hero" aria-labelledby="hero-tagline">
  <div class="hero-copy">
    <h1 class="hero-tagline display-xl" id="hero-tagline">{tagline}</h1>

    <p class="hero-lead" data-source="README.md">{LEAD}</p>

    {/* The one action on the first screen (lever 2): filled with the accent, the one colour on
        the page that means "this is the action". */}
    <p class="hero-actions">
      <a class="hero-cta" href="/getting-started/">Get started</a>
    </p>
  </div>

  {/* The stage: one flat field one tone step above the ground, its top-left corner cut, holding
      the live card and the real capture. */}
  <div class="hero-stage">
    {/* The live card (lever 3). `data-ui` marks a fragment of the product's own interface: inside
        it the product's conventions apply. `data-live-run` is the hook the script reads, with the
        request's own job count and README.md's `max_parallel` default as its configuration. With
        no script the card is the static picture of the one request, and the field stays hidden. */}
    <figure class="hero-shot" data-ui data-live-run data-live-max={MAX_PARALLEL}>
      <div class="hero-shot-frame">
        <p class="hero-shot-name">Your agent</p>
        <div class="hero-shot-body">
          <p class="hero-prompt" data-source={REQUEST_SOURCE} data-live-prompt>
            <span class="hero-prompt-mark" aria-hidden="true">&gt;</span>
            {PROMPT}
          </p>
          <div class="hero-ask" data-live-ask hidden>
            <label class="hero-ask-label" for="hero-task">Type a task</label>
            <textarea class="hero-ask-field" id="hero-task" rows="2" spellcheck="false" data-live-field>{PROMPT}</textarea>
          </div>
          <p class="hero-shot-status" data-live-status role="status">
            <span class="hero-shot-status-mark" aria-hidden="true"></span>
            <span data-live-status-text>Fugaro: launching {JOBS} jobs</span>
          </p>
          <ol class="hero-shot-jobs" data-live-jobs>
            {
              ROWS.map((row) => (
                <li class="hero-shot-job">
                  <svg
                    class="hero-shot-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <Fragment set:html={PR_GLYPH} />
                  </svg>
                  <span class="hero-shot-job-name">Pull request {row} of {JOBS}</span>
                  <span class="hero-shot-stage">ready for review</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
      <figcaption class="hero-shot-caption">
        An illustration, not a recording of a session.
      </figcaption>
    </figure>

    {/* The real picture (lever 2): the `fugaro watch` capture at its own size, cropped by the
        stage rather than shrunk until it cannot be read. It is on the first screen, so it loads
        eagerly. */}
    <figure class="hero-watch">
      <div class="hero-watch-crop">
        <img
          class="hero-watch-image"
          src={WATCH.src}
          alt={WATCH.alt}
          width={WATCH.width}
          height={WATCH.height}
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <figcaption class="hero-watch-caption">
        <code>fugaro watch</code>, the live screen of spend, repositories and running agents.
      </figcaption>
    </figure>
  </div>

  {
    videoExists && (
      <div class="hero-video" data-source="website/data/site.yaml">
        {/* W2.4 renders the explainer video here when site.yaml says it exists (D107). */}
      </div>
    )
  }
</section>

<style>
  /* Tokens only (W1.2): this component names the palette, the spacing scale, the type scale and
     the radii, and defines none of them.

     **The hero's own gutter and its room below are declared here**, like the page's other
     top-level blocks: `main:has(> .hero)` drops `main`'s padding on this page, so every block
     carries its own, and the gap between two blocks is the block above's own bottom padding
     (`website/test/base-styles.mjs`'s `homeRhythmFailures`). The gutter is the header's, so the
     headline starts on the wordmark's left edge and the two margins are equal. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    padding: var(--space-xl) var(--frame-gutter) var(--space-4xl);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  /* The headline: `base.css`'s `.display-xl`, in the text tone. `max-width` in `ch` is what
     breaks README.md's four words into two lines of two, never three. */
  .hero-tagline {
    max-width: 14ch;
    font-size: clamp(2.5rem, 10.5vw, var(--font-size-6xl));
  }

  /* The supporting sentence: directly under the headline, in the full ink. */
  .hero-lead {
    margin: var(--space-lg) 0 0;
    max-width: 30ch;
    font-size: var(--font-size-xl);
    line-height: var(--leading-snug);
    color: var(--text);
  }

  .hero-actions {
    margin: var(--space-lg) 0 0;
  }

  /* The primary action: the accent as the fill and the ground as the label, the pair
     `a11y.mjs` computes at 4.5:1. `min-height: 44px` is the target size the owner's brief of
     2026-10-19 measures every control against. Square-ish corners, decided once for the page's
     buttons (the install button is the same shape). */
  .hero-cta {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 52px;
    padding: var(--space-xs) var(--space-lg);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--ground);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-black);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }

  .hero-cta:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-cta:hover {
      background: var(--accent-on-dark);
    }
  }

  /* The stage: a flat field one tone step above the ground, its top-left corner cut. It holds
     the card and the capture, and it crops the capture at its right and bottom edges. */
  .hero-stage {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    min-width: 0;
    padding: var(--space-lg) 0 0 var(--space-md);
    overflow: hidden;
    background: var(--panel);
    clip-path: polygon(3rem 0, 100% 0, 100% 100%, 0 100%, 0 3rem);
  }

  /* The card. Inside `data-ui` the product's own conventions hold: the terminal's small type,
     its tone steps. */
  .hero-shot {
    margin: 0;
    max-width: 34rem;
    padding-right: var(--space-md);
  }

  .hero-shot-frame {
    border-radius: var(--radius-md);
    background: var(--surface);
    overflow: hidden;
  }

  .hero-shot-name {
    margin: 0;
    padding: var(--space-2xs) var(--space-sm);
    background: var(--border);
    color: var(--text);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
  }

  .hero-shot-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm);
  }

  .hero-prompt {
    margin: 0;
    color: var(--text);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-semibold);
  }

  .hero-prompt-mark {
    margin-right: var(--space-2xs);
    color: var(--accent-on-dark);
  }

  .hero-ask {
    display: grid;
    gap: var(--space-3xs);
  }

  .hero-ask[hidden] {
    display: none;
  }

  .hero-ask-label {
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  /* The field the reader types the task into: a real form field, so it keeps its edge (the
     house rules leave form fields their lines). 17 px or more, so a phone does not zoom. */
  .hero-ask-field {
    box-sizing: border-box;
    width: 100%;
    min-height: 3.5rem;
    padding: var(--space-2xs) var(--space-xs);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--ground);
    color: var(--text);
    font: inherit;
    font-size: var(--font-size-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    resize: vertical;
  }

  .hero-ask-field:focus-visible {
    border-color: var(--accent);
  }

  .hero-shot-status {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    color: var(--warn);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
  }

  .hero-shot-status-mark {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--warn);
  }

  .hero-shot-jobs {
    display: grid;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-shot-job {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-sm);
    background: var(--panel);
    color: var(--text);
    font-size: var(--font-size-sm);
  }

  .hero-shot-icon {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--ok);
  }

  .hero-shot-job-name {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* The stage the run is at, in the words `fugaro watch` prints. The finished state is the
     green that means "finished"; the script marks a row that is still working. */
  .hero-shot-stage {
    flex: none;
    color: var(--ok);
    font-size: var(--font-size-sm);
  }

  .hero-shot-job[data-stage='working'] .hero-shot-stage {
    color: var(--text-muted);
  }

  .hero-shot-job[data-stage='working'] .hero-shot-icon {
    color: var(--text-muted);
  }

  .hero-shot-caption,
  .hero-watch-caption {
    margin: var(--space-2xs) 0 0;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .hero-watch {
    margin: 0;
    min-width: 0;
  }

  /* The capture at its logical size (2918 px taken at 2x, so 1459 px wide), cropped at the
     stage's right edge on a narrow screen rather than shrunk until it cannot be read. */
  .hero-watch-crop {
    overflow: hidden;
  }

  .hero-watch-image {
    display: block;
    width: 1459px;
    max-width: none;
    height: auto;
  }

  .hero-watch-caption {
    padding-bottom: var(--space-md);
  }

  /* The signature move (the dealt "shutter image"): the capture opens from its top edge while
     the picture inside settles from a slight scale, once, as the page loads. It needs no script,
     and a reader who asks for less motion gets the end state at once (the layout's global
     reduced-motion rule). */
  @media (prefers-reduced-motion: no-preference) {
    .hero-watch-crop {
      animation: hero-shutter 1100ms var(--ease-out) 200ms both;
    }

    .hero-watch-image {
      animation: hero-settle 1500ms var(--ease-out) 200ms both;
    }

    .hero-shot-job[data-arrive] {
      animation: hero-arrive var(--duration-base) var(--ease-out) both;
    }
  }

  @keyframes hero-shutter {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0);
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.12);
      transform-origin: left top;
    }
    to {
      transform: none;
      transform-origin: left top;
    }
  }

  @keyframes hero-arrive {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 64rem) {
    /* The wide composition: the headline's column on the left, the stage on the right half
       holding the card, and the capture running under both across the stage's full width. */
    .hero {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: start;
      column-gap: var(--space-xl);
      padding-top: var(--space-2xl);
    }

    .hero-tagline {
      font-size: clamp(4rem, 5.6vw, 5.5rem);
    }

    .hero-stage {
      padding: var(--space-xl) 0 0 var(--space-xl);
      clip-path: polygon(5rem 0, 100% 0, 100% 100%, 0 100%, 0 5rem);
    }

    .hero-watch-image {
      width: 1100px;
    }
  }
</style>
