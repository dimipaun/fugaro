---
/**
 * website/src/components/Hero.astro — the hero (website plan, Task W1.4).
 *
 * The first screen of the site, and the one place where a marketing site is most tempted to
 * write its own words. So it writes none:
 *
 *   1. **The tagline is README.md's line**, read through the content pipeline (W1.3) and
 *      rendered byte for byte — not typed in here, which is what the red step of this task
 *      was (F48, D102).
 *   2. **The lead sentence is README.md's sentence** rather than a paraphrase, for the same
 *      reason: every sentence the site publishes is traceable to a document, and a sentence
 *      written for the page is the one nobody maintains (D102, Global Constraint 6).
 *   3. **The install commands are `website/data/install.yaml`'s commands**, rendered from
 *      the file rather than copied out of it (W0.1, W1.4 step 1). Each path also renders the
 *      note that file carries, so the dev-only path says so where it is offered.
 *   4. **The video slot is empty while `site.yaml` says the video does not exist** (D107):
 *      no player, no poster, no play button, nothing to click that plays nothing. W2.4 flips
 *      the flag and fills the slot in the same commit.
 *
 * The terminal below is `Terminal.astro`, which is the other half of the hero (step 2). The
 * hero holds no fact of its own: what it renders, it reads.
 */
import { loadSite } from '../content.ts'
import { copyControlHTML } from '../lib/copy-control.mjs'
import Terminal from './Terminal.astro'

const site = loadSite()
const facts = site.facts
const install = site.install

// The tagline: the pipeline reads it from under README.md's "# Fugaro" title (F48, D102).
const tagline = site.tagline

// One sentence of what Fugaro is. It is README.md's own sentence, kept whole: the sentence
// that follows the Latin gloss rather than a shorter one written here, because the site
// publishes the README's words and `website/test/home.mjs` holds this one to the README.
const LEAD =
  'Fugaro runs long, self-contained coding-agent loops (implement, test, review, fix, compile, open a pull request) in throwaway cloud containers instead of on your laptop.'

// The two install paths the hero shows: the two that install the CLI with a command. The
// archive and the cosign block are on the getting-started page, where their notes have room
// (W1.5) and where a reader who has decided to install goes.
const HERO_PATHS = ['homebrew', 'go-install']
const paths = HERO_PATHS.map((id) => {
  const found = install.paths.find((candidate) => candidate.id === id)
  if (!found) {
    // The pipeline validated the file; this is the other failure, and it is this component's
    // own: the paths named above are the ones this page renders, and one of them is gone.
    throw new Error(
      `website/src/components/Hero.astro: website/data/install.yaml carries no install path with id "${id}", which the hero renders`,
    )
  }
  return found
})

// The video slot's flag. Read from site.yaml rather than assumed, so the day the video
// exists this component changes in one place and the flag is what decides (D107).
const videoExists = facts.features.video
---

<section class="hero" aria-labelledby="hero-tagline">
  <h1 class="hero-tagline" id="hero-tagline">{tagline}</h1>

  <p class="hero-lead" data-source="README.md">{LEAD}</p>

  {/* The page's first section, and the reason it has one (P5): the lead is the promise
      above it and nothing else, so the gist a reader gets before scrolling is the promise,
      and the commands are the section under it rather than part of the lead. The heading
      is what makes the install block a section at all — the tagline, the promise and the
      first command are the first screen, and the section is where the reader who has read
      the promise lands. */}
  <h2 class="hero-install-title" id="hero-install-title">Install</h2>

  <div class="hero-install" data-source="website/data/install.yaml">
    {
      paths.map((path) => (
        <div class="hero-install-path" data-path={path.id} data-source={path.source}>
          <p class="hero-install-name">{path.name}</p>
          {/* Written on one line: whitespace inside `<pre>` is shown, so an indented
              template would indent the command on the page. The control beside it is
              `src/lib/copy-control.mjs`'s markup, emitted `hidden` and revealed by the
              site's script (P6, D183). */}
          {path.commands.map((command) => (
            <div class="command-block" data-copy>
              <Fragment set:html={copyControlHTML('Copy the install command')} />
              <pre class="hero-install-command"><code>{command}</code></pre>
            </div>
          ))}
          {path.note && <p class="hero-install-note">{path.note}</p>}
        </div>
      ))
    }

    <p class="hero-install-more">
      <a href="/getting-started/">Every install path, and what each one sets up</a>
    </p>
  </div>

  <Terminal />

  {
    videoExists && (
      <div class="hero-video" data-source="website/data/site.yaml">
        {/* W2.4 renders the explainer video here when site.yaml says it exists (D107). */}
      </div>
    )
  }
</section>

<style>
  /* Every value below is a design token (W1.2): this component names the palette, the
     spacing scale, the type scale and the radii, and defines none of them. A component that
     carried a colour of its own would be a second palette to keep in step, and a component
     that named a token the layer does not declare — a `--weight-bold` where the layer stops
     at `--weight-semibold`, say — is a style that silently does not apply at all, because an
     undefined `var()` makes the whole declaration invalid rather than falling back. Every
     name below is declared in `src/styles/tokens.css`, and `website/test/home.mjs` holds the
     built pages to that. */
  .hero {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hero-tagline {
    margin: 0;
    max-width: var(--measure);
    font-family: var(--font-sans);
    /* The tagline is the page's `h1`, and on a phone it is the first thing that has to fit:
       at the desktop size (`--font-size-4xl`, 56px) the sentence runs to six lines and its
       own bottom lands below a 390 × 844 first screen, so the promise under it and the
       first install command were both below the fold (RF5's measurement, P5). The shape is
       the one the layout's own `h1` rule takes — `clamp(2xl, 6vw, …)`, so a phone gets
       `--font-size-2xl` and a wide viewport gets the rule's upper end — but the upper end
       here is the hero's own: this tagline is already the site's largest type at 56px
       (`--font-size-4xl`), and reading it at the layout's `--font-size-3xl` (44px, what
       every other page's `h1` takes above about 733px) would shrink the one loud line on
       the one page whose whole job is the promise, which is a design change and not P5's.
       What sits between 6vw and the ends is where the two rules agree; what they do at the
       wide end is the hero's, on purpose. */
    font-size: clamp(var(--font-size-2xl), 6vw, var(--font-size-4xl));
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    font-weight: var(--weight-semibold);
    color: var(--text);
  }

  /* The heading that opens the install section: a section label rather than a second
     headline, so the tagline stays the page's one loud line. It is an `h2` all the same —
     that is what makes the block a section, what ends the page's lead at the promise, and
     what a reader navigating by headings lands on next. Its spacing is the hero's own gap,
     which is why it carries no margin. */
  .hero-install-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-muted);
  }

  .hero-lead {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--font-size-lg);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .hero-install {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .hero-install-path {
    flex: 1 1 22rem;
    padding: var(--space-md);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--ground);
  }

  .hero-install-name {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
  }

  .hero-install-command {
    margin: 0;
    padding: var(--space-xs) var(--space-sm);
    overflow-x: auto;
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .hero-install-note {
    margin: var(--space-2xs) 0 0;
    font-size: var(--font-size-xs);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .hero-install-more {
    flex: 1 1 100%;
    margin: 0;
    font-size: var(--font-size-sm);
  }
</style>
