---
/**
 * website/src/components/Hero.astro — the hero (website plan, Task W1.4; the owner's approved
 * board `website/design-ref/HomeV3.dc.html`, 2026-10-20).
 *
 * The first screen of the site, and the one place where a marketing site is most tempted to
 * write its own words. So it writes almost none:
 *
 *   1. **The headline is README.md's line**, read through the content pipeline (W1.3) and
 *      rendered byte for byte — not typed in here, which is what the red step of this task
 *      was (F48, D102). It is `Lambdas for coding agents` since the changes spec of
 *      2026-10-18 (item 2), and it is the README's line that says so. The board draws its
 *      last two words in the accent's gradient, so the line is **split** here rather than
 *      rewritten: the split is computed from the tagline itself (below), which is what keeps
 *      the rendered headline the README's line and not a second copy of it with a `<span>` in
 *      the middle.
 *   2. **The subline is README.md's next line**, for the same reason (D102, Global
 *      Constraint 6).
 *   3. **The prompt line is the request, and nothing else around it.** It is the one string
 *      `src/lib/agent-request.mjs` holds — a quotation of the changes spec — and it is drawn
 *      inside the board's terminal card rather than beside the headline, because the board
 *      puts it there: the card is what the reader is looking at, and the line is what the
 *      card is a picture of.
 *   4. **The status pill's words are the README's too.** `Ephemeral cloud jobs` is the
 *      subline's own first three words and `in your own Google Cloud project` is the README's
 *      phrase for where a run happens; both are held to the README below rather than typed
 *      into the markup as a claim of this file's own.
 *   5. **The card's job count is the request's own number.** The board draws three rows and
 *      a line saying three jobs are launching, and three is not this file's choice: the
 *      request says `three bug fixes`, and the guard below refuses a count the request does
 *      not name. A card that promised a different number of pull requests from the request
 *      above it would be the page contradicting itself.
 *   6. **The card is captioned as an illustration.** The board draws the caption, and it is
 *      the one line of the card that is the site's own — it says what the picture is, which
 *      no document can say for it. It is listed with the page's other new lines in the pull
 *      request for the owner to veto.
 *   7. **The video slot is empty while `site.yaml` says the video does not exist** (D107).
 *   8. **The latest-release line is the changelog's own data** (the owner's request of
 *      2026-10-22): the tag is the newest release file the plugin's version says is published,
 *      read at build time, so the line names no version this file holds and follows the tree
 *      when a release lands. It is the one line above the pill and above the `h1`, which is
 *      where the page's lead — the text between the `h1` and the first `h2` — does not reach.
 *
 * **The card is not a command block and prints no `<pre>`.** `website/test/home.mjs` refuses
 * a `<pre>` in the hero: the hero is the promise and its call to action, and the command a
 * reader runs is the install block at the foot of the page. So the prompt line is a `<p>` in
 * the mono face — a picture of a line a reader types, not a thing to copy.
 *
 * **The console is the call to action's third link, and the flag is what renders it** (the
 * owner's brief of 2026-10-19, item 6; `site.yaml`'s `features.console_downloads`).
 */
import { readFileSync } from 'node:fs'
import path from 'node:path'
import { loadSite, REPO_ROOT } from '../content.ts'
import { REQUEST, REQUEST_SOURCE } from '../lib/agent-request.mjs'
import { buildChangelog } from '../lib/changelog.mjs'

const site = loadSite()
const facts = site.facts

/** A string with its markdown markers and its whitespace removed: how a line and the
 *  document it claims to come from are compared, the reading every component of this site
 *  uses. */
function comparable(document: string): string {
  return document.replace(/[`*]/g, '').replace(/\s+/g, '')
}

// The headline: the pipeline reads README.md's tagline line, under its "# Fugaro" title,
// and it is the page's `h1` (F48, D102; changes spec item 2).
const tagline = site.tagline

/**
 * The two halves of the headline: the words before the gradient, and the words in it. The
 * board draws `Lambdas for` in the text tone and `coding agents` in the accent's gradient,
 * and **the split is taken from the tagline** rather than written here, so the `h1` a reader
 * receives is still one string of the README's with markup around its last words. Two words
 * is the board's split, and a tagline of two words or fewer is a defect in this file rather
 * than a headline with an empty first half.
 */
const GRADIENT_WORDS = 2
const words = tagline.split(/\s+/).filter(Boolean)
if (words.length <= GRADIENT_WORDS) {
  throw new Error(
    `website/src/components/Hero.astro: README.md's tagline ${JSON.stringify(tagline)} is ${words.length} word(s), and the hero draws its last ${GRADIENT_WORDS} in the accent's gradient: a headline with nothing before the gradient is the split this file was written for, and the tagline moved.`,
  )
}
const HEADLINE_HEAD = words.slice(0, -GRADIENT_WORDS).join(' ')
const HEADLINE_GRADIENT = words.slice(-GRADIENT_WORDS).join(' ')

// The subline: the one sentence under the headline, read from the same place and rendered
// whole — the hero's lead, the site's default description and the cards' description are
// one string in the README rather than three copies of a sentence typed here (changes spec
// item 2, D102). `website/test/home.mjs` holds this page to the README's line, and
// `website/test/layout.mjs` holds the head to the same one.
const LEAD = site.subline

// The prompt line: the request `src/lib/agent-request.mjs` holds, which is where the line is
// held to the changes spec it is quoted from (the owner's feedback of 2026-10-19; Global
// Constraint 6). `data-source` names that document, and `website/test/home.mjs` reads the
// attribute and holds the line to it from outside the build.
const PROMPT = REQUEST

/**
 * The status pill, in the README's own words: `Ephemeral cloud jobs` is the subline's first
 * three words, and `in your own Google Cloud project` is the README's phrase for where a run
 * happens. The board writes the two together and so does this line — what makes it the
 * repository's rather than this file's is the guard below.
 */
const PILL = 'Ephemeral cloud jobs, in your own Google Cloud project'

/**
 * The number of jobs the card draws, which is the request's own number and not a figure of
 * this file's: the request says `three bug fixes`, and a card that launched a different
 * number of them would be the picture disagreeing with the line above it.
 */
const NUMBER_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine']
const JOBS = 3

// Hold the pill to README.md, and the card's job count to the request. Both are build-time
// refusals rather than test-time ones, because both are this file's own composition out of
// another document's words: a pill that stopped being the README's phrase, or a card that
// promised a number the request does not name, is the page saying something no document of
// this repository says (Global Constraint 6).
{
  const readme = readFileSync(path.join(REPO_ROOT, 'README.md'), 'utf8')
  for (const phrase of ['Ephemeral cloud jobs', 'in your own Google Cloud project']) {
    if (!comparable(readme).includes(comparable(phrase))) {
      throw new Error(
        `website/src/components/Hero.astro: README.md does not carry ${JSON.stringify(phrase)}, and the hero's pill is written out of the README's own words (Global Constraint 6). Either the README was reworded or the pill moved off it.`,
      )
    }
  }
  const count = NUMBER_WORDS[JOBS]
  if (!comparable(PROMPT).includes(comparable(count))) {
    throw new Error(
      `website/src/components/Hero.astro: the hero's card launches ${JOBS} jobs and the request it draws, ${JSON.stringify(PROMPT)}, does not name ${JSON.stringify(count)}: the card is a picture of the request above it, and a picture of a different number of jobs is the page contradicting itself (Global Constraint 6).`,
    )
  }
}

// The video slot's flag. Read from site.yaml rather than assumed, so the day the video
// exists this component changes in one place and the flag is what decides (D107).
const videoExists = facts.features.video

// The console's flag, read the same way and for the same reason (the owner's brief of
// 2026-10-19, item 6; W3.1).
const consoleExists = facts.features.consoleDownloads

// The latest release, for the one line this page adds about the site's changelog (the owner's
// request of 2026-10-22). **The tag is the changelog's own data, read at build time** — the
// release files for the tags, and the plugin's own version for which of them is published — so
// no version is typed into this component and the line follows the tree when the next release
// file lands. The two paths are passed rather than left to the generator's defaults for the
// reason `src/pages/changelog.astro` states: inside a build the module is bundled under
// `website/dist/.prerender/`, where its own walk up from itself finds `website/docs/releases/`,
// which does not exist.
const releases = buildChangelog({
  releasesDir: path.join(REPO_ROOT, 'docs', 'releases'),
  pluginFile: path.join(REPO_ROOT, 'plugin', '.claude-plugin', 'plugin.json'),
})

/**
 * The newest release that is published: a release file written ahead of the plugin's version
 * bump is on `main` without being a release, and this line says what a reader can install today.
 * A tree where none of the files is published has no latest release to name, and that stops the
 * build here rather than printing the tag of something that has not shipped.
 */
const latestRelease = releases.find((entry) => entry.released)
if (latestRelease === undefined) {
  throw new Error(
    `website/src/components/Hero.astro: none of the ${releases.length} release file(s) under docs/releases/ is at or below the version in plugin/.claude-plugin/plugin.json, and the homepage's latest-release line names the newest published one (the owner's request of 2026-10-22). Either the manifest carries the wrong version or every release file is ahead of it.`,
  )
}

/** The pull request the card's rows are drawn with: the same shape the slider's third step
 *  uses, inline and `currentColor`, so the card fetches nothing for its drawing. */
const PR_GLYPH =
  '<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M6 8.5v7"/><path d="M18 15.5V11a3 3 0 0 0-3-3h-4"/><path d="m13 6-2 2 2 2"/>'

const ROWS = Array.from({ length: JOBS }, (_, index) => index + 1)
---

<section class="hero" aria-labelledby="hero-tagline">
  {/* The board's background: two soft glows and a grid, behind everything on the first
      screen. It is decoration and says so (`aria-hidden`), and it paints no text — the
      pattern is `base.css`'s `.hero-glow`, written once for the site rather than here. */}
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-copy">
    {/* The latest release, above the pill: the one line this page adds about the changelog (the
        owner's request of 2026-10-22). It is a note about the project rather than a promise, so
        it is the quiet tone at the smallest step, and the tag and its link are the changelog's
        own data — the line is derived from the release files at build time and carries no
        `data-source`, because it quotes no document's sentence: the tag is the entry's own. Its
        home is `/changelog/`, where the entry is rendered (`website/test/home.mjs` holds every
        internal link of this page to a route the plan's tasks write, which is what keeps the
        link a page of this site rather than a fragment). */}
    <p class="hero-release">
      Latest release:{' '}
      <a href="/changelog/">{latestRelease.tag}</a>
    </p>

    {/* The board's status pill: the README's own words for what a run is and whose project it
        runs in. */}
    <p class="pill hero-pill" data-source="README.md">
      <span class="hero-pill-dot" aria-hidden="true"></span>
      {PILL}
    </p>

    <h1 class="hero-tagline display-xl" id="hero-tagline">
      {HEADLINE_HEAD}{' '}
      <span class="gradient-text">{HEADLINE_GRADIENT}</span>
    </h1>

    <p class="hero-lead" data-source="README.md">{LEAD}</p>

    {/* What a reader does next: install it, or read what a run is first. The primary one is
        filled with the accent, which is the one colour on the page that means "this is the
        action"; the others are quiet links, because two filled buttons are two primaries. */}
    <p class="hero-actions">
      <a class="hero-cta" href="/getting-started/">Get started</a>
      <a class="hero-cta-quiet" href="/how-it-works/">How it works</a>
      {
        // The console, while the repository says it has shipped (the owner's brief of
        // 2026-10-19, item 6). A quiet link like "How it works" and not a second filled
        // button, and its label is the name Getting Started's option carries.
        consoleExists && (
          <a class="hero-cta-quiet" href="/console/">
            Desktop console
          </a>
        )
      }
    </p>
  </div>

  {/* The board's illustration: the request as a terminal card, with the jobs it starts and
      the pull requests they end in. It is a `figure` because it is a picture with a caption
      — the caption is what says a reader is looking at a drawing rather than at a session —
      and it prints no `<pre>`, because a command block in the hero is the install block's
      (`website/test/home.mjs`). */}
  <figure class="hero-shot">
    <div class="hero-shot-frame">
      <div class="hero-shot-bar">
        <span class="hero-shot-dot" aria-hidden="true"></span>
        <span class="hero-shot-dot" aria-hidden="true"></span>
        <span class="hero-shot-dot" aria-hidden="true"></span>
        <span class="hero-shot-name">Your agent</span>
      </div>
      <div class="hero-shot-body">
        <p class="hero-prompt" data-source={REQUEST_SOURCE}>
          <span class="hero-prompt-mark" aria-hidden="true">&gt;</span>
          {PROMPT}
        </p>
        <p class="hero-shot-status">
          <span class="hero-shot-status-mark" aria-hidden="true"></span>
          Fugaro: launching {JOBS} jobs
        </p>
        <ol class="hero-shot-jobs">
          {
            ROWS.map((row) => (
              <li class="hero-shot-job">
                <svg
                  class="hero-shot-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <Fragment set:html={PR_GLYPH} />
                </svg>
                Pull request {row} of {JOBS}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
    <figcaption class="hero-shot-caption">
      An illustration, not a recording of a session.
    </figcaption>
  </figure>

  {
    videoExists && (
      <div class="hero-video" data-source="website/data/site.yaml">
        {/* W2.4 renders the explainer video here when site.yaml says it exists (D107). */}
      </div>
    )
  }
</section>

<style>
  /* Tokens only (W1.2): this component names the palette, the spacing scale, the type scale
     and the radii, and defines none of them. Every name below is declared in
     `src/styles/tokens.css`, and `website/test/home.mjs` holds the built pages to that.

     **The hero's own gutter and its room below are declared here**, like the page's other
     top-level blocks: `main:has(> .hero)` drops `main`'s padding on this page, so every block
     carries its own, and the gap between two blocks is the block above's own bottom padding
     (`website/test/base-styles.mjs`'s `homeRhythmFailures`). `position: relative` and
     `overflow: hidden` are what the glow layer needs (`base.css`, section 2c). */
  .hero {
    position: relative;
    overflow: hidden;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md) var(--space-2xl);
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  /* The copy and the card paint above the glow: a positioned box paints after a static one,
     and the glow is the hero's first child, so the two below it are positioned as well. */
  .hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    min-width: 0;
  }

  /* The latest release: one line of text, at the smallest step of the type scale and in the
     quiet tone, because it is a note about the project rather than the promise under it. The
     room around it is `.hero-copy`'s own gap — the flex column the hero draws its copy in — so
     the rule declares no margin of its own. **It sits above the `h1`**, which is what keeps it
     out of the page's lead: the lead is the text between the `h1` and the first `h2`, and
     `website/test/fold.mjs` holds that region to the promise, its prompt line and its call to
     action and to nothing else. */
  .hero-release {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .hero-pill {
    gap: var(--space-2xs);
    font-size: var(--font-size-sm);
  }

  /* The pill's dot: the success tone, which is the one colour on the site that means "this
     is running". A mark and not text, so it carries no pair of its own. */
  .hero-pill-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--ok);
  }

  /* The headline: `base.css`'s `.display-xl` — the display scale's largest step, written once
     for the site — with the two things that are this page's own. The split the board draws (the
     words before the gradient in the text tone, the last two in the accent's) is
     `.gradient-text`'s, and `max-width: 20ch` is what keeps the headline to the two or three
     lines the board sets it in rather than running the width of the page. */
  .hero-tagline {
    max-width: 20ch;
  }

  .hero-lead {
    margin: 0;
    max-width: 34rem;
    font-size: var(--font-size-xl);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  /* The action row: one filled link and the quiet ones, on one line while there is room and
     wrapping rather than shrinking when there is not. */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    margin: var(--space-2xs) 0 0;
  }

  /* The primary: the accent as a fill and the ground as its label, which is the pair
     `a11y.mjs` computes at 4.5:1 for a label a reader reads. The radius is the larger step
     the boards draw a control at, and `min-height: 44px` is the target size the owner's brief
     of 2026-10-19 measures every control against — `website/test/home.mjs` reads the rule and
     refuses a control under it. */
  .hero-cta {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 44px;
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-lg);
    background: var(--accent);
    color: var(--ground);
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-black);
    text-decoration: none;
  }

  /* The second action is a link, not a second button. It keeps the underline `base.css`
     gives every link in running text, so it reads as a link at a glance rather than as a
     disabled control beside the filled one — and it is a control all the same, so it carries
     the same 44 px minimum the filled one does. */
  .hero-cta-quiet {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 44px;
    font-size: var(--font-size-base);
    font-weight: var(--weight-semibold);
  }

  /* The illustration: the board's card, drawn as a panel one step above the ground with the
     hairline border and the radius every raised thing on this site has — there is no shadow
     anywhere, because a shadow is a colour function and a colour function outside a palette
     file is a contrast pair the a11y gate cannot compute. `position: relative` is the glow
     above. */
  .hero-shot {
    position: relative;
    margin: 0;
    min-width: 0;
  }

  .hero-shot-frame {
    overflow: hidden;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--panel);
  }

  /* The card's title bar: the surface, which is the step above the panel, and the three dots
     the board draws. The dots are the border tone — they are a drawing of a window and not
     three controls, so they are neither the accent nor anything a reader reads. */
  .hero-shot-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-sm);
    border-bottom: var(--border-width) solid var(--border);
    background: var(--surface);
  }

  .hero-shot-dot {
    flex: none;
    width: 11px;
    height: 11px;
    border-radius: var(--radius-pill);
    background: var(--border);
  }

  .hero-shot-name {
    margin-left: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--font-size-xs);
  }

  .hero-shot-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
  }

  /* The prompt line: the request, in the mono face and one step up the type scale, because
     the board makes it the loudest thing in the card. It is a `<p>` and not a `<pre>`: the
     card is a picture of a line a reader types, and the one command the page offers is the
     install block at its foot (`website/test/home.mjs` refuses a `<pre>` in the hero). */
  .hero-prompt {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: var(--text);
  }

  /* The prompt mark, and the only accent in the card's body: `--accent-on-dark` on `--panel`
     is a pair `a11y.mjs` computes at 4.5:1 — the accent where the work leaves the reader's
     hands, here where it starts. */
  .hero-prompt-mark {
    flex: none;
    color: var(--accent-on-dark);
  }

  /* The launching line: the warning tone, which is the one colour on the site that asks a
     reader to pay attention, and the card is where the run starts. */
  .hero-shot-status {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    color: var(--warn);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .hero-shot-status-mark {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-sm);
    background: var(--warn);
  }

  /* The three pull requests: a list, because three things that come back are three things,
     and each row the surface with the success tone's glyph — the colour that means "this
     finished". */
  .hero-shot-jobs {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-shot-job {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-2xs) var(--space-xs);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    font-size: var(--font-size-sm);
  }

  .hero-shot-icon {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--ok);
  }

  /* The caption, which is the one line of the card that is the site's own: it says what the
     picture is. It is the quieter tone at the smallest step, because it is a note about the
     drawing rather than part of it. */
  .hero-shot-caption {
    margin: var(--space-2xs) 0 0;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
  }

  /* The wide viewport: the copy and the card side by side, which is how the board draws the
     first screen — the promise on the left, the picture of a run on the right. */
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      gap: var(--space-2xl) var(--space-2xl);
      padding-top: var(--space-4xl);
      padding-bottom: var(--space-3xl);
    }
  }
</style>
