{
  "about": "The spoken-confirmation state machine's accept/refuse cases as data (mobile plan Task P6.2). Replayed by shared/confirm/index.test.js today, and by P6.7's Go parity test (TestConfirmParityWithShared) so the Go consumer and the app cannot disagree about what a confirmation authorises. Each case starts from initialState({now, timeoutMs, maxPending, maxLedger}) and feeds `events` in order; `expect[i]` is what step answers for events[i]. A refusal carries no state, so the next event is judged against the same machine. A confirmation's text is P6.1's `confirm` app command (\"Fugaro, confirm\"); a bare \"confirm\" is agent text and confirms nothing. Every `record` is P6.3's action record verbatim (shared/mailbox-schema validates it). Written by hand from the rules in docs/mobile/implementation-plan.md (D128 as amended 2026-10-17, D169, D162) -- not generated from the module.",
  "now": 1700000000000,
  "timeoutMs": 60000,
  "maxPending": 4,
  "maxLedger": 64,
  "runId": "run_9f3c",
  "repo": "dimipaun/fugaro",
  "pr": 568,
  "headSha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "cancelReadBack": "Cancel run run_9f3c. Say \"Fugaro, confirm\" to confirm.",
  "mergeReadBack": "Merge dimipaun/fugaro#568 at head aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa. Say \"Fugaro, confirm\" to confirm.",
  "confirmReadBack": "Confirm dimipaun/fugaro#568. Say \"Fugaro, confirm\" to confirm.",
  "confirmText": "Fugaro, confirm",
  "cases": [
    {
      "name": "a cancel is read back by the resolved run id, then confirmed by a separate utterance",
      "events": [
        { "type": "command", "now": 1700000001000, "utteranceId": "utt_1", "text": "cancel the docs refactor", "verb": "cancel", "target": { "kind": "run", "runId": "run_9f3c" }, "actionId": "act_1" },
        { "type": "confirm", "now": 1700000002000, "utteranceId": "utt_2", "text": "Fugaro, confirm", "actionId": "act_1", "confirmationId": "cnf_1", "target": { "kind": "run", "runId": "run_9f3c" } }
      ],
      "expect": [
        { "ok": true, "outcome": "read-back", "phase": "pending", "readBack": "Cancel run run_9f3c. Say \"Fugaro, confirm\" to confirm.", "actionId": "act_1" },
        { "ok": true, "outcome": "confirmed", "phase": "idle", "actionId": "act_1", "confirmationId": "cnf_1", "readBack": "Cancel run run_9f3c. Say \"Fugaro, confirm\" to confirm.", "record": { "id": "act_1", "verb": "cancel", "target": { "run": "run_9f3c" }, "confirmation": { "id": "cnf_1", "at": 1700000002000 } } }
      ]
    },
    {
      "name": "a misrecognised \"confirm\" does not confirm, and spends nothing",
      "events": [
        { "type": "command", "now": 1700000001000, "utteranceId": "utt_1", "text": "cancel the docs refactor", "verb": "cancel", "target": { "kind": "run", "runId": "run_9f3c" }, "actionId": "act_1" },
        { "type": "confirm", "now": 1700000002000, "utteranceId": "utt_2", "text": "yes", "actionId": "act_1", "confirmationId": "cnf_1", "target": { "kind": "run", "runId": "run_9f3c" } },
        { "type": "confirm", "now": 1700000003000, "utteranceId": "utt_2", "text": "Fugaro, confirm", "actionId": "act_1", "confirmationId": "cnf_1", "target": { "kind": "run", "runId": "run_9f3c" } }
      ],
      "expect": [
        { "ok": true, "outcome": "read-back", "phase": "pending" },
        { "ok": false, "code": "not-a-confirmation", "field": "text" },
        { "ok": true, "outcome": "confirmed", "phase": "idle" }
      ]
    },
    {
      "name": "\"conform\" is not the phrase either",
      "events": [
        { "type": "command", "now": 1700000001000, "utteranceId": "utt_1", "text": "cancel the docs refactor", "verb": "cancel", "target": { "kind": "run", "runId": "run_9f3c" }, "actionId": "act_1" },
        { "type": "confirm", "now": 1700000002000, "utteranceId": "utt_2", "text": "conform", "actionId": "act_1", "confirmationId": "cnf_1", "target": { "kind": "run", "runId": "run_9f3c" } },
        { "type": "confirm", "now": 1700000002000, "utteranceId": "utt_2", "text": "confirmed it", "actionId": "act_1", "confirmationId": "cnf_1", "target": { "kind": "run", "runId": "run_9f3c" } }
      ],
      "expect": [
        { "ok": true, "outcome": "read-back", "phase": "pending" },
        { "ok": false, "code": "not-a-confirmation", "field": "text" },
        { "ok": false, "code": "not-a-confirmation", "field": "text" }
      ]
    },
    {
